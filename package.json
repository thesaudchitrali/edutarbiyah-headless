{
  "name": "edutarbiyah",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "astro dev",
    "clean:cache": "node -e \"const fs=require('fs');fs.rmSync('.cache/api',{recursive:true,force:true});console.log('API cache purged.');\"",
    "build": "astro build",
    "build:fresh": "npm run clean:cache && astro build",
    "deploy": "npm run clean:cache && astro build && node scripts/deploy-ftp.js",
    "deploy:quick": "node scripts/deploy-ftp.js",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@lucide/astro": "^1.59.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.1",
    "basic-ftp": "^6.2.3",
    "dotenv": "^18.0.8",
    "lucide-astro": "^0.556.0",
    "tailwindcss": "^4.3.3"
  }
}
