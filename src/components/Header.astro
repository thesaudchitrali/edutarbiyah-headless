---
import { getPrimaryMenu, WHATSAPP_NUMBER } from '../lib/api';
import { BookOpen, Sparkles, MessageCircle, ChevronDown, Menu, X, ArrowUpRight } from 'lucide-astro';

const menuItems = await getPrimaryMenu();
---

<header class="sticky top-0 z-40 w-full bg-[#FFFDF9]/95 backdrop-blur-md border-b border-[#E5E7EB]/80 transition-all duration-200">
  <!-- Top Utility Bar -->
  <div class="bg-[#064E3B] text-[#F8FFFC] text-xs py-2 px-4 sm:px-6">
    <div class="max-w-7xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-2 text-center sm:text-left">
      <div class="flex items-center gap-2 font-medium">
        <span class="inline-block w-2 h-2 rounded-full bg-[#F59E0B] animate-pulse"></span>
        <span>Empowering parents with authentic moral education & holistic growth</span>
      </div>
      <div class="flex items-center gap-4 text-xs font-normal">
        <a
          href="/parents-whatsapp-community/"
          class="hover:text-[#F59E0B] transition-colors flex items-center gap-1"
        >
          <MessageCircle class="w-3.5 h-3.5" />
          <span>Parents Community</span>
        </a>
        <span class="text-white/30">•</span>
        <a
          href="https://blog.edutarbiyah.com"
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-[#F59E0B] transition-colors flex items-center gap-1 font-urdu"
        >
          <span>اردو بلاگ</span>
          <ArrowUpRight class="w-3 h-3" />
        </a>
      </div>
    </div>
  </div>

  <!-- Main Navigation Bar -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      
      <!-- Logo / Brand -->
      <a href="/" class="flex items-center gap-3 group shrink-0" aria-label="EduTarbiyah Institute Home">
        <img
          src="/images/logo.webp"
          alt="EduTarbiyah Institute - ایجو تربیت انسٹیٹیوٹ"
          class="h-12 w-auto object-contain group-hover:scale-105 transition-transform duration-200"
          width="130"
          height="48"
        />
      </a>

      <!-- Desktop Navigation Menu -->
      <nav class="hidden lg:flex items-center gap-1 xl:gap-2">
        {menuItems.map((item) => (
          <div class="relative group">
            {item.children && item.children.length > 0 ? (
              <div>
                <button
                  type="button"
                  class="flex items-center gap-1.5 px-3.5 py-2 text-sm font-semibold text-[#374151] hover:text-[#0F766E] rounded-lg hover:bg-[#F4F8F6] transition-colors focus:outline-none"
                  aria-expanded="false"
                >
                  <span>{item.title}</span>
                  <ChevronDown class="w-4 h-4 text-[#9CA3AF] group-hover:text-[#0F766E] group-hover:rotate-180 transition-transform duration-200" />
                </button>
                <div class="absolute left-0 top-full pt-2 w-64 opacity-0 pointer-events-none group-hover:opacity-100 group-hover:pointer-events-auto transition-all duration-200 z-50">
                  <div class="bg-white rounded-xl shadow-xl border border-gray-100 p-2.5 space-y-1">
                    {item.children.map((sub) => (
                      <a
                        href={sub.url}
                        target={sub.target || '_self'}
                        class="block px-3 py-2 text-sm rounded-lg text-[#374151] hover:text-[#0F766E] hover:bg-[#F4F8F6] transition-colors font-medium"
                      >
                        {sub.title}
                      </a>
                    ))}
                  </div>
                </div>
              </div>
            ) : (
              <a
                href={item.url}
                target={item.target || '_self'}
                class="px-3.5 py-2 text-sm font-semibold text-[#374151] hover:text-[#0F766E] rounded-lg hover:bg-[#F4F8F6] transition-colors"
              >
                {item.title}
              </a>
            )}
          </div>
        ))}
      </nav>

      <!-- CTA Action Button & Mobile Menu Toggle -->
      <div class="flex items-center gap-3">
        <a
          href="/audit-your-parenting/"
          class="hidden sm:inline-flex items-center gap-2 px-4 py-2.5 text-sm font-semibold text-white bg-[#0F766E] hover:bg-[#064E3B] rounded-xl shadow-sm hover:shadow-md transition-all duration-200"
        >
          <Sparkles class="w-4 h-4 text-[#F59E0B]" />
          <span>Parenting Audit</span>
        </a>

        <!-- Mobile Menu Toggle Button -->
        <button
          id="mobile-menu-toggle"
          type="button"
          class="lg:hidden p-2.5 rounded-xl text-gray-700 hover:text-[#0F766E] hover:bg-gray-100 focus:outline-none"
          aria-label="Toggle navigation menu"
        >
          <Menu class="w-6 h-6 block" id="menu-icon-open" />
          <X class="w-6 h-6 hidden" id="menu-icon-close" />
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Drawer Menu -->
  <div
    id="mobile-menu-drawer"
    class="hidden lg:hidden border-t border-gray-100 bg-[#FFFDF9] max-h-[80vh] overflow-y-auto px-4 py-4 space-y-2 shadow-2xl"
  >
    {menuItems.map((item) => (
      <div class="py-1">
        {item.children && item.children.length > 0 ? (
          <div>
            <div class="px-3 py-2 text-sm font-bold text-[#064E3B] uppercase tracking-wider">
              {item.title}
            </div>
            <div class="pl-4 space-y-1 border-l-2 border-[#0F766E]/20 ml-3">
              {item.children.map((sub) => (
                <a
                  href={sub.url}
                  target={sub.target || '_self'}
                  class="block px-3 py-1.5 text-sm font-medium text-gray-700 hover:text-[#0F766E] rounded-md hover:bg-[#F4F8F6]"
                >
                  {sub.title}
                </a>
              ))}
            </div>
          </div>
        ) : (
          <a
            href={item.url}
            target={item.target || '_self'}
            class="block px-3 py-2 text-base font-semibold text-gray-800 hover:text-[#0F766E] rounded-lg hover:bg-[#F4F8F6]"
          >
            {item.title}
          </a>
        )}
      </div>
    ))}

    <div class="pt-4 border-t border-gray-100 flex flex-col gap-2">
      <a
        href="/audit-your-parenting/"
        class="w-full text-center py-3 text-sm font-semibold text-white bg-[#0F766E] hover:bg-[#064E3B] rounded-xl shadow"
      >
        Free Parenting Audit
      </a>
      <a
        href="/parents-whatsapp-community/"
        class="w-full text-center py-2.5 text-sm font-medium text-[#064E3B] bg-[#F4F8F6] hover:bg-gray-100 rounded-xl"
      >
        Join WhatsApp Community
      </a>
    </div>
  </div>
</header>

<script>
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const drawer = document.getElementById('mobile-menu-drawer');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');

  if (toggleBtn && drawer && iconOpen && iconClose) {
    toggleBtn.addEventListener('click', () => {
      const isHidden = drawer.classList.contains('hidden');
      if (isHidden) {
        drawer.classList.remove('hidden');
        iconOpen.classList.add('hidden');
        iconClose.classList.remove('hidden');
      } else {
        drawer.classList.add('hidden');
        iconOpen.classList.remove('hidden');
        iconClose.classList.add('hidden');
      }
    });
  }
</script>
