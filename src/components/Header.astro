---
import { getPrimaryMenu, WHATSAPP_NUMBER } from '../lib/api';
import { 
  BookOpen, 
  Sparkles, 
  MessageCircle, 
  ChevronDown, 
  Menu, 
  X, 
  ArrowUpRight,
  GraduationCap,
  Heart,
  Compass,
  Brain,
  Clock,
  ShieldCheck,
  Award,
  CheckCircle2
} from 'lucide-astro';

const menuItems = await getPrimaryMenu();
const currentPath = Astro.url.pathname;

function isItemActive(url: string, children?: any[]): boolean {
  if (url === '/' && currentPath === '/') return true;
  if (url !== '/' && currentPath.startsWith(url)) return true;
  if (children && children.some(c => c.url !== '/' && currentPath.startsWith(c.url))) return true;
  return false;
}

// Icon mapper for dropdown items
function getItemBadge(title: string): string | null {
  if (title.includes('Parenting Style Audit') || title.includes('Parenting Audit')) return 'FREE';
  if (title.includes('Routine Maker')) return 'POPULAR';
  if (title.includes('TPPC')) return 'CERTIFIED';
  if (title.includes('Marriage')) return 'COUPLES';
  return null;
}
---

<header class="sticky top-0 z-40 w-full bg-[#FFFDF9]/95 backdrop-blur-md border-b border-[#E5E7EB] transition-all duration-200">
  
  <!-- Top Announcement Bar -->
  <aside class="bg-[#064E3B] text-[#F8FFFC] text-xs py-2 px-4 sm:px-6">
    <div class="max-w-7xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-2 text-center sm:text-left">
      <div class="flex items-center gap-2 font-medium">
        <span class="inline-block w-2 h-2 rounded-full bg-[#F59E0B] animate-pulse"></span>
        <span>Empowering 5,000+ parents with authentic Tarbiyah & moral clarity</span>
      </div>
      <div class="flex items-center gap-4 text-xs font-normal">
        <a
          href="/parents-whatsapp-community/"
          class="hover:text-[#F59E0B] transition-colors flex items-center gap-1.5"
        >
          <MessageCircle class="w-3.5 h-3.5 text-[#25D366] fill-[#25D366]" />
          <span>Parents WhatsApp Community</span>
        </a>
        <span class="text-white/30">•</span>
        <a
          href="https://blog.edutarbiyah.com"
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-[#F59E0B] transition-colors flex items-center gap-1 font-urdu"
        >
          <span>اردو بلاگ اور مقالات</span>
          <ArrowUpRight class="w-3 h-3 text-[#F59E0B]" />
        </a>
      </div>
    </div>
  </aside>

  <!-- Main Navigation Bar -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20 gap-4">
      
      <!-- Brand Logo (Left) -->
      <a href="/" class="flex items-center gap-3 group shrink-0" aria-label="EduTarbiyah Home">
        <div class="w-11 h-11 rounded-xl bg-gradient-to-br from-[#0F766E] to-[#064E3B] flex items-center justify-center text-white shadow-md shadow-[#0F766E]/20 group-hover:scale-105 transition-transform duration-200">
          <BookOpen class="w-6 h-6 text-[#F59E0B]" />
        </div>
        <div class="flex flex-col">
          <span class="text-2xl font-serif font-bold tracking-tight text-[#064E3B] group-hover:text-[#0F766E] transition-colors leading-none">
            EduTarbiyah
          </span>
          <span class="text-[10px] font-semibold tracking-wider uppercase text-[#6B7280] mt-1">
            Islamic Parenting & Education
          </span>
        </div>
      </a>

      <!-- Desktop Navigation Links (Center) -->
      <nav class="hidden lg:flex items-center gap-1 xl:gap-2">
        {menuItems.map((item) => {
          const active = isItemActive(item.url, item.children);
          const hasChildren = item.children && item.children.length > 0;

          return (
            <div class="relative group">
              {hasChildren ? (
                <div>
                  <button
                    type="button"
                    class={`flex items-center gap-1 px-3.5 py-2 text-sm font-semibold rounded-xl transition-all focus:outline-none cursor-pointer ${
                      active
                        ? 'text-[#064E3B] bg-[#0F766E]/10 font-bold'
                        : 'text-[#374151] hover:text-[#0F766E] hover:bg-[#F4F8F6]'
                    }`}
                    aria-expanded="false"
                  >
                    <span>{item.title}</span>
                    <ChevronDown class="w-3.5 h-3.5 text-[#9CA3AF] group-hover:text-[#0F766E] group-hover:rotate-180 transition-transform duration-200" />
                  </button>

                  <!-- Hover Cushion & Dropdown Flyout -->
                  <div class="absolute left-1/2 -translate-x-1/2 top-full pt-2 opacity-0 pointer-events-none group-hover:opacity-100 group-hover:pointer-events-auto transition-all duration-200 z-50">
                    <div class="bg-white rounded-2xl shadow-2xl border border-gray-100 p-3 min-w-[280px] space-y-1">
                      
                      <div class="px-3 py-1.5 text-[10px] font-bold text-gray-400 uppercase tracking-wider border-b border-gray-100 mb-1">
                        {item.title}
                      </div>

                      {item.children?.map((sub) => {
                        const isSubActive = currentPath === sub.url || (sub.url !== '/' && currentPath.startsWith(sub.url));
                        const badge = getItemBadge(sub.title);

                        return (
                          <a
                            href={sub.url}
                            target={sub.target || '_self'}
                            class={`flex items-center justify-between px-3 py-2.5 text-xs rounded-xl transition-all font-medium ${
                              isSubActive
                                ? 'bg-[#0F766E]/10 text-[#064E3B] font-bold'
                                : 'text-gray-700 hover:text-[#0F766E] hover:bg-[#F4F8F6]'
                            }`}
                          >
                            <span class="truncate pr-2">{sub.title}</span>
                            {badge && (
                              <span class="text-[9px] font-black uppercase px-2 py-0.5 rounded-full bg-[#F59E0B]/20 text-[#B45309] shrink-0">
                                {badge}
                              </span>
                            )}
                          </a>
                        );
                      })}
                    </div>
                  </div>
                </div>
              ) : (
                <a
                  href={item.url}
                  target={item.target || '_self'}
                  class={`px-3.5 py-2 text-sm font-semibold rounded-xl transition-all ${
                    active
                      ? 'text-[#064E3B] bg-[#0F766E]/10 font-bold'
                      : 'text-[#374151] hover:text-[#0F766E] hover:bg-[#F4F8F6]'
                  }`}
                >
                  {item.title}
                </a>
              )}
            </div>
          );
        })}
      </nav>

      <!-- Right Action CTA & Mobile Toggle (Right) -->
      <div class="flex items-center gap-3 shrink-0">
        <!-- Free Parenting Audit CTA Button -->
        <a
          href="/audit-your-parenting/"
          class="hidden sm:inline-flex items-center gap-2 px-4 py-2.5 text-xs font-bold text-white bg-[#0F766E] hover:bg-[#064E3B] rounded-xl shadow-sm hover:shadow-md hover:-translate-y-0.5 transition-all duration-200"
        >
          <Sparkles class="w-3.5 h-3.5 text-[#F59E0B]" />
          <span>Parenting Audit</span>
        </a>

        <!-- Mobile Drawer Toggle Button -->
        <button
          id="mobile-menu-toggle"
          type="button"
          class="lg:hidden p-2.5 rounded-xl text-gray-700 hover:text-[#0F766E] hover:bg-gray-100 focus:outline-none cursor-pointer"
          aria-label="Toggle navigation menu"
        >
          <Menu class="w-6 h-6 block" id="menu-icon-open" />
          <X class="w-6 h-6 hidden" id="menu-icon-close" />
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Drawer Menu Overlay -->
  <div
    id="mobile-menu-drawer"
    class="hidden lg:hidden border-t border-gray-100 bg-[#FFFDF9] max-h-[85vh] overflow-y-auto px-5 py-6 space-y-4 shadow-2xl animate-fadeIn"
  >
    {menuItems.map((item) => (
      <div class="border-b border-gray-100 pb-3">
        {item.children && item.children.length > 0 ? (
          <div>
            <div class="text-xs font-bold text-[#064E3B] uppercase tracking-wider mb-2">
              {item.title}
            </div>
            <div class="pl-3 space-y-1.5 border-l-2 border-[#0F766E]/20">
              {item.children.map((sub) => {
                const badge = getItemBadge(sub.title);
                return (
                  <a
                    href={sub.url}
                    target={sub.target || '_self'}
                    class="flex items-center justify-between py-1.5 px-2 text-sm font-medium text-gray-700 hover:text-[#0F766E] hover:bg-[#F4F8F6] rounded-lg"
                  >
                    <span>{sub.title}</span>
                    {badge && (
                      <span class="text-[9px] font-black uppercase px-2 py-0.5 rounded-full bg-[#F59E0B]/20 text-[#B45309]">
                        {badge}
                      </span>
                    )}
                  </a>
                );
              })}
            </div>
          </div>
        ) : (
          <a
            href={item.url}
            target={item.target || '_self'}
            class="block py-2 text-base font-bold text-gray-800 hover:text-[#0F766E]"
          >
            {item.title}
          </a>
        )}
      </div>
    ))}

    <!-- Mobile CTAs -->
    <div class="pt-2 flex flex-col gap-2.5">
      <a
        href="/audit-your-parenting/"
        class="w-full text-center py-3.5 text-sm font-bold text-white bg-[#0F766E] hover:bg-[#064E3B] rounded-2xl shadow-md flex items-center justify-center gap-2"
      >
        <Sparkles class="w-4 h-4 text-[#F59E0B]" />
        <span>Take Free Parenting Audit</span>
      </a>

      <a
        href="/parents-whatsapp-community/"
        class="w-full text-center py-3 text-sm font-semibold text-[#064E3B] bg-emerald-50 hover:bg-emerald-100 border border-emerald-200 rounded-2xl flex items-center justify-center gap-2"
      >
        <MessageCircle class="w-4 h-4 text-[#25D366] fill-[#25D366]" />
        <span>Join WhatsApp Community</span>
      </a>

      <a
        href="https://blog.edutarbiyah.com"
        target="_blank"
        rel="noopener noreferrer"
        class="w-full text-center py-2.5 text-sm font-medium text-gray-600 hover:text-gray-900 font-urdu"
      >
        <span>وزٹ اردو بلاگ (blog.edutarbiyah.com)</span>
      </a>
    </div>
  </div>

</header>

<script>
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const drawer = document.getElementById('mobile-menu-drawer');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');

  if (toggleBtn && drawer && iconOpen && iconClose) {
    toggleBtn.addEventListener('click', () => {
      const isHidden = drawer.classList.contains('hidden');
      if (isHidden) {
        drawer.classList.remove('hidden');
        iconOpen.classList.add('hidden');
        iconClose.classList.remove('hidden');
      } else {
        drawer.classList.add('hidden');
        iconOpen.classList.remove('hidden');
        iconClose.classList.add('hidden');
      }
    });
  }
</script>
