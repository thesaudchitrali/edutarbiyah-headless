---
import type { Product } from '../lib/api';
import { formatPrice, buildWhatsAppOrderLink, buildWooCommerceCartLink, WHATSAPP_NUMBER, WP_BASE_URL } from '../lib/api';
import { ShoppingCart, MessageCircle, CheckCircle2, AlertCircle, RefreshCw, Sparkles } from 'lucide-astro';

interface Props {
  product: Product;
}

const { product } = Astro.props;

const initialPrice = formatPrice(product.prices);
const regularPrice = product.prices?.regular_price ? `${product.prices.currency_prefix || '₨ '}${product.prices.regular_price}` : '';
const isOnSale = product.on_sale && product.prices?.sale_price && product.prices.sale_price !== product.prices.regular_price;

const initialCartLink = buildWooCommerceCartLink(product.id);
const initialWaLink = buildWhatsAppOrderLink(
  product.name,
  initialPrice,
  `https://edutarbiyah.com/product/${product.slug}/`
);

const isVariable = product.type === 'variable' && product.attributes && product.attributes.length > 0;
---

<div id="product-freshness-island" class="space-y-6" data-product-id={product.id} data-wp-base={WP_BASE_URL} data-wa-phone={WHATSAPP_NUMBER} data-product-slug={product.slug} data-product-name={product.name}>
  
  <!-- Price Display -->
  <div class="flex items-baseline gap-3">
    <span id="live-product-price" class="text-3xl sm:text-4xl font-serif font-extrabold text-[#064E3B]">
      {initialPrice}
    </span>
    {isOnSale && (
      <span id="live-regular-price" class="text-lg text-gray-400 line-through">
        {regularPrice}
      </span>
    )}
    <span id="freshness-badge" class="hidden items-center gap-1 text-[11px] font-medium text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded-full border border-emerald-200">
      <RefreshCw class="w-3 h-3 animate-spin text-emerald-600" />
      <span>Checking latest price...</span>
    </span>
  </div>

  <!-- Stock Status -->
  <div id="live-stock-container" class="flex items-center gap-2 text-sm font-semibold text-emerald-800">
    <CheckCircle2 class="w-4 h-4 text-emerald-600" id="stock-icon" />
    <span id="live-stock-label">{product.is_in_stock ? 'In Stock — Dispatched within 24–48 hours' : 'Backorder Available'}</span>
  </div>

  <!-- Attribute Selectors (For Variable Products) -->
  {isVariable && (
    <div id="variation-selector" class="pt-4 border-t border-gray-100 space-y-4">
      <div class="text-sm font-bold text-[#064E3B] uppercase tracking-wider">
        Select Options:
      </div>
      {product.attributes.map((attr) => (
        <div class="space-y-1.5" data-attr-name={attr.name}>
          <label class="text-xs font-semibold text-gray-700">{attr.name}:</label>
          <div class="flex flex-wrap gap-2 attribute-options" data-attribute={attr.name}>
            {attr.terms.map((term, idx) => (
              <button
                type="button"
                data-term-slug={term.slug}
                data-term-name={term.name}
                class={`attr-btn px-4 py-2 text-xs font-semibold rounded-xl border transition-all ${
                  idx === 0
                    ? 'border-[#0F766E] bg-[#0F766E]/10 text-[#0F766E] shadow-sm'
                    : 'border-gray-200 bg-white text-gray-700 hover:border-gray-400'
                }`}
              >
                {term.name}
              </button>
            ))}
          </div>
        </div>
      ))}
    </div>
  )}

  <!-- Primary Cart & WhatsApp Action Handoffs -->
  <div class="pt-4 space-y-3">
    <!-- Native Direct Checkout Button -->
    <a
      id="btn-add-to-cart"
      href={initialCartLink}
      class="w-full flex items-center justify-center gap-2.5 py-4 px-6 rounded-2xl bg-[#0F766E] hover:bg-[#064E3B] text-white font-bold text-base shadow-lg shadow-[#0F766E]/20 hover:shadow-xl hover:shadow-[#0F766E]/30 transition-all duration-200"
    >
      <ShoppingCart class="w-5 h-5 text-[#F59E0B]" />
      <span>Buy Now</span>
    </a>

    <!-- 1-Click WhatsApp Instant Ordering -->
    <a
      id="btn-whatsapp-order"
      href={initialWaLink}
      target="_blank"
      rel="noopener noreferrer"
      class="w-full flex items-center justify-center gap-2.5 py-3.5 px-6 rounded-2xl bg-[#25D366] hover:bg-[#20bd5a] text-white font-bold text-base shadow-md hover:shadow-lg transition-all duration-200"
    >
      <MessageCircle class="w-5 h-5 fill-current" />
      <span>1-Click Order on WhatsApp</span>
    </a>
  </div>

  <!-- Trust Badges -->
  <div class="pt-6 border-t border-gray-100 grid grid-cols-2 gap-3 text-xs text-gray-600">
    <div class="flex items-center gap-2">
      <span class="w-1.5 h-1.5 rounded-full bg-[#0F766E]"></span>
      <span>Cash on Delivery across Pakistan</span>
    </div>
    <div class="flex items-center gap-2">
      <span class="w-1.5 h-1.5 rounded-full bg-[#0F766E]"></span>
      <span>Bank Transfer / EasyPaisa / JazzCash</span>
    </div>
    <div class="flex items-center gap-2">
      <span class="w-1.5 h-1.5 rounded-full bg-[#0F766E]"></span>
      <span>Original Authentic Content</span>
    </div>
    <div class="flex items-center gap-2">
      <span class="w-1.5 h-1.5 rounded-full bg-[#0F766E]"></span>
      <span>Dedicated WhatsApp Support</span>
    </div>
  </div>

</div>

<!-- Client script for live freshness checking & variation resolution -->
<script define:vars={{ productJson: JSON.stringify(product) }}>
  const product = JSON.parse(productJson);
  const island = document.getElementById('product-freshness-island');
  const priceEl = document.getElementById('live-product-price');
  const regPriceEl = document.getElementById('live-regular-price');
  const stockLabelEl = document.getElementById('live-stock-label');
  const cartBtn = document.getElementById('btn-add-to-cart');
  const waBtn = document.getElementById('btn-whatsapp-order');
  const freshnessBadge = document.getElementById('freshness-badge');

  const selectedAttributes = {};

  // Initialize selected attributes with first options
  if (product.attributes && product.attributes.length > 0) {
    product.attributes.forEach((attr) => {
      if (attr.terms && attr.terms.length > 0) {
        selectedAttributes[attr.name] = attr.terms[0].slug;
      }
    });

    // Setup attribute button click listeners
    const attrButtons = island?.querySelectorAll('.attr-btn');
    attrButtons?.forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const target = e.currentTarget;
        const parent = target.closest('.attribute-options');
        const attrName = parent?.getAttribute('data-attribute');
        const termSlug = target.getAttribute('data-term-slug');

        if (attrName && termSlug) {
          selectedAttributes[attrName] = termSlug;

          // Update active state in UI
          parent.querySelectorAll('.attr-btn').forEach((b) => {
            b.classList.remove('border-[#0F766E]', 'bg-[#0F766E]/10', 'text-[#0F766E]', 'shadow-sm');
            b.classList.add('border-gray-200', 'bg-white', 'text-gray-700');
          });
          target.classList.remove('border-gray-200', 'bg-white', 'text-gray-700');
          target.classList.add('border-[#0F766E]', 'bg-[#0F766E]/10', 'text-[#0F766E]', 'shadow-sm');

          resolveVariation();
        }
      });
    });
  }

  function resolveVariation() {
    if (!product.variations || product.variations.length === 0) return;

    // Match variation where all attributes match
    const matched = product.variations.find((v) => {
      return v.attributes.every((attr) => {
        return !selectedAttributes[attr.name] || selectedAttributes[attr.name] === attr.value;
      });
    });

    if (matched) {
      if (matched.prices && priceEl) {
        const prefix = matched.prices.currency_prefix || '₨ ';
        priceEl.textContent = `${prefix}${matched.prices.price}`;
      }

      // Update add to cart link with variation ID and attributes
      const wpBase = island?.getAttribute('data-wp-base') || 'https://edutarbiyah.com';
      const params = new URLSearchParams();
      params.set('add-to-cart', product.id.toString());
      params.set('variation_id', matched.id.toString());
      for (const [k, v] of Object.entries(selectedAttributes)) {
        params.set(`attribute_${k}`, v);
      }
      if (cartBtn) {
        cartBtn.setAttribute('href', `${wpBase}/cart/?${params.toString()}`);
      }

      // Update WhatsApp link
      const waPhone = island?.getAttribute('data-wa-phone') || '923122370720';
      const slug = island?.getAttribute('data-product-slug') || '';
      const summary = Object.entries(selectedAttributes).map(([k, v]) => `${k}: ${v}`).join(', ');
      const curPrice = priceEl?.textContent || '';
      const message = `السلام علیکم EduTarbiyah!\n\nI would like to order:\nBook: *${product.name}*\nPrice: ${curPrice}\nSelected: ${summary}\nLink: https://edutarbiyah.com/product/${slug}/\n\nPlease let me know available payment and delivery details. JazakAllah Khair!`;
      if (waBtn) {
        waBtn.setAttribute('href', `https://wa.me/${waPhone}?text=${encodeURIComponent(message)}`);
      }
    }
  }

  // Client-side Freshness Check with 3-second timeout
  async function checkLiveFreshness() {
    if (!freshnessBadge) return;
    try {
      freshnessBadge.classList.remove('hidden');
      freshnessBadge.classList.add('inline-flex');

      const controller = new AbortController();
      const timeoutId = setTimeout(() => controller.abort(), 3000);

      const res = await fetch(`https://edutarbiyah.com/wp-json/wc/store/v1/products/${product.id}`, {
        signal: controller.signal,
        headers: { 'Accept': 'application/json' },
      });
      clearTimeout(timeoutId);

      if (res.ok) {
        const liveData = await res.json();
        if (liveData.prices && priceEl) {
          const prefix = liveData.prices.currency_prefix || '₨ ';
          priceEl.textContent = `${prefix}${liveData.prices.price}`;
          if (regPriceEl && liveData.prices.regular_price) {
            regPriceEl.textContent = `${prefix}${liveData.prices.regular_price}`;
          }
        }
        if (stockLabelEl) {
          stockLabelEl.textContent = liveData.is_in_stock
            ? 'In Stock — Dispatched within 24–48 hours'
            : 'Out of Stock / Backorder Only';
        }

        freshnessBadge.innerHTML = '<span>Live Verified</span>';
        setTimeout(() => {
          freshnessBadge.classList.add('hidden');
        }, 2500);
      } else {
        // Fallback quietly
        freshnessBadge.classList.add('hidden');
      }
    } catch {
      // CORS or network timeout: gracefully hide badge and retain build-time data
      if (freshnessBadge) freshnessBadge.classList.add('hidden');
    }
  }

  // Run freshness verification
  checkLiveFreshness();
</script>
