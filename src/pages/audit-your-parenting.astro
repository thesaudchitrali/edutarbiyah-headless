---
import Layout from '../layouts/Layout.astro';
import { WHATSAPP_NUMBER } from '../lib/api';
import { 
  Sparkles, 
  ChevronRight, 
  Home, 
  CheckCircle2, 
  Heart, 
  ShieldCheck, 
  Smartphone, 
  Brain, 
  MessageCircle, 
  Printer, 
  RotateCcw,
  ArrowRight
} from 'lucide-astro';

const categories = [
  {
    title: 'Islamic Tarbiyah & Environment',
    icon: 'mosque',
    questions: [
      { id: 0, text: 'Do you encourage your children to pray Salah regularly with love and consistency?' },
      { id: 1, text: 'Do you consciously cultivate a peaceful Islamic environment at home (Dua, Quran, gratitude)?' },
      { id: 2, text: 'Do you actively teach everyday Islamic manners (Akhlaq, honesty, greeting)?' },
      { id: 3, text: 'Do you actively strive to be a calm, ethical role model for your children?' },
    ],
  },
  {
    title: 'Emotional Connection & Bonding',
    icon: 'heart',
    questions: [
      { id: 4, text: 'Do you spend dedicated, distraction-free meaningful time with your children daily?' },
      { id: 5, text: 'Does your child feel safe sharing their feelings, fears, or mistakes openly with you?' },
      { id: 6, text: 'Do you listen patiently to your child’s perspective without immediately interrupting or lecturing?' },
      { id: 7, text: 'Do you regularly appreciate their positive efforts and character traits?' },
    ],
  },
  {
    title: 'Discipline, Anger & Boundaries',
    icon: 'shield',
    questions: [
      { id: 8, text: 'Do you successfully avoid yelling, name-calling, or harsh physical reactions during anger?' },
      { id: 9, text: 'Are household boundaries and behavioral consequences clear, predictable, and fair?' },
      { id: 10, text: 'Do you focus on restorative coaching and guidance rather than punitive punishment?' },
      { id: 11, text: 'Do you and your spouse maintain unified, consistent discipline together?' },
    ],
  },
  {
    title: 'Digital Age & Screen Habits',
    icon: 'screen',
    questions: [
      { id: 12, text: 'Do you enforce healthy, agreed-upon limits on your child’s daily screen time?' },
      { id: 13, text: 'Do you actively monitor and protect children from unwholesome digital media?' },
      { id: 14, text: 'Does your family observe screen-free family meal times and bedtime routines?' },
      { id: 15, text: 'Do you personally model healthy digital habits and phone discipline around your children?' },
    ],
  },
  {
    title: 'Self-Reflection & Parental Growth',
    icon: 'brain',
    questions: [
      { id: 16, text: 'Do you regularly read books, attend webinars, or seek knowledge to improve your parenting?' },
      { id: 17, text: 'When you lose your temper or make a mistake, do you apologize and repair the relationship?' },
      { id: 18, text: 'Do you regularly discuss your children’s emotional progress and needs with your spouse?' },
      { id: 19, text: 'Do you make sincere, consistent Duas for your children’s righteousness and guidance?' },
    ],
  },
];
---

<Layout
  title="Audit Your Parenting | Free Diagnostic Assessment | EduTarbiyah"
  description="Discover your parenting style, strengths, and communication gaps with our 20-question diagnostic audit. Instant scores, breakdown, and personalized roadmap."
>
  <!-- Hero Section -->
  <section class="bg-gradient-to-b from-[#F4F8F6] via-[#FFFDF9] to-[#FFFDF9] py-12 lg:py-16 border-b border-gray-100">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center space-y-4">
      
      <!-- Breadcrumb -->
      <nav class="flex items-center justify-center gap-2 text-xs text-gray-500 font-medium mb-2" aria-label="Breadcrumb">
        <a href="/" class="hover:text-[#0F766E] transition-colors flex items-center gap-1">
          <Home class="w-3.5 h-3.5" />
          <span>Home</span>
        </a>
        <ChevronRight class="w-3.5 h-3.5 text-gray-400" />
        <span class="text-[#064E3B] font-semibold">Audit Your Parenting</span>
      </nav>

      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#0F766E]/10 border border-[#0F766E]/20 text-[#0F766E] text-xs font-semibold">
        <Sparkles class="w-3.5 h-3.5 text-[#F59E0B]" />
        <span>Diagnostic Tarbiyah Audit • 3–5 Minutes</span>
      </div>

      <h1 class="text-3xl sm:text-5xl font-serif font-extrabold text-[#064E3B] tracking-tight">
        Audit Your Parenting Style
      </h1>

      <p class="text-base sm:text-lg text-gray-600 max-w-2xl mx-auto leading-relaxed">
        Answer honestly across 5 key dimensions of family life. Receive an instant calibrated score, category breakdown, and personalized guidance for your home.
      </p>

    </div>
  </section>

  <!-- Interactive Quiz Container -->
  <section class="py-12 lg:py-16 bg-[#FFFDF9]">
    <div class="max-w-3xl mx-auto px-4 sm:px-6">
      
      <!-- Progress Bar -->
      <div class="sticky top-20 z-30 bg-[#FFFDF9]/95 backdrop-blur-md py-3 mb-8 border-b border-gray-100">
        <div class="flex items-center justify-between text-xs font-semibold text-gray-700 mb-1.5">
          <span>Assessment Progress</span>
          <span id="progress-text" class="text-[#0F766E]">0 / 20 Answered</span>
        </div>
        <div class="w-full h-2.5 bg-gray-200 rounded-full overflow-hidden">
          <div id="progress-bar-fill" class="h-full bg-[#0F766E] rounded-full transition-all duration-300 w-0"></div>
        </div>
      </div>

      <!-- Quiz Form -->
      <form id="parenting-audit-form" class="space-y-12">
        {categories.map((cat, catIdx) => (
          <div class="bg-white rounded-3xl p-6 sm:p-8 border border-gray-100 shadow-sm space-y-6">
            
            <!-- Category Header -->
            <div class="flex items-center gap-3 pb-4 border-b border-gray-100">
              <span class="w-8 h-8 rounded-xl bg-[#0F766E]/10 text-[#0F766E] font-bold text-sm flex items-center justify-center">
                {catIdx + 1}
              </span>
              <h2 class="text-lg font-serif font-bold text-[#064E3B]">
                {cat.title}
              </h2>
            </div>

            <!-- Questions -->
            <div class="space-y-6">
              {cat.questions.map((q) => (
                <div class="space-y-3 pt-2 question-block" data-qid={q.id}>
                  <p class="text-sm font-semibold text-gray-900 leading-snug">
                    <span class="text-[#0F766E] mr-1">Q{q.id + 1}.</span> {q.text}
                  </p>
                  
                  <!-- Option Buttons -->
                  <div class="grid grid-cols-3 gap-2.5 sm:gap-3" data-name={`q${q.id}`}>
                    <label class="option-label cursor-pointer flex flex-col sm:flex-row items-center justify-center gap-1.5 py-3 px-2 rounded-2xl border border-gray-200 hover:border-[#0F766E] text-xs font-semibold text-gray-700 transition-all text-center">
                      <input type="radio" name={`q${q.id}`} value="5" class="sr-only" required />
                      <span class="w-3.5 h-3.5 rounded-full border border-gray-300 flex items-center justify-center shrink-0 dot-indicator"></span>
                      <span>Always (5)</span>
                    </label>

                    <label class="option-label cursor-pointer flex flex-col sm:flex-row items-center justify-center gap-1.5 py-3 px-2 rounded-2xl border border-gray-200 hover:border-[#0F766E] text-xs font-semibold text-gray-700 transition-all text-center">
                      <input type="radio" name={`q${q.id}`} value="3" class="sr-only" />
                      <span class="w-3.5 h-3.5 rounded-full border border-gray-300 flex items-center justify-center shrink-0 dot-indicator"></span>
                      <span>Sometimes (3)</span>
                    </label>

                    <label class="option-label cursor-pointer flex flex-col sm:flex-row items-center justify-center gap-1.5 py-3 px-2 rounded-2xl border border-gray-200 hover:border-[#0F766E] text-xs font-semibold text-gray-700 transition-all text-center">
                      <input type="radio" name={`q${q.id}`} value="1" class="sr-only" />
                      <span class="w-3.5 h-3.5 rounded-full border border-gray-300 flex items-center justify-center shrink-0 dot-indicator"></span>
                      <span>Rarely (1)</span>
                    </label>
                  </div>
                </div>
              ))}
            </div>

          </div>
        ))}

        <!-- Parent Details & Submit -->
        <div class="bg-white rounded-3xl p-6 sm:p-8 border border-gray-100 shadow-sm space-y-4">
          <h3 class="font-serif font-bold text-lg text-[#064E3B]">
            Your Details (Optional — For Personalized Insights)
          </h3>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-semibold text-gray-700 mb-1">Your Name</label>
              <input
                type="text"
                id="parent-name"
                placeholder="e.g. Fatima or Ahmad"
                class="w-full px-4 py-2.5 text-sm rounded-xl border border-gray-200 focus:outline-none focus:border-[#0F766E]"
              />
            </div>
            <div>
              <label class="block text-xs font-semibold text-gray-700 mb-1">WhatsApp Number</label>
              <input
                type="tel"
                id="parent-whatsapp"
                placeholder="0300-1234567"
                class="w-full px-4 py-2.5 text-sm rounded-xl border border-gray-200 focus:outline-none focus:border-[#0F766E]"
              />
            </div>
          </div>

          <div class="pt-4">
            <button
              type="submit"
              id="btn-calculate"
              class="w-full py-4 px-8 rounded-2xl bg-[#0F766E] hover:bg-[#064E3B] text-white font-bold text-base shadow-lg shadow-[#0F766E]/20 hover:shadow-xl transition-all duration-200 flex items-center justify-center gap-2 cursor-pointer"
            >
              <Sparkles class="w-5 h-5 text-[#F59E0B]" />
              <span>Calculate My Parenting Result</span>
            </button>
          </div>
        </div>

      </form>

      <!-- Results Card (Hidden until submitted) -->
      <div id="results-card" class="hidden mt-12 bg-white rounded-3xl p-8 sm:p-12 border border-[#0F766E]/30 shadow-2xl space-y-8 animate-fadeIn">
        
        <!-- Header badge & title -->
        <div class="text-center space-y-3 pb-6 border-b border-gray-100">
          <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full text-xs font-bold uppercase tracking-wider" id="result-badge">
            Diagnostic Outcome
          </div>
          <h2 class="text-3xl sm:text-4xl font-serif font-extrabold text-[#064E3B]" id="result-title">
            Parenting Result
          </h2>
          <div class="flex items-center justify-center gap-2">
            <span class="text-5xl font-serif font-black text-[#0F766E]" id="result-score">0</span>
            <span class="text-xl font-bold text-gray-400">/ 100</span>
          </div>
          <p class="text-sm text-gray-600 max-w-lg mx-auto" id="result-description">
            Your evaluation is complete.
          </p>
        </div>

        <!-- Pillar Breakdown -->
        <div class="space-y-4">
          <h3 class="text-sm font-bold uppercase tracking-wider text-gray-700">
            Dimension Breakdown:
          </h3>
          <div class="space-y-3" id="dimensions-container">
            <!-- Populated via JS -->
          </div>
        </div>

        <!-- Recommended Course Box -->
        <div class="bg-[#F4F8F6] rounded-2xl p-6 border border-[#0F766E]/20 space-y-3">
          <div class="text-xs font-bold text-[#0F766E] uppercase tracking-wider">
            Recommended Transformation Program
          </div>
          <h4 class="text-xl font-serif font-bold text-[#064E3B]" id="result-course-title">
            Tarbiyah Parenting Practitioner Course (TPPC)
          </h4>
          <p class="text-xs text-gray-600 leading-relaxed" id="result-course-desc">
            Equip yourself with practical, step-by-step methodologies to resolve daily defiance, build emotional safety, and instill enduring Islamic values.
          </p>
          <div class="pt-2 flex flex-col sm:flex-row items-center gap-3">
            <a
              id="result-course-link"
              href="/tppc-self-paced-recorded-course/"
              class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3 rounded-xl bg-[#0F766E] hover:bg-[#064E3B] text-white text-xs font-bold shadow transition-all"
            >
              <span>Explore Course Syllabus</span>
              <ArrowRight class="w-4 h-4" />
            </a>
            <a
              id="result-whatsapp-share"
              href="#"
              target="_blank"
              rel="noopener noreferrer"
              class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3 rounded-xl bg-[#25D366] hover:bg-[#20bd5a] text-white text-xs font-bold shadow transition-all"
            >
              <MessageCircle class="w-4 h-4 fill-current" />
              <span>Discuss Results with Counselor</span>
            </a>
          </div>
        </div>

        <!-- Actions -->
        <div class="pt-4 flex items-center justify-between border-t border-gray-100 text-xs">
          <button
            type="button"
            id="btn-retake"
            class="text-gray-500 hover:text-[#0F766E] font-semibold flex items-center gap-1.5 transition-colors cursor-pointer"
          >
            <RotateCcw class="w-3.5 h-3.5" />
            <span>Retake Assessment</span>
          </button>
          <button
            type="button"
            id="btn-print"
            class="text-[#0F766E] hover:underline font-semibold flex items-center gap-1.5 transition-colors cursor-pointer"
          >
            <Printer class="w-3.5 h-3.5" />
            <span>Print or Save Report</span>
          </button>
        </div>

      </div>

    </div>
  </section>

</Layout>

<script define:vars={{ categoriesJson: JSON.stringify(categories), waNumber: WHATSAPP_NUMBER }}>
  const categories = JSON.parse(categoriesJson);
  const form = document.getElementById('parenting-audit-form');
  const resultsCard = document.getElementById('results-card');
  const progressBarFill = document.getElementById('progress-bar-fill');
  const progressText = document.getElementById('progress-text');

  // Track answer clicks and highlight pills
  const allRadioInputs = form?.querySelectorAll('input[type="radio"]');
  allRadioInputs?.forEach((radio) => {
    radio.addEventListener('change', (e) => {
      const target = e.target;
      const groupName = target.name;
      const groupLabels = form.querySelectorAll(`input[name="${groupName}"]`);
      
      groupLabels.forEach((r) => {
        const label = r.closest('.option-label');
        const dot = label?.querySelector('.dot-indicator');
        label?.classList.remove('border-[#0F766E]', 'bg-[#0F766E]/10', 'text-[#0F766E]', 'shadow-sm');
        label?.classList.add('border-gray-200', 'text-gray-700');
        if (dot) {
          dot.classList.remove('bg-[#0F766E]', 'border-[#0F766E]');
          dot.classList.add('border-gray-300');
        }
      });

      const checkedLabel = target.closest('.option-label');
      const checkedDot = checkedLabel?.querySelector('.dot-indicator');
      checkedLabel?.classList.remove('border-gray-200', 'text-gray-700');
      checkedLabel?.classList.add('border-[#0F766E]', 'bg-[#0F766E]/10', 'text-[#0F766E]', 'shadow-sm');
      if (checkedDot) {
        checkedDot.classList.remove('border-gray-300');
        checkedDot.classList.add('bg-[#0F766E]', 'border-[#0F766E]');
      }

      updateProgress();
    });
  });

  function updateProgress() {
    let answeredCount = 0;
    for (let i = 0; i < 20; i++) {
      if (form?.querySelector(`input[name="q${i}"]:checked`)) {
        answeredCount++;
      }
    }
    const pct = Math.round((answeredCount / 20) * 100);
    if (progressBarFill) progressBarFill.style.width = `${pct}%`;
    if (progressText) progressText.textContent = `${answeredCount} / 20 Answered`;
  }

  // Handle Form Submission
  form?.addEventListener('submit', (e) => {
    e.preventDefault();

    let totalScore = 0;
    const categoryScores = [0, 0, 0, 0, 0];

    for (let i = 0; i < 20; i++) {
      const checked = form.querySelector(`input[name="q${i}"]:checked`);
      const val = checked ? parseInt(checked.value, 10) : 1;
      totalScore += val;

      const catIdx = Math.floor(i / 4);
      categoryScores[catIdx] += val;
    }

    const parentName = document.getElementById('parent-name')?.value || 'Parent';

    let resultTitle = '';
    let resultDesc = '';
    let badgeClass = '';
    let courseTitle = '';
    let courseDesc = '';
    let courseUrl = '/tppc-self-paced-recorded-course/';

    if (totalScore >= 85) {
      resultTitle = 'Excellent Conscious Parent';
      resultDesc = 'MashaAllah! You demonstrate a highly attuned, warm, and consistent Tarbiyah framework with strong spiritual grounding and healthy emotional communication.';
      badgeClass = 'bg-emerald-100 text-emerald-800';
      courseTitle = 'Advanced Tarbiyah Parenting Mastery';
      courseDesc = 'Deepen your mastery into adolescent transition guidance and community parenting leadership.';
      courseUrl = '/tarbiyah-parenting-mastery-program/';
    } else if (totalScore >= 70) {
      resultTitle = 'Balanced Developing Parent';
      resultDesc = 'Alhamdulillah, you have established strong parenting fundamentals! Implementing structured home routines and emotional de-escalation will elevate your family dynamics.';
      badgeClass = 'bg-teal-100 text-teal-800';
      courseTitle = 'Tarbiyah Parenting Practitioner Course (TPPC)';
      courseDesc = 'Our flagship training to transform inconsistent routines into joyful, calm parental authority.';
      courseUrl = '/tppc-self-paced-recorded-course/';
    } else if (totalScore >= 50) {
      resultTitle = 'Moderate Friction / Inconsistent Discipline';
      resultDesc = 'You are experiencing everyday parenting exhaustion, power struggles, or reactive discipline. With clear frameworks, this tension can be resolved quickly.';
      badgeClass = 'bg-amber-100 text-amber-800';
      courseTitle = '1-on-1 Parent Mentorship Coaching';
      courseDesc = 'Direct personal guidance to resolve behavioral bottlenecks, screen time struggles, and temper flare-ups.';
      courseUrl = '/edutarbiyah-parent-coaching-program/';
    } else {
      resultTitle = 'Parenting Needs Immediate Support';
      resultDesc = 'You are facing significant parenting stress and emotional exhaustion. Remember that Allah swt provides ease with effort. Our counseling team is here to support you step-by-step.';
      badgeClass = 'bg-rose-100 text-rose-800';
      courseTitle = 'Parent Mentorship Intake Assessment';
      courseDesc = 'Schedule a personal consultation to build an immediate de-escalation plan for your household.';
      courseUrl = '/parent-coaching-readiness-form/';
    }

    // Update DOM
    const badgeEl = document.getElementById('result-badge');
    if (badgeEl) {
      badgeEl.className = `inline-flex items-center gap-2 px-3.5 py-1 rounded-full text-xs font-bold uppercase tracking-wider ${badgeClass}`;
      badgeEl.textContent = resultTitle;
    }

    const titleEl = document.getElementById('result-title');
    if (titleEl) titleEl.textContent = `${parentName}’s Parenting Audit`;

    const scoreEl = document.getElementById('result-score');
    if (scoreEl) scoreEl.textContent = totalScore.toString();

    const descEl = document.getElementById('result-description');
    if (descEl) descEl.textContent = resultDesc;

    const courseTitleEl = document.getElementById('result-course-title');
    if (courseTitleEl) courseTitleEl.textContent = courseTitle;

    const courseDescEl = document.getElementById('result-course-desc');
    if (courseDescEl) courseDescEl.textContent = courseDesc;

    const courseLinkEl = document.getElementById('result-course-link');
    if (courseLinkEl) courseLinkEl.setAttribute('href', courseUrl);

    // Dimension Breakdown
    const dimContainer = document.getElementById('dimensions-container');
    if (dimContainer) {
      dimContainer.innerHTML = '';
      categories.forEach((cat, idx) => {
        const catScore = categoryScores[idx]; // max 20
        const pct = Math.round((catScore / 20) * 100);
        dimContainer.innerHTML += `
          <div class="space-y-1">
            <div class="flex items-center justify-between text-xs font-medium text-gray-700">
              <span>${cat.title}</span>
              <span class="font-bold text-[#064E3B]">${catScore} / 20 (${pct}%)</span>
            </div>
            <div class="w-full h-2 bg-gray-100 rounded-full overflow-hidden">
              <div class="h-full bg-[#0F766E] rounded-full" style="width: ${pct}%"></div>
            </div>
          </div>
        `;
      });
    }

    // WhatsApp counseling button
    const waShareBtn = document.getElementById('result-whatsapp-share');
    if (waShareBtn) {
      const waMsg = `السلام علیکم EduTarbiyah!\n\nI just completed the Parenting Audit on your website.\nName: ${parentName}\nTotal Score: ${totalScore}/100 (${resultTitle})\n\nI would like more guidance on your recommended program: *${courseTitle}*.`;
      waShareBtn.setAttribute('href', `https://wa.me/${waNumber}?text=${encodeURIComponent(waMsg)}`);
    }

    // Reveal and scroll
    if (resultsCard) {
      resultsCard.classList.remove('hidden');
      resultsCard.scrollIntoView({ behavior: 'smooth' });
    }
  });

  // Retake button
  document.getElementById('btn-retake')?.addEventListener('click', () => {
    form?.reset();
    form?.querySelectorAll('.option-label').forEach((label) => {
      label.classList.remove('border-[#0F766E]', 'bg-[#0F766E]/10', 'text-[#0F766E]', 'shadow-sm');
      label.classList.add('border-gray-200', 'text-gray-700');
    });
    form?.querySelectorAll('.dot-indicator').forEach((dot) => {
      dot.classList.remove('bg-[#0F766E]', 'border-[#0F766E]');
      dot.classList.add('border-gray-300');
    });
    updateProgress();
    resultsCard?.classList.add('hidden');
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });

  // Print button
  document.getElementById('btn-print')?.addEventListener('click', () => {
    window.print();
  });
</script>
