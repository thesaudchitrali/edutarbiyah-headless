---
import Layout from '../layouts/Layout.astro';
import { WHATSAPP_NUMBER } from '../lib/api';
import { 
  MessageCircle, 
  Users, 
  ShieldCheck, 
  Sparkles, 
  CheckCircle2, 
  Heart, 
  Clock, 
  HelpCircle,
  ArrowRight,
  BookOpen
} from 'lucide-astro';

const defaultCommunityMessage = encodeURIComponent(
  "السلام علیکم EduTarbiyah! I would like to join the EduTarbiyah Parents WhatsApp Community. Please share the group link and details."
);
const whatsappJoinUrl = `https://wa.me/${WHATSAPP_NUMBER}?text=${defaultCommunityMessage}`;
---

<Layout
  title="Parents WhatsApp Community | EduTarbiyah"
  description="Join 5,000+ Muslim parents in the official EduTarbiyah WhatsApp community. Daily practical parenting reminders, habit trackers, and moral education guidance."
>
  <!-- Hero Section -->
  <section class="relative bg-gradient-to-b from-[#064E3B] via-[#0F766E] to-[#064E3B] text-white py-16 lg:py-24 overflow-hidden">
    <div class="absolute inset-0 opacity-10 bg-[radial-gradient(#F59E0B_1px,transparent_1px)] [background-size:24px_24px] pointer-events-none"></div>

    <div class="relative max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-6">
      
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white/10 text-[#F59E0B] text-xs font-semibold backdrop-blur-md border border-white/10">
        <Users class="w-4 h-4" />
        <span>Over 5,000+ Active Parents Across the Globe</span>
      </div>

      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-serif font-extrabold text-white tracking-tight leading-tight">
        EduTarbiyah Parents <br class="hidden sm:inline" />
        <span class="text-[#F59E0B] italic font-normal">WhatsApp Community</span>
      </h1>

      <p class="text-base sm:text-xl text-[#D1FAE5] max-w-2xl mx-auto leading-relaxed font-normal">
        A peaceful, spam-free sanctuary for parents who want daily, bite-sized Islamic Tarbiyah frameworks, habit reminders, and parenting clarity without social media noise.
      </p>

      <div class="pt-4 flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href={whatsappJoinUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-3 px-8 py-4 rounded-2xl bg-[#25D366] hover:bg-[#20bd5a] text-white text-base font-bold shadow-2xl hover:scale-105 active:scale-95 transition-all duration-200"
        >
          <MessageCircle class="w-6 h-6 fill-current" />
          <span>Join Free WhatsApp Community</span>
        </a>

        <a
          href="/audit-your-parenting/"
          class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-4 rounded-2xl bg-white/10 hover:bg-white/20 text-white text-base font-bold border border-white/20 backdrop-blur-sm transition-all"
        >
          <Sparkles class="w-5 h-5 text-[#F59E0B]" />
          <span>Take Parenting Audit</span>
        </a>
      </div>

      <!-- Trust Badges -->
      <div class="pt-8 flex flex-wrap items-center justify-center gap-6 text-xs text-[#D1FAE5]/80">
        <span class="flex items-center gap-1.5">
          <ShieldCheck class="w-4 h-4 text-[#F59E0B]" />
          <span>Strict Admin-Only Posting (Zero Spam)</span>
        </span>
        <span class="flex items-center gap-1.5">
          <CheckCircle2 class="w-4 h-4 text-[#F59E0B]" />
          <span>100% Free Forever</span>
        </span>
        <span class="flex items-center gap-1.5">
          <Users class="w-4 h-4 text-[#F59E0B]" />
          <span>Privacy Respected</span>
        </span>
      </div>

    </div>
  </section>

  <!-- What You Receive Inside Section -->
  <section class="py-20 bg-[#FFFDF9]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-3xl mx-auto space-y-3 mb-16">
        <span class="text-xs font-bold uppercase tracking-widest text-[#0F766E]">
          Community Benefits
        </span>
        <h2 class="text-3xl sm:text-4xl font-serif font-bold text-[#064E3B]">
          What You Receive as a Member
        </h2>
        <p class="text-gray-600 text-base">
          Carefully timed, high-value guidance delivered directly to your phone.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        
        <div class="bg-white rounded-3xl p-8 border border-gray-100 shadow-sm hover:shadow-lg transition-all space-y-4">
          <div class="w-12 h-12 rounded-2xl bg-[#0F766E]/10 text-[#0F766E] flex items-center justify-center">
            <Heart class="w-6 h-6" />
          </div>
          <h3 class="text-xl font-serif font-bold text-[#064E3B]">
            Daily Tarbiyah Insights
          </h3>
          <p class="text-sm text-gray-600 leading-relaxed">
            Short, actionable insights addressing real home situations: anger management, de-escalating tantrums, encouraging Salah, and bedtime bonding rituals.
          </p>
        </div>

        <div class="bg-white rounded-3xl p-8 border border-gray-100 shadow-sm hover:shadow-lg transition-all space-y-4">
          <div class="w-12 h-12 rounded-2xl bg-[#F59E0B]/10 text-[#F59E0B] flex items-center justify-center">
            <BookOpen class="w-6 h-6" />
          </div>
          <h3 class="text-xl font-serif font-bold text-[#064E3B]">
            Printable Toolkits & Charts
          </h3>
          <p class="text-sm text-gray-600 leading-relaxed">
            Exclusive access to downloadable routine makers, Screen Time agreements, Salah trackers, and moral habit charts designed for home printing.
          </p>
        </div>

        <div class="bg-white rounded-3xl p-8 border border-gray-100 shadow-sm hover:shadow-lg transition-all space-y-4">
          <div class="w-12 h-12 rounded-2xl bg-emerald-100 text-emerald-700 flex items-center justify-center">
            <Clock class="w-6 h-6" />
          </div>
          <h3 class="text-xl font-serif font-bold text-[#064E3B]">
            Live Q&A Sessions
          </h3>
          <p class="text-sm text-gray-600 leading-relaxed">
            Invitations to periodic private live audio discussions and Q&A webinars with EduTarbiyah counselors and guest educational experts.
          </p>
        </div>

      </div>

    </div>
  </section>

  <!-- Community Rules & Privacy -->
  <section class="py-16 bg-[#F4F8F6] border-y border-gray-100">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <div class="bg-white rounded-3xl p-8 sm:p-12 border border-gray-200/80 shadow-md space-y-8">
        
        <div class="text-center space-y-2">
          <span class="text-xs font-bold uppercase tracking-wider text-[#0F766E]">Community Covenant</span>
          <h2 class="text-2xl sm:text-3xl font-serif font-bold text-[#064E3B]">
            Our Zero-Spam, High-Dignity Promise
          </h2>
          <p class="text-xs sm:text-sm text-gray-600 max-w-lg mx-auto">
            We value your peace of mind and family time. Our WhatsApp community is structured around respect.
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-sm text-gray-700">
          <div class="flex items-start gap-3 p-3.5 rounded-xl bg-gray-50">
            <CheckCircle2 class="w-5 h-5 text-[#0F766E] shrink-0 mt-0.5" />
            <span><strong>Admin-Only Announcements:</strong> No endless chatter, forwarded memes, or political debates.</span>
          </div>

          <div class="flex items-start gap-3 p-3.5 rounded-xl bg-gray-50">
            <CheckCircle2 class="w-5 h-5 text-[#0F766E] shrink-0 mt-0.5" />
            <span><strong>Privacy Protected:</strong> Member contact details are hidden within the WhatsApp Community structure.</span>
          </div>

          <div class="flex items-start gap-3 p-3.5 rounded-xl bg-gray-50">
            <CheckCircle2 class="w-5 h-5 text-[#0F766E] shrink-0 mt-0.5" />
            <span><strong>Quality Over Quantity:</strong> Maximum 1–2 thoughtful, curated updates per day.</span>
          </div>

          <div class="flex items-start gap-3 p-3.5 rounded-xl bg-gray-50">
            <CheckCircle2 class="w-5 h-5 text-[#0F766E] shrink-0 mt-0.5" />
            <span><strong>Dedicated Support Line:</strong> Direct 1-on-1 private messaging with admins for personal questions.</span>
          </div>
        </div>

        <div class="text-center pt-4">
          <a
            href={whatsappJoinUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2.5 px-8 py-4 rounded-2xl bg-[#25D366] hover:bg-[#20bd5a] text-white font-bold text-base shadow-xl hover:scale-105 active:scale-95 transition-all"
          >
            <MessageCircle class="w-5 h-5 fill-current" />
            <span>Send WhatsApp Message to Join</span>
          </a>
        </div>

      </div>
    </div>
  </section>

  <!-- Community FAQs -->
  <section class="py-20 bg-[#FFFDF9]">
    <div class="max-w-3xl mx-auto px-4 sm:px-6">
      
      <div class="text-center space-y-2 mb-12">
        <h2 class="text-2xl sm:text-3xl font-serif font-bold text-[#064E3B]">
          Frequently Asked Questions
        </h2>
        <p class="text-xs sm:text-sm text-gray-600">
          Everything you need to know about joining EduTarbiyah on WhatsApp.
        </p>
      </div>

      <div class="space-y-4">
        <details class="group bg-white rounded-2xl p-6 border border-gray-100 shadow-sm [&_summary::-webkit-details-marker]:hidden">
          <summary class="flex items-center justify-between cursor-pointer font-bold text-gray-900 text-sm">
            <span>Is there any membership fee to join?</span>
            <span class="text-[#0F766E] group-open:rotate-180 transition-transform">▾</span>
          </summary>
          <p class="mt-3 text-xs sm:text-sm text-gray-600 leading-relaxed">
            No, the EduTarbiyah WhatsApp community is 100% free. We consider this a community service (Sadaqah Jariyah) to assist modern families in parenting.
          </p>
        </details>

        <details class="group bg-white rounded-2xl p-6 border border-gray-100 shadow-sm [&_summary::-webkit-details-marker]:hidden">
          <summary class="flex items-center justify-between cursor-pointer font-bold text-gray-900 text-sm">
            <span>Can I ask private parenting questions?</span>
            <span class="text-[#0F766E] group-open:rotate-180 transition-transform">▾</span>
          </summary>
          <p class="mt-3 text-xs sm:text-sm text-gray-600 leading-relaxed">
            Yes! While the main group is announcement-only to protect your attention, you can always reply to any announcement to message the counseling team privately.
          </p>
        </details>

        <details class="group bg-white rounded-2xl p-6 border border-gray-100 shadow-sm [&_summary::-webkit-details-marker]:hidden">
          <summary class="flex items-center justify-between cursor-pointer font-bold text-gray-900 text-sm">
            <span>How do I order books or courses from the community?</span>
            <span class="text-[#0F766E] group-open:rotate-180 transition-transform">▾</span>
          </summary>
          <p class="mt-3 text-xs sm:text-sm text-gray-600 leading-relaxed">
            Simply send a message with the title of the book or program you are interested in. Our team will assist with Cash on Delivery or digital course access immediately.
          </p>
        </details>
      </div>

    </div>
  </section>

</Layout>
