---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import { getAllProducts, getEnglishPosts, WHATSAPP_NUMBER } from '../lib/api';
import { 
  Sparkles, 
  BookOpen, 
  Heart, 
  Compass, 
  Users, 
  ArrowRight, 
  CheckCircle, 
  ShieldCheck, 
  MessageCircle, 
  Clock, 
  GraduationCap, 
  Award,
  ArrowUpRight 
} from 'lucide-astro';

const allProducts = await getAllProducts();
const featuredProducts = allProducts.slice(0, 4);

const englishPosts = await getEnglishPosts(3);
---

<Layout
  title="EduTarbiyah | Authentic Parenting & Moral Education for Modern Families"
  description="Empowering mature parents and educators with authentic Islamic parenting frameworks, diagnostic self-audits, and practical habit toolkits."
>
  <!-- Hero Section -->
  <section class="relative overflow-hidden bg-gradient-to-b from-[#F4F8F6] via-[#FFFDF9] to-[#FFFDF9] pt-12 pb-20 lg:pt-20 lg:pb-28">
    <div class="absolute inset-0 opacity-30 bg-[radial-gradient(#0F766E_1px,transparent_1px)] [background-size:24px_24px] pointer-events-none"></div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
        
        <!-- Left Hero Copy -->
        <div class="lg:col-span-7 space-y-8 text-center lg:text-left">
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#0F766E]/10 border border-[#0F766E]/20 text-[#0F766E] text-xs font-semibold tracking-wide">
            <Sparkles class="w-3.5 h-3.5 text-[#F59E0B]" />
            <span>Islamic Parenting for the Modern Era</span>
          </div>

          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-serif font-extrabold text-[#064E3B] tracking-tight leading-[1.15]">
            Nurture Hearts. <br />
            <span class="text-[#0F766E] italic font-normal">Shape Characters.</span> <br />
            Build Lasting Legacy.
          </h1>

          <p class="text-lg sm:text-xl text-[#4B5563] leading-relaxed max-w-2xl mx-auto lg:mx-0 font-normal">
            A serene, evidence-based platform for mature parents and educators. We bridge authentic prophetic Tarbiyah with modern developmental insights to help your children thrive emotionally, intellectually, and spiritually.
          </p>

          <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4 pt-2">
            <a
              href="/audit-your-parenting/"
              class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 px-8 py-4 rounded-2xl bg-[#0F766E] hover:bg-[#064E3B] text-white text-base font-bold shadow-lg shadow-[#0F766E]/25 hover:shadow-xl hover:shadow-[#0F766E]/35 hover:-translate-y-0.5 transition-all duration-200"
            >
              <Sparkles class="w-5 h-5 text-[#F59E0B]" />
              <span>Take Free Parenting Audit</span>
            </a>

            <a
              href="/shop/"
              class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-4 rounded-2xl bg-white hover:bg-gray-50 text-[#1F2937] text-base font-bold border border-gray-200 shadow-sm hover:shadow transition-all duration-200"
            >
              <BookOpen class="w-5 h-5 text-[#0F766E]" />
              <span>Explore Bookstore</span>
            </a>
          </div>

          <!-- Trust Badges -->
          <div class="pt-6 border-t border-gray-200/60 grid grid-cols-3 gap-4 text-center lg:text-left">
            <div>
              <div class="text-2xl font-serif font-bold text-[#064E3B]">5,000+</div>
              <div class="text-xs text-gray-500 font-medium">Families Guided</div>
            </div>
            <div>
              <div class="text-2xl font-serif font-bold text-[#064E3B]">100%</div>
              <div class="text-xs text-gray-500 font-medium">Authentic Tarbiyah</div>
            </div>
            <div>
              <div class="text-2xl font-serif font-bold text-[#064E3B]">12+</div>
              <div class="text-xs text-gray-500 font-medium">Published Works</div>
            </div>
          </div>
        </div>

        <!-- Right Hero Visual Card -->
        <div class="lg:col-span-5 relative">
          <div class="relative mx-auto max-w-md lg:max-w-none">
            <!-- Background Decorative Glow -->
            <div class="absolute -inset-2 bg-gradient-to-r from-[#0F766E] to-[#F59E0B] rounded-3xl blur-xl opacity-20 transform -rotate-1"></div>

            <div class="relative bg-white rounded-3xl p-6 sm:p-8 shadow-2xl border border-gray-100 space-y-6">
              <div class="flex items-center justify-between border-b border-gray-100 pb-4">
                <div class="flex items-center gap-3">
                  <div class="w-10 h-10 rounded-xl bg-[#0F766E]/10 flex items-center justify-center text-[#0F766E]">
                    <Compass class="w-5 h-5" />
                  </div>
                  <div>
                    <h3 class="font-bold text-gray-900 text-sm">Tarbiyah Diagnostic Suite</h3>
                    <p class="text-xs text-gray-500">Interactive Self-Assessments</p>
                  </div>
                </div>
                <span class="text-xs font-bold text-[#0F766E] bg-[#0F766E]/10 px-2.5 py-1 rounded-full">
                  Instant Results
                </span>
              </div>

              <!-- Diagnostic Item list -->
              <div class="space-y-3">
                <a
                  href="/audit-your-parenting/"
                  class="flex items-center justify-between p-3.5 rounded-xl bg-[#F8FFFC] border border-[#0F766E]/20 hover:border-[#0F766E] transition-all group"
                >
                  <div class="flex items-center gap-3">
                    <span class="w-2 h-2 rounded-full bg-[#0F766E]"></span>
                    <div>
                      <div class="text-sm font-bold text-gray-900 group-hover:text-[#0F766E] transition-colors">
                        Parenting Style Audit
                      </div>
                      <div class="text-xs text-gray-500">Identify strengths & emotional connection gaps</div>
                    </div>
                  </div>
                  <ArrowRight class="w-4 h-4 text-gray-400 group-hover:text-[#0F766E] group-hover:translate-x-1 transition-all" />
                </a>

                <a
                  href="/family-vision-maker/"
                  class="flex items-center justify-between p-3.5 rounded-xl bg-gray-50 border border-gray-200 hover:border-[#0F766E] transition-all group"
                >
                  <div class="flex items-center gap-3">
                    <span class="w-2 h-2 rounded-full bg-[#F59E0B]"></span>
                    <div>
                      <div class="text-sm font-bold text-gray-900 group-hover:text-[#0F766E] transition-colors">
                        Family Vision Maker
                      </div>
                      <div class="text-xs text-gray-500">Create a unified home mission & core values</div>
                    </div>
                  </div>
                  <ArrowRight class="w-4 h-4 text-gray-400 group-hover:text-[#0F766E] group-hover:translate-x-1 transition-all" />
                </a>

                <a
                  href="/childs-behavior-improvement-tracker/"
                  class="flex items-center justify-between p-3.5 rounded-xl bg-gray-50 border border-gray-200 hover:border-[#0F766E] transition-all group"
                >
                  <div class="flex items-center gap-3">
                    <span class="w-2 h-2 rounded-full bg-emerald-600"></span>
                    <div>
                      <div class="text-sm font-bold text-gray-900 group-hover:text-[#0F766E] transition-colors">
                        Child Behavior Tracker
                      </div>
                      <div class="text-xs text-gray-500">Structured habit tracking & positive reinforcement</div>
                    </div>
                  </div>
                  <ArrowRight class="w-4 h-4 text-gray-400 group-hover:text-[#0F766E] group-hover:translate-x-1 transition-all" />
                </a>
              </div>

              <!-- Highlight note -->
              <div class="bg-[#FFF8EC] rounded-xl p-4 border border-[#F59E0B]/30 flex items-start gap-3">
                <Sparkles class="w-5 h-5 text-[#F59E0B] shrink-0 mt-0.5" />
                <p class="text-xs text-[#92400E] leading-relaxed">
                  <strong>Did you know?</strong> 82% of parenting friction stems from inconsistent routines rather than defiance. Our diagnostics help pinpoint the exact root cause.
                </p>
              </div>

            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Core Pillars of EduTarbiyah -->
  <section class="py-16 bg-white border-y border-gray-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto space-y-3 mb-12">
        <h2 class="text-xs font-bold uppercase tracking-widest text-[#0F766E]">
          The EduTarbiyah Methodology
        </h2>
        <h3 class="text-3xl sm:text-4xl font-serif font-bold text-[#064E3B]">
          Three Pillars of Holistic Tarbiyah
        </h3>
        <p class="text-gray-600 text-base">
          Rooted in classical wisdom and designed for modern household challenges.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <!-- Pillar 1 -->
        <div class="bg-[#FFFDF9] rounded-2xl p-8 border border-gray-100 shadow-sm hover:shadow-md transition-shadow space-y-4">
          <div class="w-12 h-12 rounded-xl bg-[#0F766E]/10 flex items-center justify-center text-[#0F766E]">
            <Heart class="w-6 h-6 text-[#0F766E]" />
          </div>
          <h4 class="text-xl font-serif font-bold text-[#064E3B]">
            1. Emotional Attachment & Connection
          </h4>
          <p class="text-sm text-gray-600 leading-relaxed">
            Tarbiyah precedes instruction. We guide parents to cultivate profound emotional safety, trust, and unconditional validation so children naturally absorb values.
          </p>
        </div>

        <!-- Pillar 2 -->
        <div class="bg-[#FFFDF9] rounded-2xl p-8 border border-gray-100 shadow-sm hover:shadow-md transition-shadow space-y-4">
          <div class="w-12 h-12 rounded-xl bg-[#F59E0B]/10 flex items-center justify-center text-[#F59E0B]">
            <GraduationCap class="w-6 h-6 text-[#F59E0B]" />
          </div>
          <h4 class="text-xl font-serif font-bold text-[#064E3B]">
            2. Moral & Spiritual Formation
          </h4>
          <p class="text-sm text-gray-600 leading-relaxed">
            Developing internal conscience (Taqwa) rather than mere compliance. Practical toolkits for Salah consistency, Quranic connection, and noble Akhlaq.
          </p>
        </div>

        <!-- Pillar 3 -->
        <div class="bg-[#FFFDF9] rounded-2xl p-8 border border-gray-100 shadow-sm hover:shadow-md transition-shadow space-y-4">
          <div class="w-12 h-12 rounded-xl bg-emerald-100 flex items-center justify-center text-emerald-700">
            <ShieldCheck class="w-6 h-6 text-emerald-700" />
          </div>
          <h4 class="text-xl font-serif font-bold text-[#064E3B]">
            3. Digital Age Resilience
          </h4>
          <p class="text-sm text-gray-600 leading-relaxed">
            Empowering parents to navigate screen addiction, peer pressure, and modern cultural dilemmas with firmness, warmth, and proactive boundary contracts.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Interactive Diagnostic Suite Section -->
  <section class="py-20 bg-[#F4F8F6]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row items-end justify-between gap-6 mb-12">
        <div class="space-y-3 max-w-2xl">
          <div class="inline-flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider text-[#0F766E]">
            <Sparkles class="w-3.5 h-3.5 text-[#F59E0B]" />
            <span>Self-Assessment Suite</span>
          </div>
          <h2 class="text-3xl sm:text-4xl font-serif font-bold text-[#064E3B]">
            Interactive Diagnostic Audits for Parents
          </h2>
          <p class="text-gray-600 text-sm sm:text-base leading-relaxed">
            Get instant clarity on your parenting strengths, child behavioral bottlenecks, and family routines with our scientifically calibrated assessments.
          </p>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        
        <!-- Audit 1: Parenting Style -->
        <div class="bg-white rounded-2xl p-6 border border-gray-200/80 shadow-sm hover:shadow-lg transition-all flex flex-col">
          <div class="flex items-center justify-between mb-4">
            <span class="text-xs font-bold text-[#0F766E] bg-[#0F766E]/10 px-2.5 py-1 rounded-full">
              Most Popular
            </span>
            <span class="text-xs text-gray-400 font-medium">3 min assessment</span>
          </div>
          <h3 class="text-lg font-serif font-bold text-[#064E3B] mb-2">
            Audit Your Parenting
          </h3>
          <p class="text-xs text-gray-600 leading-relaxed mb-6 flex-grow">
            Evaluate your daily communication habits, emotional responsiveness, and Islamic Tarbiyah implementation at home.
          </p>
          <a
            href="/audit-your-parenting/"
            class="w-full inline-flex items-center justify-center gap-2 py-3 px-4 rounded-xl bg-[#0F766E] hover:bg-[#064E3B] text-white text-xs font-bold shadow-sm transition-colors"
          >
            <span>Start Free Audit</span>
            <ArrowRight class="w-3.5 h-3.5" />
          </a>
        </div>

        <!-- Audit 2: Family Vision Maker -->
        <div class="bg-white rounded-2xl p-6 border border-gray-200/80 shadow-sm hover:shadow-lg transition-all flex flex-col">
          <div class="flex items-center justify-between mb-4">
            <span class="text-xs font-bold text-[#F59E0B] bg-[#F59E0B]/10 px-2.5 py-1 rounded-full">
              Family Blueprint
            </span>
            <span class="text-xs text-gray-400 font-medium">Interactive Tool</span>
          </div>
          <h3 class="text-lg font-serif font-bold text-[#064E3B] mb-2">
            Family Vision Maker
          </h3>
          <p class="text-xs text-gray-600 leading-relaxed mb-6 flex-grow">
            Formulate a clear, written Islamic mission statement and set core values that guide your household decisions.
          </p>
          <a
            href="/family-vision-maker/"
            class="w-full inline-flex items-center justify-center gap-2 py-3 px-4 rounded-xl bg-[#0F766E] hover:bg-[#064E3B] text-white text-xs font-bold shadow-sm transition-colors"
          >
            <span>Build Family Vision</span>
            <ArrowRight class="w-3.5 h-3.5" />
          </a>
        </div>

        <!-- Audit 3: Behavior Tracker -->
        <div class="bg-white rounded-2xl p-6 border border-gray-200/80 shadow-sm hover:shadow-lg transition-all flex flex-col">
          <div class="flex items-center justify-between mb-4">
            <span class="text-xs font-bold text-emerald-700 bg-emerald-50 px-2.5 py-1 rounded-full">
              Behavioral Tool
            </span>
            <span class="text-xs text-gray-400 font-medium">Daily Tracker</span>
          </div>
          <h3 class="text-lg font-serif font-bold text-[#064E3B] mb-2">
            Child Behavior Tracker
          </h3>
          <p class="text-xs text-gray-600 leading-relaxed mb-6 flex-grow">
            Identify behavioral triggers, record gradual positive shifts, and eliminate power struggles with structured feedback.
          </p>
          <a
            href="/childs-behavior-improvement-tracker/"
            class="w-full inline-flex items-center justify-center gap-2 py-3 px-4 rounded-xl bg-[#0F766E] hover:bg-[#064E3B] text-white text-xs font-bold shadow-sm transition-colors"
          >
            <span>Launch Tracker</span>
            <ArrowRight class="w-3.5 h-3.5" />
          </a>
        </div>

        <!-- Audit 4: Routine Maker Chart -->
        <div class="bg-white rounded-2xl p-6 border border-gray-200/80 shadow-sm hover:shadow-lg transition-all flex flex-col">
          <div class="flex items-center justify-between mb-4">
            <span class="text-xs font-bold text-teal-700 bg-teal-50 px-2.5 py-1 rounded-full">
              Daily Planner
            </span>
            <span class="text-xs text-gray-400 font-medium">Habit Chart</span>
          </div>
          <h3 class="text-lg font-serif font-bold text-[#064E3B] mb-2">
            Islamic Tarbiyah Routine Maker
          </h3>
          <p class="text-xs text-gray-600 leading-relaxed mb-6 flex-grow">
            Align morning routines, Salah times, study hours, and screen schedules for a calm, predictable home atmosphere.
          </p>
          <a
            href="/islamic-tarbiyah-home-routine-chart/"
            class="w-full inline-flex items-center justify-center gap-2 py-3 px-4 rounded-xl bg-white border border-[#0F766E] text-[#0F766E] hover:bg-[#0F766E] hover:text-white text-xs font-bold transition-colors"
          >
            <span>Create Home Routine</span>
            <ArrowRight class="w-3.5 h-3.5" />
          </a>
        </div>

        <!-- Audit 5: Personality Type -->
        <div class="bg-white rounded-2xl p-6 border border-gray-200/80 shadow-sm hover:shadow-lg transition-all flex flex-col">
          <div class="flex items-center justify-between mb-4">
            <span class="text-xs font-bold text-purple-700 bg-purple-50 px-2.5 py-1 rounded-full">
              Self Discovery
            </span>
            <span class="text-xs text-gray-400 font-medium">Personality Test</span>
          </div>
          <h3 class="text-lg font-serif font-bold text-[#064E3B] mb-2">
            Know Your Personality Type
          </h3>
          <p class="text-xs text-gray-600 leading-relaxed mb-6 flex-grow">
            Understand how your innate personality tendencies influence your parenting triggers, discipline style, and stress response.
          </p>
          <a
            href="/know-your-personality-type/"
            class="w-full inline-flex items-center justify-center gap-2 py-3 px-4 rounded-xl bg-white border border-[#0F766E] text-[#0F766E] hover:bg-[#0F766E] hover:text-white text-xs font-bold transition-colors"
          >
            <span>Discover Your Type</span>
            <ArrowRight class="w-3.5 h-3.5" />
          </a>
        </div>

        <!-- Audit 6: Marriage Relationships -->
        <div class="bg-white rounded-2xl p-6 border border-gray-200/80 shadow-sm hover:shadow-lg transition-all flex flex-col">
          <div class="flex items-center justify-between mb-4">
            <span class="text-xs font-bold text-rose-700 bg-rose-50 px-2.5 py-1 rounded-full">
              Couples Alignment
            </span>
            <span class="text-xs text-gray-400 font-medium">Relationship Audit</span>
          </div>
          <h3 class="text-lg font-serif font-bold text-[#064E3B] mb-2">
            Audit Marriage Relationships
          </h3>
          <p class="text-xs text-gray-600 leading-relaxed mb-6 flex-grow">
            Harmonize parenting teamwork between spouses. A peaceful, united marital foundation is the best Tarbiyah environment.
          </p>
          <a
            href="/audit-your-marriage-relationships/"
            class="w-full inline-flex items-center justify-center gap-2 py-3 px-4 rounded-xl bg-white border border-[#0F766E] text-[#0F766E] hover:bg-[#0F766E] hover:text-white text-xs font-bold transition-colors"
          >
            <span>Audit Relationship</span>
            <ArrowRight class="w-3.5 h-3.5" />
          </a>
        </div>

      </div>
    </div>
  </section>

  <!-- Featured Books & Toolkits Section (Direct WooCommerce Catalog) -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col sm:flex-row items-start sm:items-end justify-between gap-4 mb-12">
        <div class="space-y-2 max-w-2xl">
          <span class="text-xs font-bold uppercase tracking-wider text-[#0F766E]">
            Authentic Publications & Toolkits
          </span>
          <h2 class="text-3xl sm:text-4xl font-serif font-bold text-[#064E3B]">
            From the EduTarbiyah Bookstore
          </h2>
          <p class="text-gray-600 text-sm sm:text-base">
            Carefully curated, original publications on Tarbiyat ka Safar, positive parenting, and holistic personal growth.
          </p>
        </div>
        <a
          href="/shop/"
          class="inline-flex items-center gap-2 px-5 py-2.5 text-sm font-bold text-[#0F766E] bg-[#F4F8F6] hover:bg-[#0F766E] hover:text-white rounded-xl transition-all"
        >
          <span>View All Publications</span>
          <ArrowRight class="w-4 h-4" />
        </a>
      </div>

      <!-- Products Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {featuredProducts.map((product) => (
          <ProductCard product={product} />
        ))}
      </div>
    </div>
  </section>

  <!-- Flagship Programs Section -->
  <section class="py-20 bg-gradient-to-b from-[#FFFDF9] to-[#F4F8F6]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto space-y-3 mb-16">
        <span class="text-xs font-bold uppercase tracking-widest text-[#0F766E]">
          Mentorship & Training
        </span>
        <h2 class="text-3xl sm:text-4xl font-serif font-bold text-[#064E3B]">
          Flagship Parenting Programs
        </h2>
        <p class="text-gray-600 text-base">
          Systematic courses and 1-on-1 mentorship designed to transform theoretical knowledge into calm, confident daily parenting.
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        
        <!-- TPPC Course Card -->
        <div class="bg-white rounded-3xl p-8 sm:p-10 border border-gray-200/80 shadow-md hover:shadow-xl transition-all flex flex-col justify-between space-y-6">
          <div class="space-y-4">
            <div class="flex items-center justify-between">
              <span class="text-xs font-bold text-emerald-800 bg-emerald-50 px-3 py-1 rounded-full border border-emerald-200">
                Self-Paced Recorded Course
              </span>
              <span class="text-xs font-semibold text-gray-500">TPPC Certification</span>
            </div>
            <h3 class="text-2xl font-serif font-bold text-[#064E3B]">
              TTPC – Tarbiyah Parenting Practitioner Course
            </h3>
            <p class="text-sm text-gray-600 leading-relaxed">
              Our comprehensive recorded training curriculum covering child psychology, temperament identification, de-escalating defiance, habit formation, and spiritual grounding.
            </p>
            <ul class="space-y-2 text-sm text-gray-700 pt-2">
              <li class="flex items-center gap-2">
                <CheckCircle class="w-4 h-4 text-[#0F766E]" />
                <span>Lifetime access to comprehensive recorded video lectures</span>
              </li>
              <li class="flex items-center gap-2">
                <CheckCircle class="w-4 h-4 text-[#0F766E]" />
                <span>Downloadable habit workbooks & Tarbiyah checklists</span>
              </li>
              <li class="flex items-center gap-2">
                <CheckCircle class="w-4 h-4 text-[#0F766E]" />
                <span>Certificate of Completion from EduTarbiyah Institute</span>
              </li>
            </ul>
          </div>

          <div class="pt-6 border-t border-gray-100 flex flex-col sm:flex-row items-center justify-between gap-4">
            <a
              href="/tppc-self-paced-recorded-course/"
              class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl bg-[#0F766E] hover:bg-[#064E3B] text-white text-sm font-bold shadow transition-all"
            >
              <span>Explore TPPC Syllabus</span>
              <ArrowRight class="w-4 h-4" />
            </a>
            <a
              href={`https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent("السلام علیکم EduTarbiyah, I would like more information on the TPPC course.")}`}
              target="_blank"
              rel="noopener noreferrer"
              class="text-xs font-semibold text-[#0F766E] hover:underline flex items-center gap-1"
            >
              <MessageCircle class="w-4 h-4" />
              <span>Inquire on WhatsApp</span>
