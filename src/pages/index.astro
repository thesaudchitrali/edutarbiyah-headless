---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import { 
  getAllProducts, 
  getEnglishPosts, 
  getUrduPosts, 
  ENGLISH_BLOG_URL, 
  URDU_BLOG_URL, 
  WHATSAPP_NUMBER 
} from '../lib/api';
import { 
  Sparkles, 
  BookOpen, 
  Heart, 
  Compass, 
  Users, 
  ArrowRight, 
  CheckCircle, 
  ShieldCheck, 
  MessageCircle, 
  Clock, 
  Calendar, 
  GraduationCap, 
  Award,
  ArrowUpRight,
  Shield,
  Activity,
  Brain,
  Home,
  Check,
  Flame,
  Zap,
  Target,
  FileText,
  AlertCircle,
  X,
  Globe,
  ClipboardCheck,
  TrendingUp,
  HeartHandshake,
  Smartphone
} from 'lucide-astro';

// Fetch products and posts for dynamic showcase
const allProducts = await getAllProducts();
const featuredProducts = allProducts.slice(0, 4);

const englishPosts = await getEnglishPosts(3);
const urduPosts = await getUrduPosts(3);
---

<Layout
  title="EduTarbiyah | Raise Faithful, Confident & Emotionally Healthy Children in the Digital Age"
  description="EduTarbiyah helps Muslim parents build strong character, reduce screen addiction, improve behavior, create salah routines, and build a peaceful Islamic home."
  canonical="https://edutarbiyah.com/"
>

  <!-- 1. HERO SECTION (Exact Copy & Messaging from edutarbiyah.com) -->
  <section class="relative overflow-hidden bg-gradient-to-b from-[#F4F8F6] via-[#FFFDF9] to-[#FFFDF9] pt-12 pb-20 lg:pt-16 lg:pb-24 border-b border-gray-100">
    <div class="absolute inset-0 opacity-25 bg-[radial-gradient(#0F766E_1px,transparent_1px)] [background-size:24px_24px] pointer-events-none"></div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
        
        <!-- Left Hero Copy -->
        <div class="lg:col-span-7 space-y-6 text-center lg:text-left">
          
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#0F766E]/10 border border-[#0F766E]/20 text-[#0F766E] text-xs font-bold tracking-wide uppercase">
            <Sparkles class="w-3.5 h-3.5 text-[#F59E0B]" />
            <span>Complete Parenting & Tarbiyah Solutions</span>
          </div>

          <h1 class="text-3xl sm:text-5xl lg:text-5xl xl:text-6xl font-serif font-extrabold text-[#064E3B] tracking-tight leading-[1.15]">
            Raise Faithful, Confident & Emotionally Healthy Children in the <span class="text-[#0F766E] italic font-normal">Digital Age</span>
          </h1>

          <p class="text-base sm:text-lg text-gray-600 leading-relaxed max-w-2xl mx-auto lg:mx-0 font-normal">
            EduTarbiyah helps Muslim parents build strong character, reduce screen addiction, improve behavior, create salah and Quran routines, and develop a peaceful Islamic home through coaching, courses, books, blogs, free resources and practical tools.
          </p>

          <!-- Action Buttons -->
          <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-3.5 pt-2">
            <a
              href="/audit-your-parenting/"
              class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 px-7 py-4 rounded-2xl bg-[#0F766E] hover:bg-[#064E3B] text-white text-sm sm:text-base font-bold shadow-lg shadow-[#0F766E]/25 hover:shadow-xl hover:shadow-[#0F766E]/35 hover:-translate-y-0.5 transition-all duration-200"
            >
              <CheckCircle class="w-5 h-5 text-[#F59E0B]" />
              <span>Audit Your Parenting Free</span>
            </a>

            <a
              href={`https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent("Assalamualaikum EduTarbiyah, I want to join your WhatsApp Parenting Community.")}`}
              target="_blank"
              rel="noopener noreferrer"
              class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-4 rounded-2xl bg-[#25D366] hover:bg-[#1EBE5D] text-white text-sm sm:text-base font-bold shadow-md hover:shadow-lg transition-all duration-200"
            >
              <MessageCircle class="w-5 h-5 fill-current" />
              <span>Join WhatsApp Community</span>
            </a>

            <a
              href="/tppc-live-interactive-parenting-course/"
              class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-4 rounded-2xl bg-white hover:bg-gray-50 text-[#064E3B] text-sm sm:text-base font-bold border border-gray-200 shadow-sm hover:shadow transition-all duration-200"
            >
              <GraduationCap class="w-5 h-5 text-[#0F766E]" />
              <span>View TPPC Course</span>
            </a>
          </div>

          <!-- Trust Badges Row -->
          <div class="pt-6 border-t border-gray-200/60 flex flex-wrap items-center justify-center lg:justify-start gap-6 text-xs sm:text-sm font-semibold text-gray-700">
            <div class="flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-[#0F766E]"></span>
              <span>Islamic Tarbiyah</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-[#F59E0B]"></span>
              <span>Modern Parenting</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-emerald-600"></span>
              <span>Practical Home Tools</span>
            </div>
          </div>
        </div>

        <!-- Right Hero: Founder & Head Mentor Card -->
        <div class="lg:col-span-5 relative">
          <div class="relative mx-auto max-w-md lg:max-w-none">
            <!-- Background Glow -->
            <div class="absolute -inset-2 bg-gradient-to-r from-[#0F766E] to-[#F59E0B] rounded-3xl blur-xl opacity-20 transform -rotate-1"></div>

            <div class="relative bg-white rounded-3xl p-6 sm:p-8 shadow-2xl border border-gray-100 text-center space-y-5">
              
              <!-- Mentor Photo -->
              <div class="relative w-36 h-36 mx-auto rounded-full overflow-hidden border-4 border-[#0F766E]/20 shadow-lg bg-emerald-50">
                <img
                  src="/images/dr-younus-khalid.webp"
                  alt="Dr. Muhammad Younus Khalid"
                  class="w-full h-full object-cover object-top"
                  loading="eager"
                  width="144"
                  height="144"
                />
              </div>

              <!-- Mentor Credentials -->
              <div class="space-y-1">
                <h2 class="text-xl sm:text-2xl font-serif font-extrabold text-[#064E3B]">
                  Dr. Muhammad Younus Khalid
                </h2>
                <p class="text-xs sm:text-sm text-gray-600 font-medium">
                  Parenting & Tarbiyah Coach | Islamic Scholar | Trainer | Author
                </p>
              </div>

              <!-- Professional Badges -->
              <div class="flex flex-wrap justify-center gap-1.5 text-[11px] font-semibold text-[#064E3B]">
                <span class="px-2.5 py-1 rounded-full bg-emerald-50 border border-emerald-200">Ph.D.</span>
                <span class="px-2.5 py-1 rounded-full bg-emerald-50 border border-emerald-200">Islamic Scholar</span>
                <span class="px-2.5 py-1 rounded-full bg-emerald-50 border border-emerald-200">Parenting Coach</span>
                <span class="px-2.5 py-1 rounded-full bg-emerald-50 border border-emerald-200">NLP & MBTI Practitioner</span>
              </div>

              <!-- CTA to Coaching -->
              <div class="pt-2">
                <a
                  href="/edutarbiyah-parent-coaching-program/"
                  class="w-full inline-flex items-center justify-center gap-2 py-3 px-6 rounded-xl bg-[#064E3B] hover:bg-[#043327] text-white text-sm font-bold shadow-md hover:shadow-lg transition-all"
                >
                  <Users class="w-4 h-4 text-amber-300" />
                  <span>Get Parent Coaching</span>
                </a>
              </div>

              <p class="text-[11px] text-gray-400">
                Over 5,000+ parents and educators guided across Pakistan and globally.
              </p>

            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- 2. PARENTING PROBLEMS WE SOLVE ("Are You Facing These Challenges at Home?") -->
  <section class="py-16 lg:py-20 bg-[#F8FFFC] border-b border-[#0F766E]/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      
      <div class="text-center max-w-3xl mx-auto space-y-3">
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-rose-100 text-rose-800 text-xs font-bold uppercase tracking-wider">
          <AlertCircle class="w-3.5 h-3.5" />
          <span>Parenting Problems We Solve</span>
        </div>
        <h2 class="text-3xl sm:text-4xl font-serif font-extrabold text-[#064E3B]">
          Are You Facing These Challenges at Home?
        </h2>
        <p class="text-gray-600 text-base leading-relaxed">
          Many parents love their children deeply, but they struggle because they do not have a clear, practical and consistent parenting system.
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        
        <!-- The 5 Pain Points List -->
        <div class="lg:col-span-7 bg-white rounded-3xl p-6 sm:p-8 border border-gray-200 shadow-sm space-y-4">
          
          <div class="flex items-start gap-3.5 p-3.5 rounded-xl bg-gray-50 border border-gray-100 text-sm font-medium text-gray-800">
            <span class="w-6 h-6 rounded-full bg-rose-100 text-rose-700 flex items-center justify-center shrink-0 mt-0.5">
              <X class="w-3.5 h-3.5" />
            </span>
            <span>Child’s anger, stubbornness, and back-answering are increasing.</span>
          </div>

          <div class="flex items-start gap-3.5 p-3.5 rounded-xl bg-gray-50 border border-gray-100 text-sm font-medium text-gray-800">
            <span class="w-6 h-6 rounded-full bg-rose-100 text-rose-700 flex items-center justify-center shrink-0 mt-0.5">
              <X class="w-3.5 h-3.5" />
            </span>
            <span>Mobile, games, YouTube, and screen addiction are disturbing daily routine.</span>
          </div>

          <div class="flex items-start gap-3.5 p-3.5 rounded-xl bg-gray-50 border border-gray-100 text-sm font-medium text-gray-800">
            <span class="w-6 h-6 rounded-full bg-rose-100 text-rose-700 flex items-center justify-center shrink-0 mt-0.5">
              <X class="w-3.5 h-3.5" />
            </span>
            <span>Salah, Quran, study, and sleep routines are constantly inconsistent.</span>
          </div>

          <div class="flex items-start gap-3.5 p-3.5 rounded-xl bg-gray-50 border border-gray-100 text-sm font-medium text-gray-800">
            <span class="w-6 h-6 rounded-full bg-rose-100 text-rose-700 flex items-center justify-center shrink-0 mt-0.5">
              <X class="w-3.5 h-3.5" />
            </span>
            <span>Parents often shout, feel immense guilt, and then lose consistency.</span>
          </div>

          <div class="flex items-start gap-3.5 p-3.5 rounded-xl bg-gray-50 border border-gray-100 text-sm font-medium text-gray-800">
            <span class="w-6 h-6 rounded-full bg-rose-100 text-rose-700 flex items-center justify-center shrink-0 mt-0.5">
              <X class="w-3.5 h-3.5" />
            </span>
            <span>Children listen less, argue more, and the emotional connection becomes weak.</span>
          </div>

        </div>

        <!-- The Solution Highlight Panel -->
        <div class="lg:col-span-5 bg-gradient-to-br from-[#064E3B] to-[#0A4D3C] text-white rounded-3xl p-8 sm:p-10 shadow-xl space-y-6">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/10 text-amber-300 text-xs font-bold uppercase tracking-wider">
            <Compass class="w-3.5 h-3.5" />
            <span>The EduTarbiyah Solution</span>
          </div>

          <h3 class="text-2xl sm:text-3xl font-serif font-bold text-white leading-snug">
            EduTarbiyah gives you a clear parenting roadmap.
          </h3>

          <p class="text-sm text-emerald-100 leading-relaxed">
            Our approach combines Islamic Tarbiyah, child psychology, emotional connection, positive discipline, digital discipline and practical home routines.
          </p>

          <div class="pt-2 flex flex-col sm:flex-row gap-3">
            <a
              href="/audit-your-parenting/"
              class="w-full sm:w-auto inline-flex items-center justify-center gap-2 py-3.5 px-6 rounded-xl bg-[#F59E0B] hover:bg-amber-400 text-gray-950 font-extrabold text-sm shadow transition-all"
            >
              <span>Check Your Parenting Level</span>
              <ArrowRight class="w-4 h-4" />
            </a>

            <a
              href="/intake-form/"
              class="w-full sm:w-auto inline-flex items-center justify-center gap-2 py-3.5 px-6 rounded-xl bg-white/10 hover:bg-white/20 border border-white/20 text-white font-bold text-sm transition-all"
            >
              <span>Book Coaching</span>
            </a>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- 3. START WITH FREE PARENTING AUDIT SECTION -->
  <section class="py-16 bg-white border-b border-gray-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-gradient-to-r from-[#F8FFFC] via-white to-[#F8FFFC] rounded-3xl border-2 border-[#0F766E]/20 p-8 sm:p-12 shadow-sm">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
          
          <div class="lg:col-span-7 space-y-4 text-center lg:text-left">
            <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-100 text-[#064E3B] text-xs font-bold uppercase tracking-wider">
              <CheckCircle class="w-3.5 h-3.5" />
              <span>Zero-Cost Diagnostic Assessment</span>
            </div>
            <h2 class="text-2xl sm:text-4xl font-serif font-extrabold text-[#064E3B]">
              Start with Free Parenting Audit
            </h2>
            <p class="text-gray-600 text-sm sm:text-base leading-relaxed max-w-xl">
              Before buying any course or coaching, discover where your parenting needs improvement: connection, discipline, screen time, routine, salah, communication and emotional control.
            </p>
            <div class="pt-3 flex flex-wrap justify-center lg:justify-start gap-3">
              <a
                href="/audit-your-parenting/"
                class="inline-flex items-center gap-2 px-7 py-3.5 rounded-xl bg-[#0F766E] hover:bg-[#064E3B] text-white text-sm font-bold shadow-md transition-all"
              >
                <span>Start Free Audit Now</span>
                <ArrowRight class="w-4 h-4" />
              </a>
              <a
                href={`https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent("Assalamualaikum EduTarbiyah, I want guidance about my parenting audit.")}`}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 px-6 py-3.5 rounded-xl border border-[#0F766E]/30 text-[#064E3B] hover:bg-[#F4F8F6] text-sm font-semibold transition-colors"
              >
                <MessageCircle class="w-4 h-4 text-[#0F766E]" />
                <span>Ask on WhatsApp</span>
              </a>
            </div>
          </div>

          <!-- 6 Pillars Mini Evaluation Badges -->
          <div class="lg:col-span-5 grid grid-cols-2 gap-3 text-center">
            <div class="p-3.5 rounded-2xl bg-white border border-gray-200 shadow-sm text-xs font-bold text-gray-800 flex items-center justify-center gap-2">
              <Heart class="w-4 h-4 text-rose-500" />
              <span>Relationship</span>
            </div>
            <div class="p-3.5 rounded-2xl bg-white border border-gray-200 shadow-sm text-xs font-bold text-gray-800 flex items-center justify-center gap-2">
              <Shield class="w-4 h-4 text-amber-500" />
              <span>Discipline</span>
            </div>
            <div class="p-3.5 rounded-2xl bg-white border border-gray-200 shadow-sm text-xs font-bold text-gray-800 flex items-center justify-center gap-2">
              <Clock class="w-4 h-4 text-blue-500" />
              <span>Screen Time</span>
            </div>
            <div class="p-3.5 rounded-2xl bg-white border border-gray-200 shadow-sm text-xs font-bold text-gray-800 flex items-center justify-center gap-2">
              <Compass class="w-4 h-4 text-emerald-600" />
              <span>Salah Routine</span>
            </div>
            <div class="p-3.5 rounded-2xl bg-white border border-gray-200 shadow-sm text-xs font-bold text-gray-800 flex items-center justify-center gap-2">
              <Activity class="w-4 h-4 text-teal-600" />
              <span>Behavior</span>
            </div>
            <div class="p-3.5 rounded-2xl bg-white border border-gray-200 shadow-sm text-xs font-bold text-gray-800 flex items-center justify-center gap-2">
              <Brain class="w-4 h-4 text-purple-600" />
              <span>Emotions</span>
            </div>
          </div>

        </div>
      </div>
    </div>
  </section>

  <!-- 4. JOIN EDUTARBIYAH WHATSAPP PARENTING COMMUNITY -->
  <section class="py-16 bg-[#F8FFFC] border-b border-[#0F766E]/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-white rounded-3xl border border-[#0F766E]/20 p-8 sm:p-12 shadow-md">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
          
          <div class="lg:col-span-7 space-y-4">
            <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-50 text-[#0F766E] text-xs font-bold uppercase tracking-wider">
              <MessageCircle class="w-3.5 h-3.5 text-[#25D366]" />
              <span>Join Our Parenting Community</span>
            </div>
            <h2 class="text-2xl sm:text-4xl font-serif font-extrabold text-[#064E3B]">
              Join EduTarbiyah WhatsApp Parenting Community
            </h2>
            <p class="text-gray-600 text-sm sm:text-base leading-relaxed">
              Our WhatsApp community is created for parents who want regular parenting tips, Islamic Tarbiyah reminders, free resources, course updates, book offers and practical home routines.
            </p>
            <div class="pt-2 flex flex-wrap gap-3">
              <a
                href={`https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent("Assalamualaikum EduTarbiyah, I want to join your WhatsApp Parenting Community.")}`}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 px-7 py-3.5 rounded-xl bg-[#25D366] hover:bg-[#1EBE5D] text-white text-sm font-bold shadow-md transition-all"
              >
                <MessageCircle class="w-4 h-4 fill-current" />
                <span>Join WhatsApp Community</span>
              </a>
              <a
                href="https://blog.edutarbiyah.com/"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2 px-6 py-3.5 rounded-xl bg-[#F8FFFC] hover:bg-[#F4F8F6] border border-[#0F766E]/20 text-[#064E3B] text-sm font-bold transition-colors font-urdu"
              >
                <span>اردو بلاگ اور مضامین</span>
                <ArrowUpRight class="w-4 h-4" />
              </a>
            </div>
          </div>

          <!-- Feature Checklist -->
          <div class="lg:col-span-5 bg-[#F8FFFC] rounded-2xl p-6 border border-[#0F766E]/15 space-y-3">
            <div class="flex items-center gap-3 text-xs sm:text-sm font-medium text-gray-800">
              <span class="w-5 h-5 rounded-full bg-emerald-100 text-[#064E3B] flex items-center justify-center shrink-0">
                <Check class="w-3.5 h-3.5" />
              </span>
              <span>Free parenting tips and daily Tarbiyah reminders</span>
            </div>
            <div class="flex items-center gap-3 text-xs sm:text-sm font-medium text-gray-800">
              <span class="w-5 h-5 rounded-full bg-emerald-100 text-[#064E3B] flex items-center justify-center shrink-0">
                <Check class="w-3.5 h-3.5" />
              </span>
              <span>Screen time contracts and behavioral guidance</span>
            </div>
            <div class="flex items-center gap-3 text-xs sm:text-sm font-medium text-gray-800">
              <span class="w-5 h-5 rounded-full bg-emerald-100 text-[#064E3B] flex items-center justify-center shrink-0">
                <Check class="w-3.5 h-3.5" />
              </span>
              <span>Islamic Tarbiyah home routine ideas & Salah charts</span>
            </div>
            <div class="flex items-center gap-3 text-xs sm:text-sm font-medium text-gray-800">
              <span class="w-5 h-5 rounded-full bg-emerald-100 text-[#064E3B] flex items-center justify-center shrink-0">
                <Check class="w-3.5 h-3.5" />
              </span>
              <span>Free downloadable checklists, trackers and PDF toolkits</span>
            </div>
            <div class="flex items-center gap-3 text-xs sm:text-sm font-medium text-gray-800">
              <span class="w-5 h-5 rounded-full bg-emerald-100 text-[#064E3B] flex items-center justify-center shrink-0">
                <Check class="w-3.5 h-3.5" />
              </span>
              <span>Exclusive course, coaching, and publication discounts</span>
            </div>
          </div>

        </div>
      </div>
    </div>
  </section>

  <!-- 5. CHOOSE THE RIGHT PATH / OUR CORE OFFERS -->
  <section class="py-20 bg-white border-b border-gray-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      
      <div class="text-center max-w-3xl mx-auto space-y-3">
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-100 text-[#064E3B] text-xs font-bold uppercase tracking-wider">
          <Target class="w-3.5 h-3.5 text-[#F59E0B]" />
          <span>Our Core Offers</span>
        </div>
        <h2 class="text-3xl sm:text-4xl font-serif font-extrabold text-[#064E3B]">
          Choose the Right Path for Your Parenting Journey
        </h2>
        <p class="text-gray-600 text-base leading-relaxed">
          Whether you need personal guidance, a complete course, or self-learning resources, EduTarbiyah gives you practical solutions.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        
        <!-- Offer 1: Parent Coaching -->
        <div class="bg-[#FFFDF9] rounded-3xl p-8 border border-gray-200/80 shadow-sm hover:shadow-xl transition-all flex flex-col justify-between space-y-6">
          <div class="space-y-4">
            <div class="w-12 h-12 rounded-2xl bg-emerald-50 border border-emerald-100 flex items-center justify-center text-emerald-700">
              <Users class="w-6 h-6 text-[#0F766E]" />
            </div>
            <h3 class="text-2xl font-serif font-bold text-[#064E3B]">
              Parent Coaching
            </h3>
            <p class="text-xs sm:text-sm text-gray-600 leading-relaxed">
              For parents who need personal guidance for their child’s specific behavior, screen time, routine and emotional issues.
            </p>
            <ul class="space-y-2.5 text-xs sm:text-sm text-gray-700 pt-2">
              <li class="flex items-center gap-2">
                <CheckCircle class="w-4 h-4 text-[#0F766E]" />
                <span>One-to-one practical guidance</span>
              </li>
              <li class="flex items-center gap-2">
                <CheckCircle class="w-4 h-4 text-[#0F766E]" />
                <span>Child behavior analysis</span>
              </li>
              <li class="flex items-center gap-2">
                <CheckCircle class="w-4 h-4 text-[#0F766E]" />
                <span>Personalized action plan</span>
