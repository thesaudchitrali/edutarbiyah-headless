---
import Layout from '../layouts/Layout.astro';
import { WHATSAPP_NUMBER } from '../lib/api';
import { 
  Sparkles, 
  CheckCircle2, 
  Target, 
  Heart, 
  Shield, 
  ShieldCheck, 
  Flame, 
  Compass, 
  Clock, 
  BookOpen, 
  User, 
  Users, 
  MessageCircle, 
  AlertCircle, 
  ArrowRight, 
  ArrowLeft, 
  RotateCcw, 
  Printer, 
  Share2, 
  HelpCircle, 
  Download, 
  Copy, 
  ChevronRight, 
  Check, 
  Star, 
  Lightbulb, 
  Zap, 
  Award, 
  ExternalLink, 
  Globe,
  Smartphone
} from 'lucide-astro';
---

<Layout
  title="Reconnect & Guide Your Teen | 5-Step Action Plan | EduTarbiyah"
  description="A practical 5-step prophetic action plan for Muslim parents to reconnect, establish firm boundaries, build responsibility, and guide teenagers with love and wisdom."
  canonical="https://edutarbiyah.com/reconnect-guide/"
>

  <!-- Print Specific CSS -->
  <style is:global>
    @media print {
      header, footer, nav, #top-breadcrumbs, #hero-section, #presets-section, #wizard-stepper, #wizard-controls, #framework-section, #faq-section, #cta-section, #floating-whatsapp, #lang-toggle-btn, .no-print {
        display: none !important;
      }
      body {
        background: white !important;
        color: black !important;
        padding: 0 !important;
        margin: 0 !important;
      }
      #printable-teen-plan {
        display: block !important;
        border: 2px solid #064E3B !important;
        box-shadow: none !important;
        page-break-inside: avoid !important;
        margin: 20px auto !important;
        max-width: 100% !important;
        padding: 24px !important;
        background: white !important;
      }
      .print-only {
        display: block !important;
      }
    }
  </style>

  <!-- Top Breadcrumbs & Bilingual Toggle -->
  <div id="top-breadcrumbs" class="bg-[#F8FFFC] border-b border-[#0F766E]/10 py-3 px-4 sm:px-6 text-xs text-gray-500">
    <div class="max-w-5xl mx-auto flex items-center justify-between">
      <div class="flex items-center gap-2">
        <a href="/" class="hover:text-[#0F766E] transition-colors">Home</a>
        <ChevronRight class="w-3.5 h-3.5 text-gray-400" />
        <span class="text-gray-400">Parenting Tools</span>
        <ChevronRight class="w-3.5 h-3.5 text-gray-400" />
        <span class="text-[#064E3B] font-semibold" data-en="Reconnect & Guide Your Teen" data-ur="نوجوان اولاد سے تعلق کی بحالی">Reconnect & Guide Your Teen</span>
      </div>
      <div class="flex items-center gap-3">
        <!-- Language Switcher -->
        <button
          type="button"
          id="lang-toggle-btn"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-white border border-[#0F766E]/20 text-[#064E3B] font-bold text-xs shadow-sm hover:bg-[#F4F8F6] transition-colors cursor-pointer"
          aria-label="Switch Language / زبان تبدیل کریں"
        >
          <Globe class="w-3.5 h-3.5 text-[#0F766E]" />
          <span id="lang-toggle-text">اردو میں دیکھیں</span>
        </button>
      </div>
    </div>
  </div>

  <!-- Hero Header Section -->
  <section id="hero-section" class="relative bg-gradient-to-b from-[#064E3B] via-[#095944] to-[#064E3B] text-white py-12 lg:py-16 overflow-hidden">
    <div class="absolute inset-0 opacity-10 bg-[radial-gradient(#F59E0B_1px,transparent_1px)] [background-size:24px_24px] pointer-events-none"></div>

    <div class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-6">
      
      <!-- Top Badge -->
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white/10 text-[#F59E0B] text-xs font-bold tracking-wide uppercase backdrop-blur-md border border-white/15">
        <Heart class="w-4 h-4 text-rose-400" />
        <span data-en="Adolescent Tarbiyah & Relationship Healing" data-ur="نوجوانوں کی اسلامی تربیت اور باہمی تعلق کی بحالی">
          Adolescent Tarbiyah & Relationship Healing
        </span>
      </div>

      <!-- Main Headline -->
      <h1 class="text-3xl sm:text-5xl font-serif font-extrabold text-white tracking-tight leading-tight">
        <span data-en="Reconnect & Guide Your Teen" data-ur="نوجوان اولاد کے ساتھ تعلق کی بحالی اور درست رہنمائی">
          Reconnect & Guide Your Teen
        </span>
      </h1>

      <!-- The Core Transformation Formula Callout -->
      <div class="bg-white/10 backdrop-blur-md border border-amber-300/30 rounded-2xl p-4 sm:p-5 max-w-3xl mx-auto shadow-inner text-center">
        <p class="text-xs sm:text-sm font-bold uppercase tracking-wider text-amber-300 mb-1" data-en="The Proven 5-Step Transformation Formula:" data-ur="تربیت اور اصلاح کا 5 نکاتی بنیادی فارمولا:">
          The Proven 5-Step Transformation Formula:
        </p>
        <p class="font-serif text-white text-sm sm:text-lg font-bold tracking-wide">
          <span class="text-amber-200" data-en="Reconnection" data-ur="تعلق">Reconnection</span> → 
          <span class="text-emerald-200" data-en="Boundaries" data-ur="حدود">Boundaries</span> → 
          <span class="text-teal-200" data-en="Responsibility" data-ur="ذمہ داری">Responsibility</span> → 
          <span class="text-amber-200" data-en="Positive Engagement" data-ur="مثبت مصروفیات">Positive Engagement</span> → 
          <span class="text-emerald-200" data-en="Accountability" data-ur="احتساب">Accountability</span> = 
          <span class="text-[#F59E0B] underline underline-offset-4 decoration-amber-400" data-en="Transformation" data-ur="کامیاب تربیت">Transformation</span>
        </p>
      </div>

      <!-- Hero Subtitle -->
      <p class="text-base sm:text-lg text-[#D1FAE5] max-w-2xl mx-auto leading-relaxed font-normal">
        <span data-en="A practical action plan for parents navigating teen mood swings, screen overuse, defiance, or distance. Rules without relationship lead to rebellion — rebuild trust first, then guide with firm love." data-ur="ایک عملی لائحہ عمل ان والدین کے لیے جو نوجوان اولاد کی دوری، ضد، اسکرین کی عادت یا غصے سے پریشان ہیں۔ بغیر تعلق کے قانون سازی بغاوت پیدا کرتی ہے — پہلے دل جیتیں، پھر باوقار رہنمائی کریں۔">
          A practical action plan for parents navigating teen mood swings, screen overuse, defiance, or distance. Rules without relationship lead to rebellion — rebuild trust first, then guide with firm love.
        </span>
      </p>

      <!-- Key Pillars Badges -->
      <div class="pt-2 flex flex-wrap justify-center gap-2 sm:gap-3 text-xs sm:text-sm font-medium text-emerald-100">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-white/10 backdrop-blur-sm border border-white/10">
          <Users class="w-4 h-4 text-[#F59E0B]" />
          <span data-en="5 Diagnostic Stages" data-ur="5 تشخیصی مراحل">5 Diagnostic Stages</span>
        </span>
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-white/10 backdrop-blur-sm border border-white/10">
          <Shield class="w-4 h-4 text-[#F59E0B]" />
          <span data-en="Firm Family Boundaries" data-ur="واضح خاندانی حدود">Firm Family Boundaries</span>
        </span>
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-white/10 backdrop-blur-sm border border-white/10">
          <Printer class="w-4 h-4 text-[#F59E0B]" />
          <span data-en="Printable Action Plan" data-ur="پرنٹ ایبل معاہدہ">Printable Action Plan</span>
        </span>
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-white/10 backdrop-blur-sm border border-white/10">
          <MessageCircle class="w-4 h-4 text-[#F59E0B]" />
          <span data-en="Coach Feedback" data-ur="کوچ فیڈبیک">Coach Feedback</span>
        </span>
      </div>

    </div>
  </section>

  <!-- Main Container -->
  <main class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-10 lg:py-14 space-y-12">

    <!-- PRESETS SCENARIOS BAR -->
    <section id="presets-section" class="bg-gradient-to-br from-[#F8FFFC] to-[#FFFDF9] rounded-2xl border border-[#0F766E]/20 p-6 shadow-sm">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-4">
        <div>
          <h2 class="text-lg font-serif font-bold text-[#064E3B] flex items-center gap-2">
            <Lightbulb class="w-5 h-5 text-[#F59E0B]" />
            <span data-en="Common Teen Scenarios (Click to Pre-fill):" data-ur="نوجوانوں کے عام مسائل (حل کے لیے کلک کریں):">
              Common Teen Scenarios (Click to Pre-fill):
            </span>
          </h2>
          <p class="text-xs text-gray-500 mt-0.5">
            <span data-en="Select your teen's most pressing challenge to see a tailored recovery blueprint." data-ur="اپنے نوجوان بچے کے سب سے بڑے مسئلے پر کلک کریں تاکہ آزمودہ لائحہ عمل خودبخود مرتب ہو سکے۔">
              Select your teen's most pressing challenge to see a tailored recovery blueprint.
            </span>
          </p>
        </div>
        <button
          type="button"
          id="clear-form-btn"
          class="text-xs text-gray-400 hover:text-red-600 transition-colors inline-flex items-center gap-1 self-start sm:self-auto cursor-pointer"
        >
          <RotateCcw class="w-3.5 h-3.5" />
          <span data-en="Reset Form" data-ur="فارم صاف کریں">Reset Form</span>
        </button>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-3">
        <!-- Preset 1: Screen & Gaming Addiction -->
        <button
          type="button"
          class="preset-card text-left p-3.5 rounded-xl border border-emerald-100 bg-white hover:border-[#0F766E] hover:shadow-md transition-all group cursor-pointer"
          data-connection="2"
          data-boundaries="2"
          data-responsibility="2"
          data-habits="1"
          data-accountability="3"
          data-rule-en="Mobile & gaming allowed for 60 minutes only after homework & Maghrib prayer."
          data-rule-ur="موبائل اور گیمز صرف مغرب کی نماز اور ہوم ورک کے بعد زیادہ سے زیادہ 60 منٹ کے لیے۔"
          data-resp-en="Keep study desk clean and manage personal laundry / shoes."
          data-resp-ur="اپنا اسٹڈی ٹیبل صاف رکھنا اور کپڑے و جوتے ترتیب سے رکھنا۔"
          data-act-en="Join martial arts / football academy, 15 min daily evening family walk."
          data-act-ur="مارشل آرٹس یا فٹ بال اکیڈمی جوائن کرنا اور شام کو 15 منٹ چہل قدمی۔"
        >
          <div class="flex items-center gap-2 font-bold text-sm text-[#064E3B] group-hover:text-[#0F766E]">
            <Smartphone class="w-4 h-4 text-[#0F766E]" />
            <span data-en="Screen & Gaming" data-ur="اسکرین اور گیمنگ">Screen & Gaming</span>
          </div>
          <p class="text-xs text-gray-500 mt-1 line-clamp-2">
            <span data-en="Addiction to reels & gaming, isolating in bedroom." data-ur="کمرے میں بند رہنا اور موبائل کا بے تحاشا استعمال۔">Addiction to reels & gaming, isolating in bedroom.</span>
          </p>
        </button>

        <!-- Preset 2: Anger & Disrespect -->
        <button
          type="button"
          class="preset-card text-left p-3.5 rounded-xl border border-emerald-100 bg-white hover:border-[#0F766E] hover:shadow-md transition-all group cursor-pointer"
          data-connection="1"
          data-boundaries="3"
          data-responsibility="1"
          data-habits="4"
          data-accountability="4"
          data-rule-en="We pause when upset; shouting or disrespectful language results in an immediate calm timeout."
          data-rule-ur="غصے میں بات نہیں ہوگی؛ بدتمیزی یا اونچی آواز پر فوراً خاموش بریک لیا جائے گا۔"
          data-resp-en="Help serve dinner table and clear plates without arguments."
          data-resp-ur="کھانے کی میز لگانے اور برتن سمیٹنے میں روزانہ حصہ لینا۔"
          data-act-en="1-on-1 parent coffee / drive once a week, listening without lectures."
          data-act-ur="ہفتے میں ایک بار والدین کے ساتھ اکیلے ڈرائیو یا چائے، بنا کسی نصیحت کے سننا۔"
        >
          <div class="flex items-center gap-2 font-bold text-sm text-[#064E3B] group-hover:text-[#0F766E]">
            <AlertCircle class="w-4 h-4 text-amber-600" />
            <span data-en="Anger & Backtalk" data-ur="غصہ اور بدتمیزی">Anger & Backtalk</span>
          </div>
          <p class="text-xs text-gray-500 mt-1 line-clamp-2">
            <span data-en="Frequent shouting, eye-rolling, arguing over small things." data-ur="چھوٹی بات پر چیخنا، بحث اور الٹے جوابات دینا۔">Frequent shouting, eye-rolling, arguing over small things.</span>
          </p>
        </button>

        <!-- Preset 3: Prayer & Values Drift -->
        <button
          type="button"
          class="preset-card text-left p-3.5 rounded-xl border border-emerald-100 bg-white hover:border-[#0F766E] hover:shadow-md transition-all group cursor-pointer"
          data-connection="3"
          data-boundaries="5"
          data-responsibility="3"
          data-habits="2"
          data-accountability="3"
          data-rule-en="Salah is prayed together as a family at home whenever we are present."
          data-rule-ur="گھر میں موجود ہونے پر نماز باجماعت سب مل کر ادا کریں گے۔"
          data-resp-en="Call the family Adhan and place prayer mats neatly."
          data-resp-ur="نماز کے وقت اذان دینا اور جائے نمازیں بچھانا۔"
          data-act-en="Listen to youth-friendly Seerah podcast together, open Q&A on faith."
          data-act-ur="نوجوانوں کے لیے سیرت پوڈکاسٹ سننا اور دوستانہ سوال و جواب۔"
        >
          <div class="flex items-center gap-2 font-bold text-sm text-[#064E3B] group-hover:text-[#0F766E]">
            <Compass class="w-4 h-4 text-teal-600" />
            <span data-en="Prayer Resistance" data-ur="نماز میں سستی">Prayer Resistance</span>
          </div>
          <p class="text-xs text-gray-500 mt-1 line-clamp-2">
            <span data-en="Skipping Salah, spiritual indifference, skeptical questions." data-ur="نماز چھوڑنا، دینی معاملات میں بیزاری اور شکوک۔">Skipping Salah, spiritual indifference, skeptical questions.</span>
          </p>
        </button>

        <!-- Preset 4: Laziness & Study Avoidance -->
        <button
          type="button"
          class="preset-card text-left p-3.5 rounded-xl border border-emerald-100 bg-white hover:border-[#0F766E] hover:shadow-md transition-all group cursor-pointer"
          data-connection="2"
          data-boundaries="4"
          data-responsibility="1"
          data-habits="5"
          data-accountability="4"
          data-rule-en="Dedicated 90-minute study block in the living room before any leisure or entertainment."
          data-rule-ur="تفریح یا موبائل سے پہلے لاؤنج میں 90 منٹ پڑھائی کا لازمی وقت۔"
          data-resp-en="Prepare own school bag and organize books before 9:00 PM."
          data-resp-ur="رات 9 بجے سے پہلے اسکول بیگ اور کتابیں خود تیار کرنا۔"
          data-act-en="Hands-on weekend coding / graphic skill learning, father-son gym routine."
          data-act-ur="ویک اینڈ پر کوئی ہنر یا اسکل سیکھنا، والد کے ساتھ واک یا ورزش۔"
        >
          <div class="flex items-center gap-2 font-bold text-sm text-[#064E3B] group-hover:text-[#0F766E]">
            <BookOpen class="w-4 h-4 text-emerald-600" />
            <span data-en="Study Avoidance" data-ur="پڑھائی سے فرار">Study Avoidance</span>
          </div>
          <p class="text-xs text-gray-500 mt-1 line-clamp-2">
            <span data-en="Procrastination, poor grades, lying about homework." data-ur="ہوم ورک سے جھوٹ بولنا اور پڑھائی میں لاپرواہی۔">Procrastination, poor grades, lying about homework.</span>
          </p>
        </button>
      </div>
    </section>

    <!-- INTERACTIVE 5-STEP TEEN PLANNER WIZARD -->
    <section class="bg-white rounded-3xl border border-gray-200/80 shadow-xl overflow-hidden">

      <!-- Wizard Progress Header -->
      <div id="wizard-stepper" class="bg-[#F8FFFC] border-b border-[#0F766E]/15 p-5 sm:p-6">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-3">
          <div class="flex items-center gap-2">
            <span class="inline-flex items-center justify-center w-7 h-7 rounded-full bg-[#064E3B] text-white font-bold text-xs" id="step-number-badge">
              1
            </span>
            <span class="font-serif font-bold text-sm sm:text-base text-[#064E3B]" id="step-title-display">
              Step 1: Reconnect Before You Correct
            </span>
          </div>
          <div class="text-xs font-semibold text-[#0F766E] flex items-center gap-1.5 self-end sm:self-auto">
            <span data-en="Progress:" data-ur="پیش رفت:">Progress:</span>
            <span id="progress-percent" class="font-bold text-sm">20%</span>
          </div>
        </div>

        <!-- Progress Bar Track -->
        <div class="w-full bg-gray-200 h-2.5 rounded-full overflow-hidden">
          <div
            id="wizard-progress-bar"
            class="bg-gradient-to-r from-[#0F766E] to-[#10B981] h-full rounded-full transition-all duration-400 ease-out"
            style="width: 20%;"
          ></div>
        </div>

        <!-- Step Indicator Dots -->
        <div class="flex justify-between items-center mt-3 text-[11px] font-medium text-gray-500 px-1">
          <button type="button" class="step-dot font-bold text-[#064E3B] cursor-pointer" data-step="1">1. Reconnect</button>
          <span class="text-gray-300">•</span>
          <button type="button" class="step-dot cursor-pointer" data-step="2">2. Boundaries</button>
          <span class="text-gray-300">•</span>
          <button type="button" class="step-dot cursor-pointer" data-step="3">3. Responsibility</button>
          <span class="text-gray-300">•</span>
          <button type="button" class="step-dot cursor-pointer" data-step="4">4. Replace Habits</button>
          <span class="text-gray-300">•</span>
          <button type="button" class="step-dot cursor-pointer" data-step="5">5. Accountability</button>
        </div>
      </div>

      <!-- Names & Context Header (Step 0) -->
      <div class="px-6 pt-6 sm:px-8 sm:pt-8 bg-gray-50/70 border-b border-gray-100">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pb-6">
          <div class="space-y-1.5">
            <label for="parentName" class="block text-xs font-bold text-gray-700 uppercase tracking-wider">
              <span data-en="Parent Name" data-ur="والدین کا نام">Parent Name</span>
              <span class="text-red-500">*</span>
            </label>
            <input
              type="text"
              id="parentName"
              class="w-full px-4 py-2.5 rounded-xl border border-gray-300 focus:border-[#0F766E] focus:ring-2 focus:ring-[#0F766E]/20 text-gray-900 placeholder-gray-400 text-sm bg-white shadow-sm"
              placeholder="e.g. Ayesha / Farooq"
            />
          </div>
          <div class="space-y-1.5">
            <label for="teenName" class="block text-xs font-bold text-gray-700 uppercase tracking-wider">
              <span data-en="Teen Name & Age" data-ur="نوجوان بچے کا نام اور عمر">Teen Name & Age</span>
              <span class="text-red-500">*</span>
            </label>
            <input
              type="text"
              id="teenName"
              class="w-full px-4 py-2.5 rounded-xl border border-gray-300 focus:border-[#0F766E] focus:ring-2 focus:ring-[#0F766E]/20 text-gray-900 placeholder-gray-400 text-sm bg-white shadow-sm"
              placeholder="e.g. Zayd (15 years)"
            />
          </div>
        </div>
      </div>

      <!-- Wizard Form Container -->
      <form id="teen-form" class="p-6 sm:p-8 lg:p-10 space-y-8" onsubmit="return false;">

        <!-- STEP 1: Reconnect Before You Correct -->
        <div id="step-panel-1" class="wizard-step-panel space-y-6">
          <div>
            <div class="inline-flex items-center gap-1.5 text-xs font-bold text-[#0F766E] uppercase tracking-wider mb-1">
              <Heart class="w-4 h-4 text-rose-500" />
              <span data-en="Step 1 of 5: Connection First" data-ur="مرحلہ 1 از 5: اصلاح سے پہلے تعلق">Step 1 of 5: Connection First</span>
            </div>
            <h3 class="text-2xl font-serif font-extrabold text-[#064E3B]">
              <span data-en="Reconnect Before You Correct" data-ur="اصلاح اور قانون سازی سے پہلے دلی تعلق بنائیں">Reconnect Before You Correct</span>
            </h3>
            <p class="text-sm text-gray-500 mt-1">
              <span data-en="Adolescents shut down when spoken to only through commands and lectures. Rate your current connection and choose your healing rituals." data-ur="جب نوجوانوں سے صرف احکامات اور نصیحتوں کے ذریعے بات کی جائے تو وہ دیوار کھڑی کر لیتے ہیں۔ تعلق کی موجودہ سطح کا جائزہ لیں اور بحالی کا راستہ چنیں۔">
                Adolescents shut down when spoken to only through commands and lectures. Rate your current connection and choose your healing rituals.
              </span>
            </p>
          </div>

          <!-- Connection Level -->
          <div class="space-y-2">
            <label for="connection" class="block text-sm font-bold text-gray-700">
              <span data-en="How strong is your current emotional connection with your teen?" data-ur="آپ کا اپنے نوجوان بچے کے ساتھ موجودہ جذباتی تعلق کیسا ہے؟">How strong is your current emotional connection with your teen?</span>
            </label>
            <select
