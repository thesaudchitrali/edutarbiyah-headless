      const displayRule = document.getElementById('display-rule-protocol');
      const displayResp = document.getElementById('display-resp-protocol');
      const displayAct = document.getElementById('display-act-protocol');
      const displayCadence = document.getElementById('display-cadence-protocol');

      // Step Titles
      const stepTitlesEn = [
        'Step 1: Reconnect Before You Correct',
        'Step 2: Set Clear Expectations & Boundaries',
        'Step 3: Increase Responsibility Gradually',
        'Step 4: Replace Bad Habits with Positive Engagement',
        'Step 5: Create Growth & Accountability Plan'
      ];

      const stepTitlesUr = [
        'مرحلہ 1: اصلاح اور قانون سازی سے پہلے دلی تعلق بنائیں',
        'مرحلہ 2: واضح خاندانی حدود اور اصول طے کریں',
        'مرحلہ 3: بتدریج ذمہ داری اور خود اعتمادی بڑھائیں',
        'مرحلہ 4: بری عادت کو تعمیری متبادل سے بدلیں',
        'مرحلہ 5: ہفتہ وار جائزہ اور احتساب کا نظام بنائیں'
      ];

      function updateStepView() {
        for (let i = 1; i <= totalSteps; i++) {
          const panel = document.getElementById('step-panel-' + i);
          if (panel) {
            if (i === currentStep) {
              panel.classList.remove('hidden');
            } else {
              panel.classList.add('hidden');
            }
          }
        }

        // Stepper dots
        document.querySelectorAll('.step-dot').forEach((dot) => {
          const s = parseInt(dot.getAttribute('data-step') || '1');
          if (s === currentStep) {
            dot.classList.add('font-bold', 'text-[#064E3B]');
            dot.classList.remove('text-gray-400');
          } else if (s < currentStep) {
            dot.classList.add('text-[#0F766E]');
            dot.classList.remove('text-gray-400', 'font-bold');
          } else {
            dot.classList.remove('font-bold', 'text-[#064E3B]', 'text-[#0F766E]');
            dot.classList.add('text-gray-400');
          }
        });

        // Badge & Title
        if (stepBadge) stepBadge.textContent = currentStep;
        if (stepTitleDisplay) {
          stepTitleDisplay.textContent = currentLang === 'ur'
            ? stepTitlesUr[currentStep - 1]
            : stepTitlesEn[currentStep - 1];
        }

        // Progress Percent
        const percent = Math.round((currentStep / totalSteps) * 100);
        if (progressBar) progressBar.style.width = percent + '%';
        if (progressPercent) progressPercent.textContent = percent + '%';

        // Prev / Next Buttons
        if (currentStep === 1) {
          if (prevBtn) prevBtn.classList.add('hidden');
        } else {
          if (prevBtn) prevBtn.classList.remove('hidden');
        }

        if (currentStep === totalSteps) {
          if (nextBtnText) {
            nextBtnText.textContent = currentLang === 'ur' ? 'مکمل معاہدہ دیکھیں' : 'View Full Protocol';
          }
        } else {
          if (nextBtnText) {
            nextBtnText.textContent = currentLang === 'ur' ? 'اگلا مرحلہ' : 'Next Step';
          }
        }

        updatePlanCalculations();
      }

      function updatePlanCalculations() {
        const pName = parentNameInput?.value.trim() || (currentLang === 'ur' ? 'والدین' : 'Parent');
        const tName = teenNameInput?.value.trim() || (currentLang === 'ur' ? 'نوجوان بچہ' : 'Teen');
        
        if (displayParentName) displayParentName.textContent = pName;
        if (displayTeenName) displayTeenName.textContent = tName;

        const conn = Number(connectionSelect?.value || 3);
        const bound = Number(boundariesSelect?.value || 3);
        const resp = Number(responsibilitySelect?.value || 3);
        const hab = Number(habitsSelect?.value || 3);
        const acc = Number(accountabilitySelect?.value || 3);

        const total = conn + bound + resp + hab + acc;
        const percent = Math.round((total / 25) * 100);

        if (planScoreBadge) planScoreBadge.textContent = percent + '%';

        let levelEn = '';
        let levelUr = '';
        let adviceEn = '';
        let adviceUr = '';

        if (percent <= 40) {
          levelEn = 'Critical Stage (Reconnection Priority)';
          levelUr = 'نازک مرحلہ (صرف دلی تعلق کی بحالی پر توجہ)';
          adviceEn = 'Start with connection ONLY. Avoid strict control or punitive lectures. Spend the next 7 days purely rebuilding emotional safety.';
          adviceUr = 'سختی یا سزاؤں سے بالکل پرہیز کریں۔ اگلے 7 دن صرف اور صرف دلی قربت، محبت اور غیر مشروط توجہ کے لیے وقف کریں۔';
        } else if (percent <= 65) {
          levelEn = 'Needs Structured Support';
          levelUr = 'درمیانی مرحلہ (منظم اور پرسکون رہنمائی کی ضرورت)';
          adviceEn = 'Connection is steadying. Now introduce ONE clear, predictable boundary and assign one small tangible household responsibility.';
          adviceUr = 'تعلق بہتر ہو رہا ہے۔ اب ایک دوٹوک خاندانی اصول طے کریں اور ایک چھوٹی ذمہ داری سونپیں۔';
        } else if (percent <= 85) {
          levelEn = 'Positive Recovery Stage';
          levelUr = 'مثبت بحالی کا مرحلہ (کامیاب تسلسل)';
          adviceEn = 'Consistency is winning. Maintain daily warm connection, deepen positive activity outlets, and keep a calm weekly accountability check.';
          adviceUr = 'تسلسل کے شاندار نتائج آ رہے ہیں۔ روزمرہ محبت، مثبت کھیل/ہنر اور ہفتہ وار جائزے کا معمول برقرار رکھیں۔';
        } else {
          levelEn = 'Strong Prophetic Foundation';
          levelUr = 'مضبوط نبوی بنیاد (بہترین باہمی اعتماد)';
          adviceEn = 'High mutual trust established. Empower your teen with real leadership roles, Islamic mentorship, and life skill responsibilities.';
          adviceUr = 'باہمی اعتماد قائم ہو چکا ہے۔ نوجوان کو خود مختاری، اسلامی رہنمائی اور خاندانی قیادت کے مواقع دیں۔';
        }

        if (planLevelDisplay) {
          planLevelDisplay.textContent = currentLang === 'ur' ? levelUr : levelEn;
        }

        if (planSummaryAdvice) {
          planSummaryAdvice.textContent = currentLang === 'ur' ? adviceUr : adviceEn;
        }

        // Selected reconnect checks
        const activeChecks = [];
        document.querySelectorAll('.recon-check:checked').forEach((c) => {
          const txt = c.closest('label')?.querySelector('span')?.textContent.trim();
          if (txt) activeChecks.push(txt);
        });
        if (displayReconnect) {
          displayReconnect.textContent = activeChecks.length > 0 
            ? activeChecks.slice(0, 2).join(' + ') + (activeChecks.length > 2 ? ` (+${activeChecks.length - 2} more)` : '')
            : (currentLang === 'ur' ? '15 منٹ روزانہ دوستانہ بات چیت' : '15 min daily non-judgmental talk');
        }

        // Family Rule
        const ruleVal = familyRuleInput?.value.trim();
        if (displayRule) {
          displayRule.textContent = ruleVal || (currentLang === 'ur' ? '[ایک دوٹوک اور سادہ اصول طے کریں]' : '[Set one simple family rule]');
        }

        // Responsibility
        const respVal = weeklyRespInput?.value.trim();
        if (displayResp) {
          displayResp.textContent = respVal || (currentLang === 'ur' ? '[ایک چھوٹی عملی ذمہ داری سونپیں]' : '[Assign one small weekly responsibility]');
        }

        // Positive Activity
        const actVal = positiveActivityInput?.value.trim();
        if (displayAct) {
          displayAct.textContent = actVal || (currentLang === 'ur' ? '[ایک صحت مند متبادل سرگرمی]' : '[Choose one positive replacement activity]');
        }

        // Cadence
        const accOption = accountabilitySelect?.options[accountabilitySelect.selectedIndex]?.text || '';
        if (displayCadence) {
          displayCadence.textContent = accOption 
            ? accOption.replace(/^\d+\s*-\s*/, '')
            : (currentLang === 'ur' ? 'ہفتہ وار اتوار کو پرسکون جائزہ' : 'Weekly calm Sunday review');
        }
      }

      // Next / Prev Button Listeners
      if (nextBtn) {
        nextBtn.addEventListener('click', () => {
          if (currentStep < totalSteps) {
            currentStep++;
            updateStepView();
            saveToStorage();
            document.getElementById('wizard-stepper')?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
          } else {
            document.getElementById('printable-teen-plan')?.scrollIntoView({ behavior: 'smooth' });
          }
        });
      }

      if (prevBtn) {
        prevBtn.addEventListener('click', () => {
          if (currentStep > 1) {
            currentStep--;
            updateStepView();
          }
        });
      }

      // Stepper dot click
      document.querySelectorAll('.step-dot').forEach((dot) => {
        dot.addEventListener('click', () => {
          const s = parseInt(dot.getAttribute('data-step') || '1');
          currentStep = s;
          updateStepView();
        });
      });

      // Presets Handler
      document.querySelectorAll('.preset-card').forEach((card) => {
        card.addEventListener('click', () => {
          const isUr = currentLang === 'ur';
          const conn = card.getAttribute('data-connection');
          const bound = card.getAttribute('data-boundaries');
          const resp = card.getAttribute('data-responsibility');
          const hab = card.getAttribute('data-habits');
          const acc = card.getAttribute('data-accountability');
          const rule = isUr ? card.getAttribute('data-rule-ur') : card.getAttribute('data-rule-en');
          const weeklyResp = isUr ? card.getAttribute('data-resp-ur') : card.getAttribute('data-resp-en');
          const act = isUr ? card.getAttribute('data-act-ur') : card.getAttribute('data-act-en');

          if (connectionSelect && conn) connectionSelect.value = conn;
          if (boundariesSelect && bound) boundariesSelect.value = bound;
          if (responsibilitySelect && resp) responsibilitySelect.value = resp;
          if (habitsSelect && hab) habitsSelect.value = hab;
          if (accountabilitySelect && acc) accountabilitySelect.value = acc;
          if (familyRuleInput && rule) familyRuleInput.value = rule;
          if (weeklyRespInput && weeklyResp) weeklyRespInput.value = weeklyResp;
          if (positiveActivityInput && act) positiveActivityInput.value = act;

          updatePlanCalculations();
          saveToStorage();

          currentStep = 2;
          updateStepView();
          document.getElementById('wizard-stepper')?.scrollIntoView({ behavior: 'smooth' });
        });
      });

      // Realtime input listeners
      [
        parentNameInput, teenNameInput, connectionSelect, boundariesSelect,
        familyRuleInput, responsibilitySelect, weeklyRespInput, habitsSelect,
        positiveActivityInput, accountabilitySelect, notesTextarea
      ].forEach((el) => {
        if (el) {
          el.addEventListener('input', () => {
            updatePlanCalculations();
            saveToStorage();
          });
        }
      });

      document.querySelectorAll('.recon-check').forEach((cb) => {
        cb.addEventListener('change', () => {
          updatePlanCalculations();
          saveToStorage();
        });
      });

      // Storage Save/Load
      function saveToStorage() {
        try {
          const checks = [];
          document.querySelectorAll('.recon-check').forEach((c) => checks.push(c.checked));

          const data = {
            parentName: parentNameInput?.value || '',
            teenName: teenNameInput?.value || '',
            connection: connectionSelect?.value || '3',
            boundaries: boundariesSelect?.value || '3',
            familyRule: familyRuleInput?.value || '',
            responsibility: responsibilitySelect?.value || '3',
            weeklyResponsibility: weeklyRespInput?.value || '',
            habits: habitsSelect?.value || '3',
            positiveActivity: positiveActivityInput?.value || '',
            accountability: accountabilitySelect?.value || '3',
            notes: notesTextarea?.value || '',
            checks,
            currentStep,
            currentLang
          };
          localStorage.setItem(STORAGE_KEY, JSON.stringify(data));
        } catch (e) {}
      }

      function loadFromStorage() {
        try {
          const raw = localStorage.getItem(STORAGE_KEY);
          if (!raw) return;
          const data = JSON.parse(raw);

          if (parentNameInput && data.parentName) parentNameInput.value = data.parentName;
          if (teenNameInput && data.teenName) teenNameInput.value = data.teenName;
          if (connectionSelect && data.connection) connectionSelect.value = data.connection;
          if (boundariesSelect && data.boundaries) boundariesSelect.value = data.boundaries;
          if (familyRuleInput && data.familyRule) familyRuleInput.value = data.familyRule;
          if (responsibilitySelect && data.responsibility) responsibilitySelect.value = data.responsibility;
          if (weeklyRespInput && data.weeklyResponsibility) weeklyRespInput.value = data.weeklyResponsibility;
          if (habitsSelect && data.habits) habitsSelect.value = data.habits;
          if (positiveActivityInput && data.positiveActivity) positiveActivityInput.value = data.positiveActivity;
          if (accountabilitySelect && data.accountability) accountabilitySelect.value = data.accountability;
          if (notesTextarea && data.notes) notesTextarea.value = data.notes;

          if (Array.isArray(data.checks)) {
            const boxes = document.querySelectorAll('.recon-check');
            data.checks.forEach((val, i) => {
              if (boxes[i]) boxes[i].checked = !!val;
            });
          }

          if (data.currentLang) {
            setLanguage(data.currentLang);
          }

          if (data.currentStep && data.currentStep >= 1 && data.currentStep <= totalSteps) {
            currentStep = data.currentStep;
          }

          updateStepView();
        } catch (e) {}
      }

      // Manual Save Button
      const saveBtn = document.getElementById('save-local-btn');
      if (saveBtn) {
        saveBtn.addEventListener('click', () => {
          saveToStorage();
          const orig = saveBtn.innerHTML;
          saveBtn.innerHTML = `<span class="font-bold">${currentLang === 'ur' ? 'محفوظ ہو گیا!' : 'Saved!'}</span>`;
          setTimeout(() => {
            saveBtn.innerHTML = orig;
          }, 2000);
        });
      }

      // Reset Form Button
      const clearBtn = document.getElementById('clear-form-btn');
      if (clearBtn) {
        clearBtn.addEventListener('click', () => {
          if (confirm(currentLang === 'ur' ? 'کیا آپ تمام ڈیٹا صاف کرنا چاہتے ہیں؟' : 'Are you sure you want to reset this teen plan?')) {
            localStorage.removeItem(STORAGE_KEY);
            location.reload();
          }
        });
      }

      // Print Button
      const printBtn = document.getElementById('print-plan-btn');
      if (printBtn) {
        printBtn.addEventListener('click', () => {
          window.print();
        });
      }

      // WhatsApp Button
      const waBtn = document.getElementById('whatsapp-plan-btn');
      if (waBtn) {
        waBtn.addEventListener('click', () => {
          const pName = parentNameInput?.value.trim() || 'Parent';
          const tName = teenNameInput?.value.trim() || 'My Teen';
          const rule = familyRuleInput?.value.trim() || 'Clear rule';
          const resp = weeklyRespInput?.value.trim() || 'Assigned responsibility';
          const act = positiveActivityInput?.value.trim() || 'Healthy activity';
          const score = planScoreBadge?.textContent || '0%';
          const level = planLevelDisplay?.textContent || '';
          const notes = notesTextarea?.value.trim() || 'None';

          const text = 
`Assalam u Alaikum EduTarbiyah Team,
I have completed the Reconnect & Guide Teen Plan:

• Parent: ${pName}
• Teen: ${tName}
• Diagnostic Score: ${score} (${level})

• Core Family Rule: ${rule}
• Weekly Responsibility: ${resp}
• Positive Replacement Activity: ${act}
• Notes / Friction Areas: ${notes}

I am looking for expert coaching feedback on how to de-escalate tension and successfully implement this protocol with my teen. JazakAllah Khair!`;

          const cleanPhone = (WHATSAPP_NUMBER || '923122370720').replace(/[^0-9]/g, '');
          const waUrl = `https://wa.me/${cleanPhone}?text=${encodeURIComponent(text)}`;
          window.open(waUrl, '_blank');
        });
      }

      // Copy Button
      const copyBtn = document.getElementById('copy-plan-btn');
      const copyTextEl = document.getElementById('copy-btn-text');
      if (copyBtn) {
        copyBtn.addEventListener('click', () => {
          const pName = parentNameInput?.value.trim() || 'Parent';
          const tName = teenNameInput?.value.trim() || 'Teen';
          const rule = familyRuleInput?.value.trim() || '[Rule]';
          const resp = weeklyRespInput?.value.trim() || '[Responsibility]';
          const act = positiveActivityInput?.value.trim() || '[Activity]';

          const text = `Teen Reconnect & Growth Protocol
Parent: ${pName} | Teen: ${tName}
1. Reconnect: Daily 15 min non-judgmental quality time
2. Family Rule: ${rule}
3. Responsibility: ${resp}
4. Replacement: ${act}
(Generated at EduTarbiyah.com)`;

          navigator.clipboard.writeText(text).then(() => {
            if (copyTextEl) copyTextEl.textContent = currentLang === 'ur' ? 'کاپی ہو گیا!' : 'Copied!';
            setTimeout(() => {
              if (copyTextEl) copyTextEl.textContent = currentLang === 'ur' ? 'کاپی' : 'Copy';
            }, 2000);
          });
        });
      }

      // Bilingual Switching Logic
      function setLanguage(lang) {
        currentLang = lang;
        const isUr = lang === 'ur';

        if (langToggleText) {
          langToggleText.textContent = isUr ? 'View in English' : 'اردو میں دیکھیں';
        }

        document.documentElement.dir = isUr ? 'rtl' : 'ltr';
        document.documentElement.lang = isUr ? 'ur' : 'en';

        // Translate data-en and data-ur text nodes
        document.querySelectorAll('[data-en][data-ur]').forEach((el) => {
          const txt = isUr ? el.getAttribute('data-ur') : el.getAttribute('data-en');
          if (txt) el.textContent = txt;
        });

        // Translate Placeholders
        if (parentNameInput) parentNameInput.placeholder = isUr ? 'مثلاً عائشہ / فاروق' : 'e.g. Ayesha / Farooq';
        if (teenNameInput) teenNameInput.placeholder = isUr ? 'مثلاً زید (15 سال)' : 'e.g. Zayd (15 years)';
        if (familyRuleInput) familyRuleInput.placeholder = isUr ? 'مثلاً ہوم ورک اور مغرب کے بعد صرف 1 گھنٹہ اسکرین' : 'Example: Mobile will be used for 1 hour after homework only.';
        if (weeklyRespInput) weeklyRespInput.placeholder = isUr ? 'مثلاً کمرہ صاف رکھنا، گروسری میں مدد' : 'Example: Keep room clean / help in kitchen & groceries';
        if (positiveActivityInput) positiveActivityInput.placeholder = isUr ? 'مثلاً مارشل آرٹس، کوئی ہنر سیکھنا، فیملی پروجیکٹ' : 'Example: Sports / gym, skill learning, Quran circle';
        if (notesTextarea) notesTextarea.placeholder = isUr ? 'اس ہفتے کیا بہتری آئی؟ کہاں مشکل پیش آئی؟' : 'What improved this week? What caused friction?';

        updateStepView();
        saveToStorage();
      }

      if (langToggleBtn) {
        langToggleBtn.addEventListener('click', () => {
          const next = currentLang === 'en' ? 'ur' : 'en';
          setLanguage(next);
        });
      }

      // Initial Setup
      loadFromStorage();
      updateStepView();
    })();
  </script>

</Layout>
