---
import Layout from '../../layouts/Layout.astro';
import ProductCard from '../../components/ProductCard.astro';
import { getAllProductCategories, getAllProducts, type ProductCategory, type Product } from '../../lib/api';
import { ChevronRight, Home, BookOpen, ArrowLeft } from 'lucide-astro';

export async function getStaticPaths() {
  const categories = await getAllProductCategories();
  const allProducts = await getAllProducts();

  return categories.map((category) => {
    const categoryProducts = allProducts.filter((product) =>
      product.categories?.some((c) => c.id === category.id || c.slug === category.slug)
    );

    return {
      params: { slug: category.slug },
      props: { category, products: categoryProducts, allCategories: categories },
    };
  });
}

interface Props {
  category: ProductCategory;
  products: Product[];
  allCategories: ProductCategory[];
}

const { category, products, allCategories } = Astro.props;
---

<Layout
  title={`${category.name} | EduTarbiyah Bookstore`}
  description={`Browse ${category.name} publications and guides from EduTarbiyah. Cash on delivery available across Pakistan.`}
>
  <!-- Category Header Hero -->
  <section class="bg-gradient-to-b from-[#F4F8F6] via-[#FFFDF9] to-[#FFFDF9] py-10 lg:py-14 border-b border-gray-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-xs text-gray-500 font-medium mb-4" aria-label="Breadcrumb">
        <a href="/" class="hover:text-[#0F766E] transition-colors flex items-center gap-1">
          <Home class="w-3.5 h-3.5" />
          <span>Home</span>
        </a>
        <ChevronRight class="w-3.5 h-3.5 text-gray-400" />
        <a href="/shop/" class="hover:text-[#0F766E] transition-colors">
          Bookstore
        </a>
        <ChevronRight class="w-3.5 h-3.5 text-gray-400" />
        <span class="text-[#064E3B] font-semibold">{category.name}</span>
      </nav>

      <div class="max-w-3xl space-y-3">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#0F766E]/10 border border-[#0F766E]/20 text-[#0F766E] text-xs font-semibold">
          <BookOpen class="w-3.5 h-3.5 text-[#F59E0B]" />
          <span>Category Catalog</span>
        </div>

        <h1 class="text-3xl sm:text-4xl font-serif font-extrabold text-[#064E3B] tracking-tight">
          {category.name}
        </h1>

        {category.description ? (
          <p class="text-sm sm:text-base text-gray-600 leading-relaxed">
            {category.description}
          </p>
        ) : (
          <p class="text-sm text-gray-600">
            Showing {products.length} {products.length === 1 ? 'publication' : 'publications'} in this collection.
          </p>
        )}
      </div>

      <!-- Sibling Category Pills -->
      <div class="pt-6 flex flex-wrap items-center gap-2">
        <a
          href="/shop/"
          class="px-3.5 py-1.5 rounded-xl text-xs font-semibold bg-white border border-gray-200 text-gray-600 hover:border-[#0F766E] transition-all"
        >
          All Items
        </a>
        {allCategories.map((c) => (
          <a
            href={`/product-category/${c.slug}/`}
            class={`px-3.5 py-1.5 rounded-xl text-xs font-semibold transition-all ${
              c.slug === category.slug
                ? 'bg-[#0F766E] text-white shadow-sm'
                : 'bg-white border border-gray-200 text-gray-600 hover:border-[#0F766E]'
            }`}
          >
            {c.name} ({c.count})
          </a>
        ))}
      </div>

    </div>
  </section>

  <!-- Products Listing -->
  <section class="py-14 bg-[#FFFDF9]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      {products.length > 0 ? (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {products.map((p) => (
            <ProductCard product={p} />
          ))}
        </div>
      ) : (
        <div class="text-center py-16 bg-white rounded-3xl border border-gray-100 max-w-md mx-auto p-8 space-y-4">
          <p class="text-sm text-gray-600">No products currently listed in this category.</p>
          <a
            href="/shop/"
            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-[#0F766E] text-white text-xs font-bold"
          >
            <ArrowLeft class="w-4 h-4" />
            <span>Return to All Books</span>
          </a>
        </div>
      )}
    </div>
  </section>
</Layout>
