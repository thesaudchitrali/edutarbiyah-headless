---
import Layout from '../layouts/Layout.astro';
import { WHATSAPP_NUMBER } from '../lib/api';
import { 
  Users, 
  Video, 
  Calendar, 
  Clock, 
  Sparkles, 
  CheckCircle2, 
  AlertCircle, 
  ArrowRight, 
  MessageCircle, 
  BookOpen, 
  GraduationCap, 
  ChevronRight, 
  ChevronDown, 
  ShieldCheck, 
  FileText, 
  Award,
  HeartHandshake,
  Compass,
  Check,
  Star,
  Zap,
  HelpCircle,
  Laptop,
  X
} from 'lucide-astro';

const COURSE_FEE = "PKR 15,000";
const COURSE_NAME = "TPPC • Live & Interactive Parenting Course";

const defaultWhatsappMessage = encodeURIComponent(
  "Assalamu Alaikum, I want to enroll in the TPPC Live & Interactive Course (PKR 15,000). Please share upcoming cohort schedule and registration details."
);
const whatsappEnrollUrl = `https://wa.me/${WHATSAPP_NUMBER}?text=${defaultWhatsappMessage}`;

// 8 Core Learning Areas
const coreAreas = [
  {
    icon: Compass,
    title: "Quran, Sunnah & Seerah Principles",
    desc: "Uncover how the Prophet ﷺ nurtured the youth, disciplined with immense mercy, and built enduring character."
  },
  {
    icon: Laptop,
    title: "Modern Educational Psychology & NLP",
    desc: "Science-backed techniques in cognitive reframing, language patterns, and emotional neuro-development."
  },
  {
    icon: Users,
    title: "Personality Profiling with MBTI",
    desc: "Discover each child's innate temperament and cognitive functions to avoid forcing one-size-fits-all expectations."
  },
  {
    icon: HeartHandshake,
    title: "Emotional Intelligence & Self-Regulation",
    desc: "Master parental anger management, identify your emotional triggers, and co-regulate your child's feelings."
  },
  {
    icon: ShieldCheck,
    title: "Positive Discipline Frameworks",
    desc: "Say goodbye to shouting and humiliation. Replace punishment with firm, loving, natural consequences."
  },
  {
    icon: Star,
    title: "Family & Marriage Synchronization",
    desc: "Align both parents on consistent discipline, conflict resolution, and nurturing a tranquil household."
  },
  {
    icon: FileText,
    title: "Practical Worksheets & Strategies",
    desc: "Take-home habit trackers, family vision templates, screen agreements, and behavioral rubrics."
  },
  {
    icon: Zap,
    title: "Digital Age & Social Media Parenting",
    desc: "Manage smartphones, gaming addictions, and online safety with respectful boundaries that last."
  }
];

// Why Live Course vs YouTube
const comparisonPoints = [
  {
    feature: "Learning Structure",
    youtube: "Scattered, random tips with no clear beginning or end",
    tppc: "Sequential step-by-step 2-month curriculum that builds transformation"
  },
  {
    feature: "Depth of Guidance",
    youtube: "Surface-level advice that ignores your unique family situation",
    tppc: "Complete holistic framework integrating Islamic values & psychology"
  },
  {
    feature: "Implementation Tools",
    youtube: "Zero worksheets, action charts, or practical diagnostic tools",
    tppc: "Downloadable diagnostic workbooks, habit trackers, and templates"
  },
  {
    feature: "Direct Instructor Access",
    youtube: "One-way broadcast with nobody to answer your pressing questions",
    tppc: "Live interactive Q&A directly with Dr. Mufti Muhammad Younus Khalid"
  },
  {
    feature: "Real Practice & Case Studies",
    youtube: "Theoretical ideas that fade away within 24 hours",
    tppc: "Guided real-life case studies, scenario role-plays, and feedback"
  },
  {
    feature: "Accountability & Recognition",
    youtube: "No peer cohort, no accountability, and no certification",
    tppc: "Live supportive parent cohort & official Practitioner Certification"
  }
];

// 10 Comprehensive Pillars
const pillars = [
  {
    number: "01",
    title: "Foundations of Parenting & Tarbiyah",
    desc: "The true spiritual purpose of parenting, establishing intentional goals, and moving from survival to proactive vision."
  },
  {
    number: "02",
    title: "Quranic & Prophetic Way of Parenting",
    desc: "Timeless pedagogy of Rasulullah ﷺ with youth: building self-esteem, compassionate correction, and unconditional love."
  },
  {
    number: "03",
    title: "Discover Your Child's Personality with MBTI",
    desc: "Understanding introversion vs extroversion, emotional processing, and tailoring guidance to your child's unique nature."
  },
  {
    number: "04",
    title: "Prepare Yourself Before Parenting",
    desc: "Parental self-reflection, breaking unhealed generational trauma cycles, and mastering emotional composure under pressure."
  },
  {
    number: "05",
    title: "Practical Parenting Framework",
    desc: "A systematic 5-tier architecture connecting faith, physical habits, emotional safety, and intellectual curiosity."
  },
  {
    number: "06",
    title: "Positive Parenting Skills in Action",
    desc: "Speaking so children actually listen, de-escalating defiance without threats, and encouraging voluntary cooperation."
  },
  {
    number: "07",
    title: "Happy Marriage & Healthy Family Dynamics",
    desc: "Resolving parental disagreements over discipline in private, supporting each other, and fostering sibling harmony."
  },
  {
    number: "08",
    title: "Digital Parenting in the Modern Era",
    desc: "Managing screen time, gaming, social media, internet safety, and replacing virtual addiction with rewarding real-world activities."
  },
  {
    number: "09",
    title: "Practical Tools, Techniques & Routines",
    desc: "Designing workable daily routines: Salah habits, homework focus, bedroom order, and peaceful bedtime traditions."
  },
  {
    number: "10",
    title: "Live Coaching & Interactive Case Studies",
    desc: "Real-world participant case breakdowns, live Q&A hot seats, personalized coaching advice, and cohort peer support."
  }
];

// 10 Key Transformations
const transformations = [
  "Understand your child deeply beneath surface tantrums and resistance",
  "Build stronger, warmer, more joyful family relationships that last",
  "Raise children with genuine internal confidence, self-worth, and resilience",
  "Drastically reduce daily screaming, arguments, and emotionally exhausting power struggles",
  "Handle behavioral problems with calm wisdom instead of impulsive anger",
  "Develop deep, voluntary Islamic character (Akhlaq) and love for Salah",
  "Build positive, sustainable habits in your children—and in yourself",
  "Deal with digital challenges, gaming, and smartphone limits without constant battles",
  "Create a peaceful, emotionally safe, and spiritually enriched home atmosphere",
  "Become a confident, competent parent guided by a clear, lifelong practical roadmap"
];

// Modern Parenting Challenges
const modernProblems = [
  { title: "Mobile & Screen Addiction", desc: "Constant friction over device limits, gaming, and online influences." },
  { title: "Children Not Listening", desc: "Repeating instructions 10 times until shouting becomes the only reaction." },
  { title: "Anger & Emotional Outbursts", desc: "Explosive reactions from children—and reactive guilt from parents." },
  { title: "Weak Salah & Islamic Identity", desc: "Struggling to make prayer, modesty, and Islamic values beloved to children." },
  { title: "Low Self-Confidence", desc: "Fear of failure, social anxiety, or comparing themselves unfavorably to peers." },
  { title: "Stubbornness & Behavior Battles", desc: "Defiance over daily basic routines like food, homework, and sleep." },
  { title: "Lack of Consistent Discipline", desc: "Fluctuating between overly permissive laxity and harsh strictness." },
  { title: "Marital Co-Parenting Strain", desc: "Parents disagreeing on rules in front of the kids, undermining authority." },
  { title: "Communication Breakdown", desc: "Children withdrawing, becoming defensive, or hiding things as they grow older." },
  { title: "Digital Age Distractions", desc: "Information overload leaving modern parents feeling anxious, confused, and overwhelmed." }
];

// FAQs
const faqs = [
  {
    q: "What is the schedule and format of the live sessions?",
    a: "The course spans 2 months with 1 live session per week (approx. 2 hours per session, total 16 hours). Sessions are held live on Zoom with interactive Q&A. If you ever miss a live class, high-definition recordings are provided so you never fall behind."
  },
  {
    q: "Who is the instructor for this live cohort?",
    a: "All 16 hours of live sessions are conducted directly by Dr. Mufti Muhammad Younus Khalid (Ph.D., Islamic Scholar, Author, NLP & MBTI Practitioner)."
  },
  {
    q: "Can both mother and father attend using the same enrollment?",
    a: "Yes! We strongly encourage husband and wife to join together from the same screen so both parents develop unified discipline and shared Tarbiyah goals."
  },
  {
    q: "What is the subsidized fee and how do I register?",
    a: "The fee is PKR 15,000 for the full 2-month interactive practitioner training. You can pay via EasyPaisa, JazzCash, or Direct Bank Transfer. Click 'Enroll on WhatsApp' to register and receive payment details instantly."
  },
  {
    q: "Do I get a practitioner certificate at the end?",
    a: "Yes, upon completing the course sessions and assignments, you receive the official verified 'Tarbiyah Parenting Practitioner' Certificate of Completion from EduTarbiyah Institute."
  }
];
---

<Layout
  title="TPPC Live & Interactive Parenting Course | EduTarbiyah Institute"
  description="Transform your home with the 2-Month Live & Interactive Tarbiyah Parenting Practitioner Course by Dr. Mufti Muhammad Younus Khalid. 16 hours of live coaching, Q&A, and certification."
>

  <!-- Breadcrumbs Bar -->
  <div class="bg-[#F8FFFC] border-b border-[#0F766E]/10 py-3 px-4 sm:px-6 text-xs text-gray-500">
    <div class="max-w-7xl mx-auto flex items-center justify-between">
      <div class="flex items-center gap-2">
        <a href="/" class="hover:text-[#0F766E] transition-colors">Home</a>
        <ChevronRight class="w-3.5 h-3.5 text-gray-400" />
        <a href="/shop/" class="hover:text-[#0F766E] transition-colors">Programs</a>
        <ChevronRight class="w-3.5 h-3.5 text-gray-400" />
        <span class="text-[#064E3B] font-semibold">TPPC Live & Interactive</span>
      </div>
      <div class="hidden sm:flex items-center gap-2 text-[#064E3B] font-medium">
        <span class="inline-block w-2 h-2 rounded-full bg-[#10B981] animate-pulse"></span>
        <span>Limited Cohort Seats • Live on Zoom</span>
      </div>
    </div>
  </div>

  <!-- Hero Section -->
  <section class="relative bg-gradient-to-b from-[#064E3B] via-[#095944] to-[#064E3B] text-white py-16 lg:py-24 overflow-hidden">
    <div class="absolute inset-0 opacity-10 bg-[radial-gradient(#F59E0B_1px,transparent_1px)] [background-size:24px_24px] pointer-events-none"></div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        
        <!-- Left Content -->
        <div class="lg:col-span-7 space-y-6 text-center lg:text-left">
          
          <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white/10 text-[#F59E0B] text-xs font-bold tracking-wide uppercase backdrop-blur-md border border-white/15">
            <span class="inline-block w-2 h-2 rounded-full bg-[#F59E0B] animate-ping"></span>
            <span>Live & Interactive Parenting Course • 2-Month Cohort</span>
          </div>

          <h1 class="text-3xl sm:text-5xl lg:text-6xl font-serif font-extrabold text-white tracking-tight leading-[1.15]">
            Tarbiyah Parenting <br class="hidden sm:inline" />
            <span class="text-[#F59E0B] italic font-normal">Practitioner Course</span>
          </h1>

          <p class="text-xl sm:text-2xl font-serif text-[#D1FAE5] leading-snug">
            Raise Righteous, Confident & Emotionally Healthy Children Without Constant Anger, Confusion or Daily Parenting Struggles.
          </p>

          <p class="text-sm sm:text-base text-[#D1FAE5]/90 max-w-2xl leading-relaxed">
            From Reactive Parenting To Proactive & Meaningful Islamic Tarbiyah. Learn a complete parenting system that combines Quranic guidance, modern psychology, NLP, and practical parenting tools.
          </p>

          <div class="p-3 bg-white/10 rounded-xl border border-white/10 inline-block text-xs sm:text-sm text-[#F59E0B] font-semibold">
            Designed for: Parents, Teachers, Newlyweds, Mentors & Islamic Educators
          </div>

          <!-- Specs Badges -->
          <div class="flex flex-wrap items-center justify-center lg:justify-start gap-3 pt-2 text-xs sm:text-sm font-medium text-white/95">
            <span class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl bg-white/10 border border-white/10">
              <Clock class="w-4 h-4 text-[#F59E0B]" />
              <span>16 Hours Live Sessions</span>
            </span>
            <span class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl bg-white/10 border border-white/10">
              <Calendar class="w-4 h-4 text-[#F59E0B]" />
              <span>2 Months Duration</span>
            </span>
            <span class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl bg-white/10 border border-white/10">
              <Video class="w-4 h-4 text-[#F59E0B]" />
              <span>1 Session / Week (2 Hours)</span>
            </span>
            <span class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl bg-white/10 border border-white/10">
              <Award class="w-4 h-4 text-[#F59E0B]" />
              <span>Official Certification</span>
            </span>
          </div>

          <!-- CTA Buttons -->
          <div class="pt-4 flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4">
            <a
              href={whatsappEnrollUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="w-full sm:w-auto inline-flex items-center justify-center gap-3 px-8 py-4 rounded-2xl bg-[#25D366] hover:bg-[#20bd5a] text-white text-base font-bold shadow-2xl hover:scale-105 active:scale-95 transition-all duration-200"
            >
              <MessageCircle class="w-6 h-6 fill-current" />
              <span>Enroll on WhatsApp — {COURSE_FEE}</span>
            </a>

            <a
              href="#curriculum"
              class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-7 py-4 rounded-2xl bg-white/10 hover:bg-white/20 text-white text-base font-bold border border-white/20 backdrop-blur-sm transition-all"
            >
              <BookOpen class="w-5 h-5 text-[#F59E0B]" />
              <span>View Full Syllabus</span>
            </a>
          </div>

          <p class="text-xs text-[#D1FAE5]/70 pt-1">
            * Subsidized Fee • Limited Seats Per Cohort to Ensure Personal Attention
          </p>

        </div>

        <!-- Right Column: Visual Box & Trainer Highlights -->
        <div class="lg:col-span-5">
          <div class="bg-white/95 backdrop-blur-md rounded-3xl p-6 sm:p-8 shadow-2xl border border-white/20 text-gray-800 space-y-6">
            
            <!-- Trainer Profile Card -->
            <div class="flex items-center gap-4 pb-5 border-b border-gray-100">
              <img
                src="/images/dr-younus-khalid.webp"
                alt="Dr. Mufti Muhammad Younus Khalid"
                class="w-20 h-20 rounded-2xl object-cover object-top shadow-md border-2 border-[#0F766E]/20"
                loading="eager"
                width="80"
                height="80"
              />
              <div>
                <span class="text-xs font-bold text-[#0F766E] uppercase tracking-wider">Live Course Leader</span>
                <h2 class="text-lg font-serif font-bold text-[#064E3B]">Dr. Mufti M. Younus Khalid</h2>
                <p class="text-xs text-gray-500">Ph.D. • Islamic Scholar • Parenting Expert</p>
              </div>
            </div>

            <!-- Program Summary Box -->
            <div class="bg-[#FFFDF9] rounded-2xl p-5 border border-[#0F766E]/20 space-y-3">
              <div class="flex items-center justify-between">
                <div>
                  <span class="text-xs uppercase font-bold text-gray-400 tracking-wider">Subsidized Cohort Fee</span>
                  <div class="text-3xl font-black text-[#064E3B]">{COURSE_FEE}</div>
                </div>
                <div class="text-right">
                  <span class="inline-flex items-center gap-1 text-xs font-bold text-amber-800 bg-amber-50 px-2.5 py-1 rounded-full border border-amber-200">
                    <Users class="w-3.5 h-3.5 text-[#F59E0B]" />
                    <span>Live Interactive Cohort</span>
                  </span>
                  <div class="text-[11px] text-gray-400 mt-1">2 Full Months</div>
                </div>
              </div>

              <div class="space-y-2 pt-2 border-t border-gray-100 text-xs text-gray-600">
                <div class="flex items-center justify-between">
                  <span>Class Format</span>
                  <span class="font-bold text-gray-900">Live Zoom + Q&A + Recordings</span>
                </div>
                <div class="flex items-center justify-between">
                  <span>Session Frequency</span>
                  <span class="font-bold text-gray-900">1 Class Weekly (2 Hours)</span>
                </div>
                <div class="flex items-center justify-between">
                  <span>Total Training</span>
                  <span class="font-bold text-gray-900">16 In-Depth Hours</span>
                </div>
                <div class="flex items-center justify-between">
                  <span>Interactive Support</span>
                  <span class="font-bold text-[#0F766E]">Dedicated Cohort Group</span>
                </div>
                <div class="flex items-center justify-between">
                  <span>Credentials</span>
                  <span class="font-bold text-[#064E3B]">Practitioner Certification</span>
                </div>
              </div>
            </div>

            <!-- Action Button -->
            <a
              href={whatsappEnrollUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="w-full flex items-center justify-center gap-2 py-4 px-6 rounded-2xl bg-[#064E3B] hover:bg-[#0F766E] text-white text-sm font-bold shadow-lg transition-colors"
            >
              <MessageCircle class="w-4 h-4 fill-current" />
              <span>Reserve Your Cohort Seat ↗</span>
            </a>

          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Core Learning Areas Section -->
  <section class="py-20 bg-[#FFFDF9] border-b border-gray-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-3xl mx-auto space-y-3 mb-16">
        <span class="text-xs font-bold uppercase tracking-widest text-[#0F766E] bg-emerald-50 px-3 py-1 rounded-full border border-emerald-200">
          Comprehensive System
        </span>
        <h2 class="text-3xl sm:text-4xl font-serif font-bold text-[#064E3B]">
          Core Learning Areas
        </h2>
        <p class="text-gray-600 text-base sm:text-lg">
          Unlike standard courses that only cover theory, TPPC integrates 8 multidisciplinary fields into one cohesive system:
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {coreAreas.map((area) => (
          <div class="bg-white rounded-2xl p-6 shadow-sm hover:shadow-xl border border-gray-200/80 hover:border-[#0F766E]/40 transition-all duration-300 space-y-3 flex flex-col justify-between group">
            <div class="space-y-3">
              <div class="w-12 h-12 rounded-xl bg-emerald-50 text-[#0F766E] flex items-center justify-center group-hover:scale-110 transition-transform">
                <area.icon class="w-6 h-6" />
              </div>
              <h3 class="text-base font-bold text-[#064E3B]">
                {area.title}
              </h3>
              <p class="text-xs sm:text-sm text-gray-600 leading-relaxed">
                {area.desc}
              </p>
            </div>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- YouTube vs Structured Course Comparison Section -->
  <section class="py-20 bg-[#F8FFFC] border-b border-emerald-900/10">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      
      <div class="text-center max-w-3xl mx-auto space-y-3">
        <span class="text-xs font-bold uppercase tracking-widest text-[#0F766E]">
          The Power of Live Training
        </span>
        <h2 class="text-3xl sm:text-4xl font-serif font-bold text-[#064E3B]">
          Why Join a Live Course Instead of Just Watching Videos?
        </h2>
        <p class="text-lg font-serif italic text-[#0F766E]">
          “Videos give information. A structured course creates transformation.”
        </p>
      </div>

      <!-- Comparison Table Card -->
      <div class="bg-white rounded-3xl shadow-xl border border-emerald-900/10 overflow-hidden">
        <div class="grid grid-cols-1 md:grid-cols-12 bg-gray-50 border-b border-gray-200 p-4 text-xs font-bold uppercase tracking-wider text-gray-500">
          <div class="md:col-span-4 hidden md:block">Dimension</div>
          <div class="md:col-span-4 text-rose-700">Watching Free Online Videos</div>
          <div class="md:col-span-4 text-[#064E3B]">TPPC Live Interactive Cohort</div>
        </div>

        <div class="divide-y divide-gray-100">
          {comparisonPoints.map((row) => (
            <div class="grid grid-cols-1 md:grid-cols-12 p-4 sm:p-5 gap-3 text-sm items-center">
              <div class="md:col-span-4 font-bold text-[#064E3B]">
                {row.feature}
              </div>
              <div class="md:col-span-4 text-gray-500 flex items-start gap-2">
                <X class="w-4 h-4 text-rose-500 shrink-0 mt-0.5" />
                <span class="text-xs sm:text-sm">{row.youtube}</span>
              </div>
              <div class="md:col-span-4 text-gray-800 font-medium flex items-start gap-2 bg-emerald-50/50 p-2 rounded-xl">
                <CheckCircle2 class="w-4 h-4 text-[#10B981] shrink-0 mt-0.5" />
                <span class="text-xs sm:text-sm text-[#064E3B]">{row.tppc}</span>
              </div>
            </div>
          ))}
        </div>
      </div>

      <div class="text-center pt-4">
        <p class="text-base text-gray-700 font-medium">
          Don’t just collect parenting tips. Learn a proven system that permanently transforms your family atmosphere.
        </p>
        <div class="mt-6">
          <a
            href={whatsappEnrollUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-8 py-3.5 rounded-2xl bg-[#0F766E] hover:bg-[#064E3B] text-white text-sm font-bold shadow-lg transition-all"
          >
            <span>Live and Interactive | Enroll Now →</span>
          </a>
        </div>
      </div>

    </div>
  </section>

  <!-- The Problem: Parenting Has Never Been This Difficult -->
  <section class="py-20 bg-[#FFFDF9] border-b border-gray-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-3xl mx-auto space-y-3 mb-16">
        <span class="text-xs font-bold uppercase tracking-widest text-rose-700 bg-rose-50 px-3 py-1 rounded-full border border-rose-200">
          The Problem
        </span>
        <h2 class="text-3xl sm:text-4xl font-serif font-bold text-[#064E3B]">
          Parenting Has Never Been This Difficult…
        </h2>
        <p class="text-gray-600 text-base sm:text-lg">
          Today's parents are raising children in a world filled with digital distractions, moral confusion, and unprecedented peer pressure:
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4">
        {modernProblems.map((prob) => (
          <div class="bg-white rounded-2xl p-5 shadow-sm border border-gray-200/80 hover:border-rose-300 transition-all space-y-2">
            <div class="w-8 h-8 rounded-lg bg-rose-50 text-rose-600 flex items-center justify-center font-bold text-xs">
              !
            </div>
            <h3 class="text-sm font-bold text-[#064E3B]">{prob.title}</h3>
            <p class="text-xs text-gray-500 leading-relaxed">{prob.desc}</p>
          </div>
        ))}
      </div>

      <!-- Reality Quote Callout -->
      <div class="mt-14 max-w-2xl mx-auto text-center p-8 rounded-3xl bg-[#064E3B] text-white shadow-xl space-y-4">
        <p class="text-lg sm:text-xl font-serif italic text-[#D1FAE5] leading-relaxed">
          “Most parents love their children deeply… but very few have ever been taught how to raise them.”
        </p>
        <p class="text-xs text-white/70">
          TPPC bridges that gap with compassion, psychological insight, and practical tools.
        </p>
      </div>

    </div>
  </section>

  <!-- Complete 10 Pillars Curriculum -->
  <section id="curriculum" class="py-20 bg-[#F4F8F6] border-b border-gray-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-3xl mx-auto space-y-3 mb-16">
        <span class="text-xs font-bold uppercase tracking-widest text-[#0F766E]">
          Complete 10 Pillars
