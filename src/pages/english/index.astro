---
import Layout from '../../layouts/Layout.astro';
import { getEnglishPosts } from '../../lib/api';
import { BookOpen, Clock, Calendar, ArrowRight, ArrowUpRight, Sparkles } from 'lucide-astro';

const posts = await getEnglishPosts(50);
---

<Layout
  title="English Blog & Parenting Articles | EduTarbiyah"
  description="Read insightful articles and practical advice on Islamic parenting, children's emotional development, habits, and education."
>
  <!-- Blog Hero Section -->
  <section class="bg-gradient-to-b from-[#F4F8F6] via-[#FFFDF9] to-[#FFFDF9] py-12 lg:py-16 border-b border-gray-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-4">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#0F766E]/10 border border-[#0F766E]/20 text-[#0F766E] text-xs font-semibold">
        <Sparkles class="w-3.5 h-3.5 text-[#F59E0B]" />
        <span>Parenting Power-ups & Reflections</span>
      </div>

      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-serif font-extrabold text-[#064E3B] tracking-tight">
        EduTarbiyah English Blog
      </h1>

      <p class="text-base sm:text-lg text-gray-600 max-w-2xl mx-auto leading-relaxed">
        Deep, thoughtful perspectives on holistic parenting, parent-child connection, and navigating 21st-century family challenges.
      </p>

      <!-- Urdu Blog Callout Banner -->
      <div class="pt-6 max-w-xl mx-auto">
        <div class="bg-emerald-900 text-white rounded-2xl p-4 sm:p-5 shadow-lg flex flex-col sm:flex-row items-center justify-between gap-4">
          <div class="text-center sm:text-right">
            <span class="text-xs text-[#F59E0B] font-bold uppercase tracking-wider block">اردو مضامین و بلاگ</span>
            <span class="font-urdu text-sm sm:text-base">والدین اور اساتذہ کے لیے اردو مضامین کا وسیع ذخیرہ</span>
          </div>
          <a
            href="https://blog.edutarbiyah.com"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-white text-[#064E3B] text-xs font-bold hover:bg-[#F59E0B] hover:text-white transition-all shrink-0"
          >
            <span>وزٹ بلاگ</span>
            <ArrowUpRight class="w-3.5 h-3.5" />
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Articles Grid -->
  <section class="py-16 bg-[#FFFDF9]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      {posts.length > 0 ? (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {posts.map((post) => {
            const cleanTitle = post.title.rendered.replace(/&#8211;/g, '–').replace(/&#038;/g, '&');
            const cleanExcerpt = post.excerpt.rendered.replace(/<[^>]*>?/gm, '').trim().slice(0, 160) + '...';
            const postDate = new Date(post.date).toLocaleDateString('en-US', {
              month: 'long',
              day: 'numeric',
              year: 'numeric',
            });
            const featuredImage = post._embedded?.['wp:featuredmedia']?.[0]?.source_url;

            return (
              <article class="bg-white rounded-2xl border border-gray-100 shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col overflow-hidden group">
                {featuredImage && (
                  <a href={`/english/${post.slug}/`} class="block aspect-video overflow-hidden bg-gray-50">
                    <img
                      src={featuredImage}
                      alt={cleanTitle}
                      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                    />
                  </a>
                )}

                <div class="p-6 flex flex-col flex-grow">
                  <div class="flex items-center gap-2 text-xs text-gray-500 mb-3">
                    <Calendar class="w-3.5 h-3.5 text-[#0F766E]" />
                    <span>{postDate}</span>
                  </div>

                  <h2 class="text-xl font-serif font-bold text-gray-900 group-hover:text-[#0F766E] transition-colors leading-snug mb-3">
                    <a href={`/english/${post.slug}/`}>
                      {cleanTitle}
                    </a>
                  </h2>

                  <p class="text-xs text-gray-600 leading-relaxed flex-grow">
                    {cleanExcerpt}
                  </p>

                  <div class="mt-6 pt-4 border-t border-gray-100 flex items-center justify-between">
                    <span class="text-xs font-semibold text-gray-400">EduTarbiyah Editorial</span>
                    <a
                      href={`/english/${post.slug}/`}
                      class="inline-flex items-center gap-1.5 text-xs font-bold text-[#0F766E] group-hover:translate-x-1 transition-transform"
                    >
                      <span>Read More</span>
                      <ArrowRight class="w-3.5 h-3.5" />
                    </a>
                  </div>
                </div>
              </article>
            );
          })}
        </div>
      ) : (
        <div class="text-center py-20 bg-white rounded-3xl border border-gray-100 max-w-md mx-auto p-8 space-y-4">
          <BookOpen class="w-12 h-12 text-gray-300 mx-auto" />
          <h3 class="text-lg font-bold text-gray-800">Articles are syncing</h3>
          <p class="text-xs text-gray-500">
            English articles are being refreshed from the backend.
          </p>
        </div>
      )}
    </div>
  </section>
</Layout>
