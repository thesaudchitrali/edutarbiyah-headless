---
import Layout from '../../layouts/Layout.astro';
import { getEnglishPosts, type WPPost, WHATSAPP_NUMBER } from '../../lib/api';
import { ChevronRight, Home, Calendar, Clock, Share2, MessageCircle, ArrowLeft, ArrowRight } from 'lucide-astro';

export async function getStaticPaths() {
  const posts = await getEnglishPosts(100);

  return posts.map((post) => ({
    params: { slug: decodeURIComponent(post.slug) },
    props: { post, allPosts: posts },
  }));
}

interface Props {
  post: WPPost;
  allPosts: WPPost[];
}

const { post, allPosts } = Astro.props;

// Decode title
const title = post.title?.rendered
  ? post.title.rendered.replace(/&#8211;/g, '–').replace(/&#038;/g, '&')
  : 'EduTarbiyah Article';

const postDate = new Date(post.date).toLocaleDateString('en-US', {
  month: 'long',
  day: 'numeric',
  year: 'numeric',
});

const featuredImage = post._embedded?.['wp:featuredmedia']?.[0]?.source_url;
const authorName = post._embedded?.author?.[0]?.name || 'EduTarbiyah Team';

const plainDescription = post.excerpt?.rendered
  ? post.excerpt.rendered.replace(/<[^>]*>?/gm, '').trim().slice(0, 160)
  : `Read "${title}" on EduTarbiyah.`;

// Sibling articles for navigation
const otherPosts = allPosts.filter((p) => p.id !== post.id).slice(0, 2);
---

<Layout
  title={`${title} | EduTarbiyah Blog`}
  description={plainDescription}
  image={featuredImage}
>
  <!-- Article Header & Breadcrumbs -->
  <article class="bg-[#FFFDF9] py-12 lg:py-16">
    <div class="max-w-3xl mx-auto px-4 sm:px-6">
      
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-xs text-gray-500 font-medium mb-6" aria-label="Breadcrumb">
        <a href="/" class="hover:text-[#0F766E] transition-colors flex items-center gap-1">
          <Home class="w-3.5 h-3.5" />
          <span>Home</span>
        </a>
        <ChevronRight class="w-3.5 h-3.5 text-gray-400" />
        <a href="/english/" class="hover:text-[#0F766E] transition-colors">
          English Blog
        </a>
        <ChevronRight class="w-3.5 h-3.5 text-gray-400" />
        <span class="text-[#064E3B] font-semibold truncate max-w-xs">{title}</span>
      </nav>

      <!-- Category & Date Meta -->
      <div class="flex items-center gap-3 text-xs text-gray-500 mb-4">
        <span class="font-bold text-[#0F766E] uppercase tracking-wider bg-[#0F766E]/10 px-2.5 py-0.5 rounded-full">
          Parenting Article
        </span>
        <span>•</span>
        <div class="flex items-center gap-1">
          <Calendar class="w-3.5 h-3.5 text-gray-400" />
          <time datetime={post.date}>{postDate}</time>
        </div>
      </div>

      <!-- Main Headline -->
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-serif font-extrabold text-[#064E3B] tracking-tight leading-tight mb-6">
        {title}
      </h1>

      <!-- Author statement -->
      <div class="flex items-center gap-3 pb-8 border-b border-gray-100 text-xs text-gray-600">
        <div class="w-9 h-9 rounded-full bg-[#0F766E] text-white flex items-center justify-center font-bold">
          ET
        </div>
        <div>
          <div class="font-bold text-gray-900">{authorName}</div>
          <div>EduTarbiyah Institute Research & Family Counseling</div>
        </div>
      </div>

      <!-- Featured Image -->
      {featuredImage && (
        <div class="my-8 rounded-3xl overflow-hidden shadow-lg border border-gray-100">
          <img src={featuredImage} alt={title} class="w-full h-auto object-cover max-h-[450px]" />
        </div>
      )}

      <!-- Article Body -->
      <div
        class="wp-content mt-8"
        set:html={post.content?.rendered || '<p>Article content is loading...</p>'}
      />

      <!-- WhatsApp Share & Discussion CTA -->
      <div class="mt-14 pt-8 border-t border-gray-200 bg-[#F4F8F6] rounded-3xl p-6 sm:p-8 flex flex-col sm:flex-row items-center justify-between gap-4">
        <div class="space-y-1 text-center sm:text-left">
          <h3 class="font-bold text-[#064E3B] text-base">Enjoyed this article?</h3>
          <p class="text-xs text-gray-600">
            Share with fellow parents or join our daily discussion group on WhatsApp.
          </p>
        </div>
        <div class="flex items-center gap-3">
          <a
            href={`https://api.whatsapp.com/send?text=${encodeURIComponent(`${title} - Read more on EduTarbiyah: https://edutarbiyah.com/english/${post.slug}/`)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 px-4 py-2.5 rounded-xl bg-[#25D366] hover:bg-[#20bd5a] text-white text-xs font-bold shadow transition-all"
          >
            <Share2 class="w-4 h-4" />
            <span>Share on WhatsApp</span>
          </a>
          <a
            href="/parents-whatsapp-community/"
            class="inline-flex items-center gap-1.5 px-4 py-2.5 rounded-xl bg-[#0F766E] hover:bg-[#064E3B] text-white text-xs font-bold shadow transition-all"
          >
            <MessageCircle class="w-4 h-4" />
            <span>Join Community</span>
          </a>
        </div>
      </div>

      <!-- Sibling Articles -->
      {otherPosts.length > 0 && (
        <div class="mt-16 pt-12 border-t border-gray-200 space-y-6">
          <h3 class="text-xl font-serif font-bold text-[#064E3B]">
            More Reading from EduTarbiyah
          </h3>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            {otherPosts.map((p) => {
              const pTitle = p.title.rendered.replace(/&#8211;/g, '–').replace(/&#038;/g, '&');
              return (
                <a
                  href={`/english/${p.slug}/`}
                  class="p-5 rounded-2xl bg-white border border-gray-100 hover:border-[#0F766E] shadow-sm hover:shadow transition-all flex flex-col justify-between group"
                >
                  <h4 class="font-serif font-bold text-sm text-gray-900 group-hover:text-[#0F766E] transition-colors leading-snug mb-2">
                    {pTitle}
                  </h4>
                  <span class="text-xs font-semibold text-[#0F766E] inline-flex items-center gap-1">
                    <span>Read Article</span>
                    <ArrowRight class="w-3 h-3 group-hover:translate-x-1 transition-transform" />
                  </span>
                </a>
              );
            })}
          </div>
        </div>
      )}

    </div>
  </article>
</Layout>
