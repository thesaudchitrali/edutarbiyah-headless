---
import Layout from '../layouts/Layout.astro';
import { 
  Sparkles, 
  ChevronRight, 
  Home, 
  CheckCircle2, 
  Printer, 
  RotateCcw, 
  Calendar,
  Award,
  Star,
  Check,
  AlertCircle,
  Clock
} from 'lucide-astro';

const behaviors = [
  { id: 'b1', name: 'Anger & Frustration Control', desc: 'Expressing big emotions with words rather than yelling or slamming doors' },
  { id: 'b2', name: 'Cooperation & Listening', desc: 'Responding respectfully without repeated nagging or power struggles' },
  { id: 'b3', name: 'Screen Time Boundaries', desc: 'Powering down devices cheerfully when the timer ends' },
  { id: 'b4', name: 'Salah & Wudu Consistency', desc: 'Performing prayers with attentiveness and positive attitude' },
  { id: 'b5', name: 'Study & Homework Discipline', desc: 'Focused effort during study blocks without constant distraction' },
  { id: 'b6', name: 'Bedtime & Morning Routines', desc: 'Sleeping on time and waking up peacefully without morning chaos' },
  { id: 'b7', name: 'Kindness to Siblings & Parents', desc: 'Using gentle words, sharing toys, and saying JazakAllah Khair' },
];

const days = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'];
---

<Layout
  title="Child Behavior Improvement Tracker | EduTarbiyah"
  description="Interactive 7-day behavioral tracker for positive reinforcement, emotional self-regulation, Salah habits, and screen discipline. Printable and autosaved."
>
  <!-- Hero Section -->
  <section class="bg-gradient-to-b from-[#F4F8F6] via-[#FFFDF9] to-[#FFFDF9] py-12 lg:py-16 border-b border-gray-100">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center space-y-4">
      
      <!-- Breadcrumb -->
      <nav class="flex items-center justify-center gap-2 text-xs text-gray-500 font-medium mb-2" aria-label="Breadcrumb">
        <a href="/" class="hover:text-[#0F766E] transition-colors flex items-center gap-1">
          <Home class="w-3.5 h-3.5" />
          <span>Home</span>
        </a>
        <ChevronRight class="w-3.5 h-3.5 text-gray-400" />
        <span class="text-[#064E3B] font-semibold">Child Behavior Tracker</span>
      </nav>

      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#0F766E]/10 border border-[#0F766E]/20 text-[#0F766E] text-xs font-semibold">
        <Award class="w-3.5 h-3.5 text-[#F59E0B]" />
        <span>Positive Reinforcement Tool</span>
      </div>

      <h1 class="text-3xl sm:text-5xl font-serif font-extrabold text-[#064E3B] tracking-tight">
        Child Behavior Improvement Tracker
      </h1>

      <p class="text-base sm:text-lg text-gray-600 max-w-2xl mx-auto leading-relaxed">
        Focus on progress rather than perfection. Track 7 daily core habits, celebrate micro-wins, and eliminate power struggles with gentle accountability.
      </p>

    </div>
  </section>

  <!-- Tracker Table & Matrix -->
  <section class="py-12 lg:py-16 bg-[#FFFDF9]">
    <div class="max-w-5xl mx-auto px-4 sm:px-6">
      
      <!-- Control Bar -->
      <div class="bg-white rounded-3xl p-6 border border-gray-100 shadow-sm mb-8 flex flex-col sm:flex-row items-center justify-between gap-4">
        <div class="flex items-center gap-4 w-full sm:w-auto">
          <div>
            <label class="block text-[11px] font-bold text-gray-400 uppercase tracking-wider">Child’s Name:</label>
            <input
              type="text"
              id="child-name-input"
              placeholder="e.g. Abdullah or Maryam"
              class="font-serif font-bold text-lg text-[#064E3B] border-b border-gray-300 focus:outline-none focus:border-[#0F766E] bg-transparent"
            />
          </div>
        </div>

        <div class="flex items-center gap-3">
          <!-- Total Score Counter -->
          <div class="bg-[#F4F8F6] px-4 py-2 rounded-2xl border border-[#0F766E]/20 text-center">
            <span class="block text-[10px] font-bold uppercase text-gray-500 tracking-wider">Weekly Score</span>
            <span id="tracker-total-score" class="font-serif font-black text-2xl text-[#0F766E]">0</span>
            <span class="text-xs text-gray-400">/ 98</span>
          </div>

          <button
            type="button"
            id="btn-print-tracker"
            class="inline-flex items-center gap-1.5 px-4 py-2.5 rounded-xl bg-[#064E3B] hover:bg-[#0F766E] text-white text-xs font-bold shadow transition-all cursor-pointer"
          >
            <Printer class="w-4 h-4 text-[#F59E0B]" />
            <span>Print Chart</span>
          </button>
        </div>
      </div>

      <!-- Legend Indicator -->
      <div class="flex flex-wrap items-center justify-between text-xs text-gray-600 mb-4 px-2">
        <div class="flex items-center gap-4">
          <span class="font-semibold text-gray-900">Click cell to change status:</span>
          <span class="inline-flex items-center gap-1 text-amber-800 font-bold bg-amber-50 px-2.5 py-0.5 rounded-full border border-amber-200">
            <Star class="w-3.5 h-3.5 text-amber-500 fill-amber-400" />
            <span>Star (+2 pts)</span>
          </span>
          <span class="inline-flex items-center gap-1 text-teal-800 font-bold bg-teal-50 px-2.5 py-0.5 rounded-full border border-teal-200">
            <Check class="w-3.5 h-3.5 text-teal-600" />
            <span>Good (+1 pt)</span>
          </span>
          <span class="inline-flex items-center gap-1 text-gray-500 font-bold bg-gray-100 px-2.5 py-0.5 rounded-full border border-gray-200">
            <Clock class="w-3.5 h-3.5 text-gray-400" />
            <span>In Progress (0 pts)</span>
          </span>
        </div>
        <button
          type="button"
          id="btn-reset-tracker"
          class="text-xs text-gray-400 hover:text-rose-600 transition-colors flex items-center gap-1 cursor-pointer"
        >
          <RotateCcw class="w-3.5 h-3.5" />
          <span>Reset Week</span>
        </button>
      </div>

      <!-- Responsive Interactive Matrix -->
      <div class="bg-white rounded-3xl border border-gray-200 shadow-lg overflow-x-auto" id="printable-tracker-area">
        <table class="w-full min-w-[700px] border-collapse text-left">
          <thead>
            <tr class="bg-[#F8FFFC] border-b border-gray-200 text-xs font-bold text-[#064E3B] uppercase tracking-wider">
              <th class="py-4 px-6 w-1/3">Target Tarbiyah Behavior</th>
              {days.map((d) => (
                <th class="py-4 px-3 text-center">{d}</th>
              ))}
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100 text-sm">
            {behaviors.map((b, bIdx) => (
              <tr class="hover:bg-gray-50/50 transition-colors">
                <td class="py-4 px-6">
                  <div class="font-bold text-gray-900 text-sm leading-tight">{b.name}</div>
                  <div class="text-[11px] text-gray-500 mt-0.5 leading-snug">{b.desc}</div>
                </td>
                {days.map((d, dIdx) => (
                  <td class="py-3 px-2 text-center align-middle">
                    <button
                      type="button"
                      class="tracker-cell w-10 h-10 rounded-xl flex items-center justify-center font-bold text-base transition-all mx-auto border cursor-pointer border-gray-200 bg-gray-50 hover:border-gray-400"
                      data-row={bIdx}
                      data-col={dIdx}
                      data-state="0"
                      title="Click to cycle status"
                    >
                      <span class="cell-icon text-gray-300">•</span>
                    </button>
                  </td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <!-- Motivation / Coaching Note -->
      <div class="mt-8 bg-[#FFF8EC] rounded-2xl p-6 border border-[#F59E0B]/30 flex items-start gap-4">
        <Star class="w-6 h-6 text-[#F59E0B] shrink-0 mt-0.5" />
        <div class="space-y-1 text-xs text-[#92400E] leading-relaxed">
          <p class="font-bold text-sm">Tarbiyah Practitioner Advice:</p>
          <p>
            Never use this tracker to shame or penalize a child. If your child struggles on a particular day, express empathy:
            <em>“I noticed today was tough with screen limits. Let’s make a fresh intention for tomorrow together.”</em>
            Reward weekly effort with quality family time rather than material bribes.
          </p>
        </div>
      </div>

    </div>
  </section>
</Layout>

<script>
  const STORAGE_KEY = 'edutarbiyah_child_behavior_tracker';
  const NAME_KEY = 'edutarbiyah_child_name';

  const cells = document.querySelectorAll('.tracker-cell');
  const nameInput = document.getElementById('child-name-input') as HTMLInputElement;
  const totalScoreEl = document.getElementById('tracker-total-score');

  // Load saved state
  let stateMatrix: number[][] = Array(7).fill(0).map(() => Array(7).fill(0));

  try {
    const saved = localStorage.getItem(STORAGE_KEY);
    if (saved) {
      stateMatrix = JSON.parse(saved);
    }
    const savedName = localStorage.getItem(NAME_KEY);
    if (savedName && nameInput) {
      nameInput.value = savedName;
    }
  } catch (err) {
    console.warn('Could not read tracker storage:', err);
  }

  // Render initial cell icons
  cells.forEach((cell) => {
    const r = parseInt(cell.getAttribute('data-row') || '0', 10);
    const c = parseInt(cell.getAttribute('data-col') || '0', 10);
    const state = stateMatrix[r]?.[c] || 0;
    applyCellVisuals(cell as HTMLButtonElement, state);

    cell.addEventListener('click', () => {
      let cur = parseInt(cell.getAttribute('data-state') || '0', 10);
      cur = (cur + 1) % 3; // 0 -> 1 -> 2 -> 0
      stateMatrix[r][c] = cur;
      applyCellVisuals(cell as HTMLButtonElement, cur);
      saveState();
      calculateTotal();
    });
  });

  function applyCellVisuals(btn: HTMLButtonElement, state: number) {
    btn.setAttribute('data-state', state.toString());
    const iconSpan = btn.querySelector('.cell-icon');
    if (!iconSpan) return;

    if (state === 2) {
      // Star / Excellent
      btn.className = 'tracker-cell w-10 h-10 rounded-xl flex items-center justify-center font-bold text-base transition-all mx-auto border cursor-pointer border-amber-300 bg-amber-50 shadow-sm';
      iconSpan.innerHTML = '<svg class="w-4 h-4 text-amber-500 fill-amber-400" viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>';
    } else if (state === 1) {
      // Good / Progress
      btn.className = 'tracker-cell w-10 h-10 rounded-xl flex items-center justify-center font-bold text-base transition-all mx-auto border cursor-pointer border-teal-300 bg-teal-50 shadow-sm';
      iconSpan.innerHTML = '<svg class="w-4 h-4 text-teal-600" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>';
    } else {
      // In progress
      btn.className = 'tracker-cell w-10 h-10 rounded-xl flex items-center justify-center font-bold text-base transition-all mx-auto border cursor-pointer border-gray-200 bg-gray-50 hover:border-gray-400';
      iconSpan.innerHTML = '<span class="text-gray-300 font-bold">•</span>';
    }
  }

  function calculateTotal() {
    let sum = 0;
    for (let r = 0; r < 7; r++) {
      for (let c = 0; c < 7; c++) {
        sum += stateMatrix[r][c]; // 0, 1, or 2
      }
    }
    if (totalScoreEl) totalScoreEl.textContent = sum.toString();
  }

  function saveState() {
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(stateMatrix));
    } catch {}
  }

  nameInput?.addEventListener('input', () => {
    localStorage.setItem(NAME_KEY, nameInput.value);
  });

  calculateTotal();

  // Reset
  document.getElementById('btn-reset-tracker')?.addEventListener('click', () => {
    if (confirm('Are you sure you want to reset this week’s tracker?')) {
      stateMatrix = Array(7).fill(0).map(() => Array(7).fill(0));
      saveState();
      cells.forEach((cell) => {
        applyCellVisuals(cell as HTMLButtonElement, 0);
      });
      calculateTotal();
    }
  });

  // Print
  document.getElementById('btn-print-tracker')?.addEventListener('click', () => {
    window.print();
  });
</script>
