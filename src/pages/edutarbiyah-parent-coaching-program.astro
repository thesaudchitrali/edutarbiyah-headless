  <!-- Interactive Form Handling Script -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const form = document.getElementById('coachingChallengeForm');
      const submitBtn = document.getElementById('submitBtn');
      const btnText = document.getElementById('btnText');
      const formStatus = document.getElementById('formStatus');

      if (!form) return;

      form.addEventListener('submit', async (e) => {
        e.preventDefault();

        const name = document.getElementById('coachingName')?.value.trim() || '';
        const phone = document.getElementById('coachingPhone')?.value.trim() || '';
        const childInfo = document.getElementById('childInfo')?.value.trim() || '';
        const mode = document.getElementById('coachingMode')?.value.trim() || 'WhatsApp Call';
        const challenge = document.getElementById('coachingChallenge')?.value.trim() || '';

        if (!name || !phone || !challenge) {
          alert('Please fill out all required fields.');
          return;
        }

        // Show loading state
        submitBtn.disabled = true;
        btnText.textContent = 'Saving Consultation Request...';

        // Prepare submission payload for central DB capture
        const submissionPayload = {
          tool_type: 'parent_coaching_intake',
          tool_name: 'Parent Coaching Program Consultation',
          respondent_name: name,
          respondent_contact: phone,
          responses: {
            preferred_mode: mode,
            child_info: childInfo,
            main_challenge: challenge,
            source_url: window.location.href,
            timestamp: new Date().toISOString()
          }
        };

        // Attempt to record lead in WordPress DB
        try {
          await fetch('/wp-json/edutarbiyah/v1/submit-assessment', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(submissionPayload)
          });
        } catch (err) {
          console.warn('[EduTarbiyah Lead Save Non-blocking]', err);
        }

        // Construct pre-filled WhatsApp message
        let waMessage = `Assalam o Alaikum Dr. Muhammad Younas Khalid,\n\nI want to consult you regarding the EduTarbiyah Parent Coaching Program.\n\n👤 Name: ${name}\n📱 WhatsApp: ${phone}\n👶 Child Info: ${childInfo || 'Not specified'}\n📞 Preferred Mode: ${mode}\n🎯 Main Challenge: ${challenge}\n\nPlease guide me regarding the next step and available consultation slots.`;

        const waUrl = `https://wa.me/923122370720?text=${encodeURIComponent(waMessage)}`;

        // Provide visual feedback
        formStatus.classList.remove('hidden');
        formStatus.textContent = 'Opening WhatsApp to send your inquiry...';

        setTimeout(() => {
          window.open(waUrl, '_blank');
          btnText.textContent = 'Send to Dr. Younus on WhatsApp';
          submitBtn.disabled = false;
        }, 600);
      });
    });
  </script>

