              <textarea
                name="parent_growth"
                rows="2"
                class="w-full px-4 py-3 rounded-xl border border-gray-200 text-base sm:text-sm focus:ring-2 focus:ring-[#0F766E] focus:border-transparent outline-none transition-all"
                placeholder="e.g. Stop shouting, become more patient, regulate my stress..."
                data-placeholder-en="e.g. Stop shouting, become more patient, regulate my stress..."
                data-placeholder-ur="مثلاً چیخنا بند کرنا، زیادہ صابر بننا، اپنے غصے پر قابو پانا..."
