            <!-- Ready for assignments -->
            <div class="space-y-1.5">
              <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider" data-en="Are you ready to practice home exercises & daily action assignments?" data-ur="کیا آپ دی گئی مشقیں اور روزمرہ اسائنمنٹس مکمل کرنے کے لیے تیار ہیں؟">
                Are you ready to practice home exercises & daily action assignments?
              </label>
              <div class="grid grid-cols-3 gap-3">
                {[
                  { val: "Yes", en: "Yes, fully committed", ur: "جی ہاں، مکمل تیار ہوں" },
                  { val: "Sometimes", en: "Will try my best", ur: "پوری کوشش کروں گا/گی" },
                  { val: "Not sure", en: "Not sure yet", ur: "ابھی یقین نہیں" }
                ].map((item) => (
                  <label class="flex items-center justify-center p-3 rounded-xl border border-gray-200 text-xs font-bold text-gray-700 cursor-pointer hover:border-[#0F766E] transition-all has-[:checked]:bg-emerald-50 has-[:checked]:border-[#0F766E] has-[:checked]:text-[#064E3B]">
                    <input type="radio" name="assignments" value={item.val} class="sr-only" />
                    <span data-en={item.en} data-ur={item.ur}>{item.en}</span>
                  </label>
                ))}
              </div>
            </div>

          </div>
        </div>

        <!-- ========================================== -->
        <!-- SECTION 9: ADDITIONAL NOTES -->
        <!-- ========================================== -->
        <div class="bg-white rounded-3xl p-6 sm:p-10 shadow-sm border border-gray-200/80 space-y-6" id="section-9">
          <div class="flex items-center gap-3 border-b border-gray-100 pb-4">
            <span class="w-9 h-9 rounded-2xl bg-emerald-50 text-[#064E3B] font-bold text-sm flex items-center justify-center shrink-0">
              09
            </span>
            <div>
              <h2 class="text-xl sm:text-2xl font-serif font-bold text-[#064E3B]" data-en="9. Additional Information" data-ur="9۔ کوئی اور اہم بات؟">
                9. Additional Information
              </h2>
              <p class="text-xs sm:text-sm text-gray-500" data-en="Anything else you want Dr. Younus Khalid to know before your session starts" data-ur="کوئی اور اہم بات جو آپ سیشن شروع ہونے سے پہلے شیئر کرنا چاہتے ہوں">
                Anything else you want Dr. Younus Khalid to know before your session starts
              </p>
            </div>
          </div>

          <div class="space-y-1.5">
            <textarea
              name="additional_information"
              rows="3"
              class="w-full px-4 py-3 rounded-xl border border-gray-200 text-base sm:text-sm focus:ring-2 focus:ring-[#0F766E] focus:border-transparent outline-none transition-all"
              placeholder="Any medical, psychological, or historical context you wish to share confidentially..."
              data-placeholder-en="Any medical, psychological, or historical context you wish to share confidentially..."
              data-placeholder-ur="کوئی بھی طبی، نفسیاتی یا ماضی کا پس منظر جو آپ شیئر کرنا چاہتے ہوں..."
            ></textarea>
          </div>
        </div>

        <!-- Submission Actions Area -->
        <div class="bg-gradient-to-r from-[#064E3B] to-[#0F766E] rounded-3xl p-8 sm:p-10 text-white shadow-xl space-y-6 text-center">
          
          <div class="space-y-2 max-w-xl mx-auto">
            <h3 class="text-2xl font-serif font-bold" data-en="Ready to Begin Your Coaching?" data-ur="کیا آپ کوچنگ شروع کرنے کے لیے تیار ہیں؟">
              Ready to Begin Your Coaching?
            </h3>
            <p class="text-xs sm:text-sm text-[#D1FAE5]" data-en="When you submit, your diagnostic responses are instantly formatted and delivered directly to the EduTarbiyah counselor team on WhatsApp for session scheduling." data-ur="فارم سبمٹ کرنے پر آپ کے تمام جوابات ایک باقاعدہ تشخیصی رپورٹ کی شکل میں واٹس ایپ پر EduTarbiyah کونسلر کو موصول ہو جائیں گے۔">
              When you submit, your diagnostic responses are instantly formatted and delivered directly to the EduTarbiyah counselor team on WhatsApp for session scheduling.
            </p>
          </div>

          <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
            
            <!-- Submit Button via WhatsApp -->
            <button
              type="submit"
              id="submit-btn"
              class="w-full sm:w-auto inline-flex items-center justify-center gap-3 px-8 py-4 rounded-2xl bg-[#25D366] hover:bg-[#20bd5a] text-white text-base font-extrabold shadow-2xl hover:scale-105 active:scale-95 transition-all duration-200 cursor-pointer"
            >
              <MessageCircle class="w-6 h-6 fill-current" />
              <span data-en="Submit via WhatsApp →" data-ur="واٹس ایپ پر سبمٹ کریں ←">
                Submit via WhatsApp →
              </span>
            </button>

            <!-- Copy Summary Button -->
            <button
              type="button"
              id="copy-summary-btn"
              class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-4 rounded-2xl bg-white/10 hover:bg-white/20 text-white text-sm font-bold border border-white/20 backdrop-blur-sm transition-all cursor-pointer"
            >
              <Copy class="w-4 h-4" />
              <span data-en="Copy Diagnostic Summary" data-ur="رپورٹ کاپی کریں">Copy Diagnostic Summary</span>
            </button>

            <!-- Print Button -->
            <button
              type="button"
              id="print-btn"
              class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-4 rounded-2xl bg-white/10 hover:bg-white/20 text-white text-sm font-bold border border-white/20 backdrop-blur-sm transition-all cursor-pointer"
            >
              <Printer class="w-4 h-4" />
              <span data-en="Print Form" data-ur="پرنٹ کریں">Print Form</span>
            </button>

          </div>

          <!-- Reset Button -->
          <div class="pt-2">
            <button
              type="button"
              id="reset-form-btn"
              class="text-xs text-white/60 hover:text-white underline inline-flex items-center gap-1 cursor-pointer"
            >
              <RotateCcw class="w-3 h-3" />
              <span data-en="Clear & Reset Form" data-ur="فارم صاف کریں اور دوبارہ شروع کریں">Clear & Reset Form</span>
            </button>
          </div>

        </div>

      </form>

    </div>
  </main>

  <!-- Client-Side Form Logic Island -->
  <script is:inline define:vars={{ WHATSAPP_NUMBER }}>
    (function() {
      let currentLang = 'en';
      const form = document.getElementById('intake-form');
      const langToggleBtn = document.getElementById('lang-toggle-btn');
      const langToggleText = document.getElementById('lang-toggle-text');
      const progressBar = document.getElementById('progress-bar-fill');
      const progressText = document.getElementById('progress-percentage-text');
      const copyBtn = document.getElementById('copy-summary-btn');
      const printBtn = document.getElementById('print-btn');
      const resetBtn = document.getElementById('reset-form-btn');
      
      const STORAGE_KEY = 'edutarbiyah_intake_form_data';

      // 1. Language Toggle Logic
      function setLanguage(lang) {
        currentLang = lang;
        const isUr = lang === 'ur';

        // Toggle button text
        if (langToggleText) {
          langToggleText.textContent = isUr ? 'View in English' : 'اردو میں دیکھیں';
        }

        // Toggle all data-en / data-ur texts
        document.querySelectorAll('[data-en]').forEach((el) => {
          const text = el.getAttribute(`data-${lang}`);
          if (text) {
            el.textContent = text;
          }
        });

        // Toggle placeholders
        document.querySelectorAll('[data-placeholder-en]').forEach((el) => {
          const ph = el.getAttribute(`data-placeholder-${lang}`);
          if (ph) {
            el.setAttribute('placeholder', ph);
          }
        });

        // Toggle direction if desired
        if (isUr) {
          document.body.classList.add('font-urdu');
        } else {
          document.body.classList.remove('font-urdu');
        }
      }

      if (langToggleBtn) {
        langToggleBtn.addEventListener('click', () => {
          setLanguage(currentLang === 'en' ? 'ur' : 'en');
        });
      }

      // 2. Progress Calculation
      const requiredInputs = form.querySelectorAll('[required]');
      function updateProgress() {
        let filledCount = 0;
        const total = requiredInputs.length;

        // Group radios by name
        const radioGroups = new Set();
        requiredInputs.forEach((input) => {
          if (input.type === 'radio') {
            radioGroups.add(input.name);
          } else if (input.value && input.value.trim() !== '') {
            filledCount++;
          }
        });

        radioGroups.forEach((name) => {
          const checked = form.querySelector(`input[name="${name}"]:checked`);
          if (checked) filledCount++;
        });

        // Adjust total accounting for radio groups
        const effectiveTotal = (total - Array.from(form.querySelectorAll('input[type="radio"][required]')).length) + radioGroups.size;
        const percent = Math.min(100, Math.round((filledCount / (effectiveTotal || 1)) * 100));

        if (progressBar) progressBar.style.width = `${percent}%`;
        if (progressText) progressText.textContent = `${percent}%`;
      }

      // 3. LocalStorage Persistence
      function saveFormData() {
        const formData = new FormData(form);
        const data = {};
        for (let [key, val] of formData.entries()) {
          if (key.endsWith('[]')) {
            const cleanKey = key.slice(0, -2);
            if (!data[cleanKey]) data[cleanKey] = [];
            data[cleanKey].push(val);
          } else {
            data[key] = val;
          }
        }
        try {
          localStorage.setItem(STORAGE_KEY, JSON.stringify(data));
        } catch (e) {}
      }

      function loadFormData() {
        try {
          const saved = localStorage.getItem(STORAGE_KEY);
          if (!saved) return;
          const data = JSON.parse(saved);

          for (let key in data) {
            const val = data[key];
            if (Array.isArray(val)) {
              val.forEach((item) => {
                const cb = form.querySelector(`input[name="${key}[]"][value="${item}"]`);
                if (cb) cb.checked = true;
              });
            } else {
              const input = form.querySelector(`[name="${key}"]`);
              if (input) {
                if (input.type === 'radio') {
                  const r = form.querySelector(`input[name="${key}"][value="${val}"]`);
                  if (r) r.checked = true;
                } else {
                  input.value = val;
                }
              }
            }
          }
        } catch (e) {}
      }

      // Live badges for 1-10 scales
      function updateScaleBadges() {
        const intensity = form.querySelector('input[name="intensity"]:checked');
        const intensityBadge = document.getElementById('intensity-val-badge');
        if (intensityBadge) intensityBadge.textContent = intensity ? `${intensity.value} / 10` : 'Not selected';

        const rel = form.querySelector('input[name="relationship_rating"]:checked');
        const relBadge = document.getElementById('rel-val-badge');
        if (relBadge) relBadge.textContent = rel ? `${rel.value} / 10` : 'Not selected';

        const comm = form.querySelector('input[name="communication_rating"]:checked');
        const commBadge = document.getElementById('comm-val-badge');
        if (commBadge) commBadge.textContent = comm ? `${comm.value} / 10` : 'Not selected';
      }

      form.addEventListener('input', () => {
        updateProgress();
        saveFormData();
        updateScaleBadges();
      });

      form.addEventListener('change', () => {
        updateProgress();
        saveFormData();
        updateScaleBadges();
      });

      // 4. Generate Formatted WhatsApp Message
      function generateSummaryText() {
        const d = new FormData(form);
        const getVal = (name) => (d.get(name) || 'Not specified').toString().trim();
        const getAll = (name) => d.getAll(name);

        const behaviors = getAll('behaviors[]').join(', ') || 'None specified';
        const responses = getAll('parent_response[]').join(', ') || 'None specified';
        const issues = getAll('child_issues[]').join(', ') || 'None';

        return `*EDUTARBIYAH PARENTING COACHING INTAKE REPORT*
----------------------------------------
*[1. Parent Information]*
• Parent Name: ${getVal('parent_name')}
• Age: ${getVal('parent_age')}
• Relationship: ${getVal('relationship')}
• Contact (${getVal('contact_method')}): ${getVal('contact_value')}
• Total Children: ${getVal('total_children')}

*[2. Child Profile]*
• Child Name: ${getVal('child_name')}
• Age: ${getVal('child_age')} | Gender: ${getVal('gender')}
• Grade / Level: ${getVal('education_level')}
• Strengths: ${getVal('child_strengths')}

*[3. Core Challenge]*
• Main Reason: ${getVal('main_reason')}
• Behaviors: ${behaviors}
• Duration: ${getVal('duration')} | Frequency: ${getVal('frequency')}
• Problem Intensity: ${getVal('intensity')}/10

*[4. Parental Reaction]*
• Usual Reaction: ${responses}
• Reaction Difficulty: ${getVal('parenting_difficulty')}
• Post-Anger Regret: ${getVal('regret')}

*[5. Relationship & Communication]*
• Relationship Rating: ${getVal('relationship_rating')}/10
• Communication Ease: ${getVal('communication_rating')}/10
• Daily Quality Time: ${getVal('quality_time')}
• Child's Core Need: ${getVal('child_need')}

*[6. Family & Home]*
• Spousal Agreement: ${getVal('parenting_agreement')}
• Family Context: ${getVal('family_situation')}
• External Issues: ${issues}

*[7. Transformation Goals]*
• Goal 1: ${getVal('goal_1')}
• Goal 2: ${getVal('goal_2')}
• Goal 3: ${getVal('goal_3')}
• Major Vision: ${getVal('main_goal')}

*[8. Personal Growth]*
• Desired Habit Change: ${getVal('parent_growth')}
• Coaching Expectation: ${getVal('coaching_expectations')}
• Ready for Assignments: ${getVal('assignments')}

*[9. Notes]*: ${getVal('additional_information')}`;
      }

      // Handle Submit -> Save to Database + WhatsApp
      form.addEventListener('submit', async (e) => {
        e.preventDefault();

        // Check required fields
        let firstInvalid = null;
        requiredInputs.forEach((input) => {
          if (input.type === 'radio') {
            const hasChecked = form.querySelector(`input[name="${input.name}"]:checked`);
            if (!hasChecked && !firstInvalid) firstInvalid = input;
          } else if (!input.value || !input.value.trim()) {
            if (!firstInvalid) firstInvalid = input;
          }
        });

        if (firstInvalid) {
          firstInvalid.scrollIntoView({ behavior: 'smooth', block: 'center' });
          firstInvalid.focus();
          alert(currentLang === 'ur' ? 'براہِ کرم تمام لازمی فیلڈز مکمل کریں۔' : 'Please fill in all required fields marked with * before submitting.');
          return;
        }

        // Collect all form answers for permanent database storage
        const formData = new FormData(form);
        const answers = {};
        formData.forEach((value, key) => {
          if (answers[key]) {
            if (Array.isArray(answers[key])) {
              answers[key].push(value);
            } else {
              answers[key] = [answers[key], value];
            }
          } else {
            answers[key] = value;
          }
        });

        const parentName = getVal('parent_name') || '';
        const phone = getVal('whatsapp_number') || '';
        const email = getVal('email_address') || '';
        const childName = getVal('child_name') || '';
        const childAge = getVal('child_age') || '';

        // Save to WordPress Central Submissions Database
        try {
          await fetch('/wp-json/edutarbiyah/v1/submit-form', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              form_type: 'intake-form',
              form_title: 'Parent-Child Counseling Intake Form',
              user_name: parentName,
              user_phone: phone,
              user_email: email,
              score_summary: `Child: ${childName} (${childAge} yrs)`,
              answers: answers,
            }),
          });
        } catch (saveErr) {
          console.warn('Backend save notice:', saveErr);
        }

        const summary = generateSummaryText();
        const waUrl = `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(summary)}`;
        window.open(waUrl, '_blank');
      });

      // Handle Copy
      if (copyBtn) {
        copyBtn.addEventListener('click', () => {
          const summary = generateSummaryText();
          navigator.clipboard.writeText(summary).then(() => {
            alert(currentLang === 'ur' ? 'تشخیصی رپورٹ کلپ بورڈ پر کاپی ہو گئی!' : 'Diagnostic summary successfully copied to clipboard!');
          });
        });
      }

      // Handle Print
      if (printBtn) {
        printBtn.addEventListener('click', () => {
          window.print();
        });
      }

      // Handle Reset
      if (resetBtn) {
        resetBtn.addEventListener('click', () => {
          if (confirm(currentLang === 'ur' ? 'کیا آپ فارم صاف کرنا چاہتے ہیں؟' : 'Are you sure you want to reset all responses?')) {
            form.reset();
            try {
              localStorage.removeItem(STORAGE_KEY);
            } catch(e) {}
            updateProgress();
            updateScaleBadges();
          }
        });
      }

      // Init on load
      loadFormData();
      updateProgress();
      updateScaleBadges();

    })();
  </script>

</Layout>
