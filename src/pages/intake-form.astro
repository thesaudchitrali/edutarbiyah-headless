---
import Layout from '../layouts/Layout.astro';
import { WHATSAPP_NUMBER } from '../lib/api';
import { 
  ShieldCheck, 
  Clock, 
  Globe, 
  CheckCircle2, 
  Sparkles, 
  MessageCircle, 
  Send, 
  Printer, 
  RotateCcw, 
  ChevronRight, 
  AlertCircle, 
  Check, 
  Heart, 
  User, 
  Baby, 
  Target, 
  Brain, 
  Home, 
  Activity,
  Copy
} from 'lucide-astro';
---

<Layout
  title="Parenting Coaching Intake Form | EduTarbiyah Institute"
  description="Comprehensive diagnostic intake form for parents seeking one-on-one Tarbiyah coaching. Confidentially evaluate your child's needs and set personalized coaching goals."
>

  <!-- Breadcrumbs & Utility -->
  <div class="bg-[#F8FFFC] border-b border-[#0F766E]/10 py-3 px-4 sm:px-6 text-xs text-gray-500">
    <div class="max-w-5xl mx-auto flex items-center justify-between">
      <div class="flex items-center gap-2">
        <a href="/" class="hover:text-[#0F766E] transition-colors">Home</a>
        <ChevronRight class="w-3.5 h-3.5 text-gray-400" />
        <a href="/edutarbiyah-parent-coaching-program/" class="hover:text-[#0F766E] transition-colors">Coaching</a>
        <ChevronRight class="w-3.5 h-3.5 text-gray-400" />
        <span class="text-[#064E3B] font-semibold">Intake Form</span>
      </div>
      <div class="flex items-center gap-3">
        <!-- Bilingual Switcher Toggle -->
        <button
          type="button"
          id="lang-toggle-btn"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-white border border-[#0F766E]/20 text-[#064E3B] font-bold text-xs shadow-sm hover:bg-[#F4F8F6] transition-colors"
          aria-label="Switch Language / زبان تبدیل کریں"
        >
          <Globe class="w-3.5 h-3.5 text-[#0F766E]" />
          <span id="lang-toggle-text">اردو میں دیکھیں</span>
        </button>
      </div>
    </div>
  </div>

  <!-- Hero Header Section -->
  <section class="relative bg-gradient-to-b from-[#064E3B] via-[#095944] to-[#064E3B] text-white py-12 lg:py-16 overflow-hidden">
    <div class="absolute inset-0 opacity-10 bg-[radial-gradient(#F59E0B_1px,transparent_1px)] [background-size:24px_24px] pointer-events-none"></div>

    <div class="relative max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-5">
      
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white/10 text-[#F59E0B] text-xs font-bold tracking-wide uppercase backdrop-blur-md border border-white/15">
        <Sparkles class="w-4 h-4 text-[#F59E0B]" />
        <span data-en="Confidential Diagnostic Assessment" data-ur="محفوظ اور خفیہ تشخیصی فارم">
          Confidential Diagnostic Assessment
        </span>
      </div>

      <h1 class="text-3xl sm:text-5xl font-serif font-extrabold text-white tracking-tight leading-tight">
        <span data-en="Parenting Coaching Intake Form" data-ur="پیرنٹنگ کوچنگ انٹیک فارم">
          Parenting Coaching Intake Form
        </span>
      </h1>

      <p class="text-base sm:text-lg text-[#D1FAE5] max-w-2xl mx-auto leading-relaxed font-normal">
        <span data-en="A few important questions to help us understand your family dynamics, your child's needs, and structure your personalized coaching sessions." data-ur="چند اہم سوالات جو ہمیں آپ کے خاندانی ماحول، بچے کی ضروریات کو سمجھنے اور سیشنز کو نتیجہ خیز بنانے میں مدد دیں گے۔">
          A few important questions to help us understand your family dynamics, your child's needs, and structure your personalized coaching sessions.
        </span>
      </p>

      <!-- Trust Badges -->
      <div class="pt-4 flex flex-wrap items-center justify-center gap-4 text-xs font-medium text-white/90">
        <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-white/10 border border-white/10">
          <ShieldCheck class="w-4 h-4 text-[#F59E0B]" />
          <span data-en="100% Private & Confidential" data-ur="100% نجی اور خفیہ معلومات">100% Private & Confidential</span>
        </span>
        <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-white/10 border border-white/10">
          <Clock class="w-4 h-4 text-[#F59E0B]" />
          <span data-en="Takes 5–7 Minutes" data-ur="صرف 5 سے 7 منٹ درکار">Takes 5–7 Minutes</span>
        </span>
        <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-white/10 border border-white/10">
          <Globe class="w-4 h-4 text-[#F59E0B]" />
          <span data-en="Bilingual: English & Urdu" data-ur="دو لسانی: انگلش اور اردو">Bilingual: English & Urdu</span>
        </span>
      </div>

    </div>
  </section>

  <!-- Sticky Progress & Section Jump Bar -->
  <div class="sticky top-20 z-30 bg-[#FFFDF9]/95 backdrop-blur-md border-b border-gray-200 py-3 px-4 shadow-sm">
    <div class="max-w-5xl mx-auto space-y-2">
      <div class="flex items-center justify-between text-xs font-semibold text-gray-700">
        <span class="flex items-center gap-1.5 text-[#064E3B]">
          <Activity class="w-4 h-4 text-[#0F766E]" />
          <span data-en="Form Completion Progress" data-ur="فارم کی تکمیل کا تناسب">Form Completion Progress</span>
        </span>
        <span id="progress-percentage-text" class="font-mono text-[#0F766E] font-bold">0%</span>
      </div>
      <!-- Progress Bar Track -->
      <div class="w-full h-2 bg-gray-200 rounded-full overflow-hidden">
        <div id="progress-bar-fill" class="h-full bg-gradient-to-r from-[#0F766E] to-[#10B981] transition-all duration-300 w-0"></div>
      </div>
    </div>
  </div>

  <!-- Main Form Content -->
  <main class="py-12 bg-[#FFFDF9]">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <form id="intake-form" class="space-y-10" novalidate>
        
        <!-- ========================================== -->
        <!-- SECTION 1: PARENT INFORMATION -->
        <!-- ========================================== -->
        <div class="bg-white rounded-3xl p-6 sm:p-10 shadow-sm border border-gray-200/80 space-y-6" id="section-1">
          <div class="flex items-center gap-3 border-b border-gray-100 pb-4">
            <span class="w-9 h-9 rounded-2xl bg-emerald-50 text-[#064E3B] font-bold text-sm flex items-center justify-center shrink-0">
              01
            </span>
            <div>
              <h2 class="text-xl sm:text-2xl font-serif font-bold text-[#064E3B]" data-en="1. Parent Information" data-ur="1۔ والدین کی بنیادی معلومات">
                1. Parent Information
              </h2>
              <p class="text-xs sm:text-sm text-gray-500" data-en="Basic details to connect and prepare your session" data-ur="رابطے اور سیشن کی تیاری کے لیے بنیادی تفصیلات">
                Basic details to connect and prepare your session
              </p>
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            
            <!-- Full Name -->
            <div class="space-y-1.5">
              <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider" data-en="Full Name *" data-ur="پورا نام *">
                Full Name *
              </label>
              <input
                type="text"
                name="parent_name"
                required
                class="w-full px-4 py-3 rounded-xl border border-gray-200 text-base sm:text-sm focus:ring-2 focus:ring-[#0F766E] focus:border-transparent outline-none transition-all"
                placeholder="e.g. Ahmad Khan"
                data-placeholder-en="e.g. Ahmad Khan"
                data-placeholder-ur="مثلاً احمد خان"
              />
            </div>

            <!-- Parent Age -->
            <div class="space-y-1.5">
              <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider" data-en="Age *" data-ur="عمر *">
                Age *
              </label>
              <input
                type="number"
                name="parent_age"
                min="18"
                max="85"
                required
                class="w-full px-4 py-3 rounded-xl border border-gray-200 text-base sm:text-sm focus:ring-2 focus:ring-[#0F766E] focus:border-transparent outline-none transition-all"
                placeholder="e.g. 36"
                data-placeholder-en="e.g. 36"
                data-placeholder-ur="مثلاً 36"
              />
            </div>

            <!-- Relationship with Child -->
            <div class="space-y-1.5">
              <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider" data-en="Relationship with Child *" data-ur="بچے سے رشتہ *">
                Relationship with Child *
              </label>
              <select
                name="relationship"
                required
                class="w-full px-4 py-3 rounded-xl border border-gray-200 text-base sm:text-sm bg-white focus:ring-2 focus:ring-[#0F766E] focus:border-transparent outline-none transition-all"
              >
                <option value="" data-en="Select Relationship" data-ur="رشتہ منتخب کریں">Select Relationship</option>
                <option value="Father" data-en="Father" data-ur="والد (Father)">Father</option>
                <option value="Mother" data-en="Mother" data-ur="والدہ (Mother)">Mother</option>
                <option value="Guardian" data-en="Guardian" data-ur="سرپرست (Guardian)">Guardian</option>
                <option value="Other" data-en="Other" data-ur="دیگر">Other</option>
              </select>
            </div>

            <!-- Contact Method -->
            <div class="space-y-1.5">
              <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider" data-en="Preferred Contact Method *" data-ur="رابطے کا ترجیحی ذریعہ *">
                Preferred Contact Method *
              </label>
              <select
                name="contact_method"
                required
                class="w-full px-4 py-3 rounded-xl border border-gray-200 text-base sm:text-sm bg-white focus:ring-2 focus:ring-[#0F766E] focus:border-transparent outline-none transition-all"
              >
                <option value="WhatsApp" data-en="WhatsApp (Recommended)" data-ur="واٹس ایپ (تجویز کردہ)">WhatsApp (Recommended)</option>
                <option value="Phone Call" data-en="Direct Phone Call" data-ur="فون کال">Direct Phone Call</option>
                <option value="Email" data-en="Email" data-ur="ای میل">Email</option>
              </select>
            </div>

            <!-- Contact Value -->
            <div class="space-y-1.5">
              <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider" data-en="Contact Number / Email *" data-ur="فون / واٹس ایپ نمبر یا ای میل *">
                Contact Number / Email *
              </label>
              <input
                type="text"
                name="contact_value"
                required
                class="w-full px-4 py-3 rounded-xl border border-gray-200 text-base sm:text-sm focus:ring-2 focus:ring-[#0F766E] focus:border-transparent outline-none transition-all"
                placeholder="e.g. +92 300 1234567 or email@domain.com"
                data-placeholder-en="e.g. +92 300 1234567 or email@domain.com"
                data-placeholder-ur="مثلاً +92 300 1234567 یا ای میل"
              />
            </div>

            <!-- Total Children -->
            <div class="space-y-1.5">
              <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider" data-en="Total Number of Children *" data-ur="کل کتنے بچے ہیں؟ *">
                Total Number of Children *
              </label>
              <input
                type="number"
                name="total_children"
                min="1"
                max="15"
                required
                class="w-full px-4 py-3 rounded-xl border border-gray-200 text-base sm:text-sm focus:ring-2 focus:ring-[#0F766E] focus:border-transparent outline-none transition-all"
                placeholder="e.g. 3"
                data-placeholder-en="e.g. 3"
                data-placeholder-ur="مثلاً 3"
              />
            </div>

          </div>
        </div>

        <!-- ========================================== -->
        <!-- SECTION 2: CHILD INFORMATION -->
        <!-- ========================================== -->
        <div class="bg-white rounded-3xl p-6 sm:p-10 shadow-sm border border-gray-200/80 space-y-6" id="section-2">
          <div class="flex items-center gap-3 border-b border-gray-100 pb-4">
            <span class="w-9 h-9 rounded-2xl bg-emerald-50 text-[#064E3B] font-bold text-sm flex items-center justify-center shrink-0">
              02
            </span>
            <div>
              <h2 class="text-xl sm:text-2xl font-serif font-bold text-[#064E3B]" data-en="2. Child Information" data-ur="2۔ بچے کی بنیادی معلومات">
                2. Child Information
              </h2>
              <p class="text-xs sm:text-sm text-gray-500" data-en="Provide details about the specific child this coaching session focuses on" data-ur="جس بچے کے بارے میں آپ کوچنگ لینا چاہتے ہیں اس کی تفصیلات">
                Provide details about the specific child this coaching session focuses on
              </p>
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            
            <!-- Child Name -->
            <div class="space-y-1.5">
              <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider" data-en="Child's Name / Nickname *" data-ur="بچے کا نام یا عرفیت *">
                Child's Name / Nickname *
              </label>
              <input
                type="text"
                name="child_name"
                required
                class="w-full px-4 py-3 rounded-xl border border-gray-200 text-base sm:text-sm focus:ring-2 focus:ring-[#0F766E] focus:border-transparent outline-none transition-all"
                placeholder="e.g. Hamza"
                data-placeholder-en="e.g. Hamza"
                data-placeholder-ur="مثلاً حمزہ"
              />
            </div>

            <!-- Child Age -->
            <div class="space-y-1.5">
              <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider" data-en="Child's Age *" data-ur="بچے کی عمر *">
                Child's Age *
              </label>
              <input
                type="number"
                name="child_age"
                min="1"
                max="25"
                required
                class="w-full px-4 py-3 rounded-xl border border-gray-200 text-base sm:text-sm focus:ring-2 focus:ring-[#0F766E] focus:border-transparent outline-none transition-all"
                placeholder="e.g. 10"
                data-placeholder-en="e.g. 10"
                data-placeholder-ur="مثلاً 10"
              />
            </div>

            <!-- Gender -->
            <div class="space-y-1.5 sm:col-span-2">
              <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider" data-en="Gender *" data-ur="جنس *">
                Gender *
              </label>
              <div class="flex items-center gap-4">
                <label class="flex-1 flex items-center justify-center gap-2 p-3.5 rounded-xl border border-gray-200 cursor-pointer hover:border-[#0F766E] transition-all has-[:checked]:bg-emerald-50 has-[:checked]:border-[#0F766E] has-[:checked]:text-[#064E3B] font-semibold text-sm">
                  <input type="radio" name="gender" value="Boy" required class="accent-[#0F766E]" />
                  <span data-en="Boy / لڑکا" data-ur="لڑکا (Boy)">Boy / لڑکا</span>
                </label>
                <label class="flex-1 flex items-center justify-center gap-2 p-3.5 rounded-xl border border-gray-200 cursor-pointer hover:border-[#0F766E] transition-all has-[:checked]:bg-emerald-50 has-[:checked]:border-[#0F766E] has-[:checked]:text-[#064E3B] font-semibold text-sm">
                  <input type="radio" name="gender" value="Girl" class="accent-[#0F766E]" />
                  <span data-en="Girl / لڑکی" data-ur="لڑکی (Girl)">Girl / لڑکی</span>
                </label>
              </div>
            </div>

            <!-- Education Level -->
            <div class="space-y-1.5 sm:col-span-2">
              <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider" data-en="Education Level" data-ur="تعلیمی جماعت / سطح">
                Education Level
              </label>
              <input
                type="text"
                name="education_level"
                class="w-full px-4 py-3 rounded-xl border border-gray-200 text-base sm:text-sm focus:ring-2 focus:ring-[#0F766E] focus:border-transparent outline-none transition-all"
                placeholder="e.g. Grade 5 / Hifz / O-Levels"
                data-placeholder-en="e.g. Grade 5 / Hifz / O-Levels"
                data-placeholder-ur="مثلاً پانچویں جماعت / حفظ / او لیول"
              />
            </div>

            <!-- Three Good Qualities -->
            <div class="space-y-1.5 sm:col-span-2">
              <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider" data-en="Three Good Qualities of Your Child" data-ur="اپنے بچے کی تین اچھی خوبیاں">
                Three Good Qualities of Your Child
              </label>
              <textarea
                name="child_strengths"
                rows="2"
                class="w-full px-4 py-3 rounded-xl border border-gray-200 text-base sm:text-sm focus:ring-2 focus:ring-[#0F766E] focus:border-transparent outline-none transition-all"
                placeholder="e.g. Kind-hearted, creative, helpful, honest..."
                data-placeholder-en="e.g. Kind-hearted, creative, helpful, honest..."
                data-placeholder-ur="مثلاً مددگار، تخلیقی، سچا، نرم دل..."
              ></textarea>
            </div>

          </div>
        </div>

        <!-- ========================================== -->
        <!-- SECTION 3: MAIN PARENTING CHALLENGE -->
        <!-- ========================================== -->
        <div class="bg-white rounded-3xl p-6 sm:p-10 shadow-sm border border-gray-200/80 space-y-6" id="section-3">
          <div class="flex items-center gap-3 border-b border-gray-100 pb-4">
            <span class="w-9 h-9 rounded-2xl bg-emerald-50 text-[#064E3B] font-bold text-sm flex items-center justify-center shrink-0">
              03
            </span>
            <div>
              <h2 class="text-xl sm:text-2xl font-serif font-bold text-[#064E3B]" data-en="3. Main Parenting Challenge" data-ur="3۔ بنیادی Parenting مسئلہ">
                3. Main Parenting Challenge
              </h2>
              <p class="text-xs sm:text-sm text-gray-500" data-en="Identify what is causing frustration and friction at home" data-ur="گھر میں پریشانی کا باعث بننے والے مسائل کی نشاندہی کریں">
                Identify what is causing frustration and friction at home
              </p>
            </div>
          </div>

          <div class="space-y-6">
            
            <!-- Main Reason -->
            <div class="space-y-1.5">
              <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider" data-en="Why are you seeking parenting coaching? *" data-ur="آپ پیرنٹ کوچنگ کیوں لینا چاہتے ہیں؟ *">
                Why are you seeking parenting coaching? *
              </label>
              <textarea
                name="main_reason"
                required
                rows="3"
                class="w-full px-4 py-3 rounded-xl border border-gray-200 text-base sm:text-sm focus:ring-2 focus:ring-[#0F766E] focus:border-transparent outline-none transition-all"
                placeholder="Please describe the core situation, challenges, and what you hope to resolve..."
                data-placeholder-en="Please describe the core situation, challenges, and what you hope to resolve..."
                data-placeholder-ur="براہِ کرم بنیادی مسئلہ اور چیلنجز تفصیل سے بیان کریں..."
              ></textarea>
            </div>

            <!-- Difficult Behaviors Checkboxes -->
            <div class="space-y-2.5">
              <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider" data-en="Which behaviors are most difficult to handle? (Select all that apply)" data-ur="بچے کے کون سے رویے آپ کے لیے سب سے زیادہ مشکل ہیں؟ (تمام متعلقہ منتخب کریں)">
                Which behaviors are most difficult to handle? (Select all that apply)
              </label>

              <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
                {[
                  { id: "Disobedience", en: "Disobedience", ur: "نافرمانی (Disobedience)" },
                  { id: "Anger", en: "Anger & Tantrums", ur: "غصہ اور بد مزاجی" },
                  { id: "Rudeness", en: "Rudeness / Backtalk", ur: "بدتمیزی یا تلخ کلامی" },
                  { id: "Lying", en: "Lying / Dishonesty", ur: "جھوٹ بولنا" },
                  { id: "Screen Time", en: "Excessive Screen Time", ur: "زیادہ اسکرین ٹائم" },
                  { id: "Studies", en: "Lack of Study Focus", ur: "پڑھائی میں عدم دلچسپی" },
                  { id: "Religious", en: "Religious Neglect / Salah", ur: "دینی امور و نماز سے غفلت" },
                  { id: "Sibling Conflict", en: "Sibling Rivalry", ur: "بہن بھائیوں سے جھگڑا" },
                  { id: "Arguing", en: "Arguing with Parents", ur: "والدین سے بحث کرنا" },
                  { id: "School", en: "School / External Issues", ur: "اسکول یا باہر کے مسائل" },
                  { id: "Other", en: "Other Specific Issues", ur: "دیگر مسائل" }
                ].map((item) => (
                  <label class="flex items-center gap-2.5 p-3 rounded-xl border border-gray-200 text-xs font-semibold text-gray-700 cursor-pointer hover:border-[#0F766E] transition-all has-[:checked]:bg-emerald-50 has-[:checked]:border-[#0F766E] has-[:checked]:text-[#064E3B]">
                    <input type="checkbox" name="behaviors[]" value={item.id} class="rounded text-[#0F766E] accent-[#0F766E]" />
                    <span data-en={item.en} data-ur={item.ur}>{item.en}</span>
                  </label>
                ))}
              </div>
            </div>

            <!-- Duration & Frequency -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 pt-2">
              <div class="space-y-1.5">
                <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider" data-en="How long has this been going on?" data-ur="یہ مسئلہ کب سے چل رہا ہے؟">
                  How long has this been going on?
                </label>
                <select name="duration" class="w-full px-4 py-3 rounded-xl border border-gray-200 text-base sm:text-sm bg-white focus:ring-2 focus:ring-[#0F766E] focus:border-transparent outline-none transition-all">
                  <option value="">Select Duration</option>
                  <option value="Less than 1 month" data-en="Less than 1 month" data-ur="1 ماہ سے کم">Less than 1 month</option>
                  <option value="1–6 months" data-en="1–6 months" data-ur="1 سے 6 ماہ">1–6 months</option>
                  <option value="6–12 months" data-en="6–12 months" data-ur="6 سے 12 ماہ">6–12 months</option>
                  <option value="More than 1 year" data-en="More than 1 year" data-ur="1 سال سے زیادہ">More than 1 year</option>
                </select>
              </div>

              <div class="space-y-1.5">
