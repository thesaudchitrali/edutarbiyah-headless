            </div>

            <div class="space-y-1.5">
              <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider" data-en="What do you expect from this coaching program?" data-ur="آپ اس کوچنگ پروگرام سے کیا توقع رکھتے ہیں؟">
                What do you expect from this coaching program?
              </label>
              <textarea
                name="coaching_expectations"
                rows="2"
                class="w-full px-4 py-3 rounded-xl border border-gray-200 text-base sm:text-sm focus:ring-2 focus:ring-[#0F766E] focus:border-transparent outline-none transition-all"
                placeholder="e.g. Practical actionable frameworks, clear diagnosis, accountability..."
                data-placeholder-en="e.g. Practical actionable frameworks, clear diagnosis, accountability..."
                data-placeholder-ur="مثلاً عملی رہنمائی، واضح لائحہ عمل، رہنمائی اور رہنمائی..."
