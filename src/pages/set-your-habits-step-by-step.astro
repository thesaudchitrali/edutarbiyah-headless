---
import Layout from '../layouts/Layout.astro';
import { WHATSAPP_NUMBER } from '../lib/api';
import { 
  Sparkles, 
  CheckCircle2, 
  Target, 
  Calendar, 
  ArrowRight, 
  ArrowLeft, 
  RotateCcw, 
  Printer, 
  MessageCircle, 
  Share2, 
  HelpCircle, 
  Heart, 
  Smile, 
  Clock, 
  BookOpen, 
  Compass, 
  ShieldCheck, 
  Download, 
  Copy, 
  AlertCircle, 
  ChevronRight, 
  Check, 
  Flame, 
  Star, 
  Lightbulb, 
  Zap, 
  User, 
  Award, 
  ExternalLink, 
  Globe,
  Home,
  Users,
  X,
  Smartphone
} from 'lucide-astro';
---

<Layout
  title="7 دن کا اسلامی ہیبٹ میکنگ ٹول | Set Your Habits Step-by-Step | EduTarbiyah"
  description="ایک چھوٹی عادت منتخب کریں، روزانہ 2 منٹ عمل کریں، اور 7 دن کی ٹریکنگ کے ساتھ اپنا تربیتی چارٹ مکمل کریں۔ نبوی طریقہ تربیت اور سائنسی عادات سازی۔"
  canonical="https://edutarbiyah.com/set-your-habits-step-by-step/"
  isUrdu={true}
>

  <!-- Print Specific CSS -->
  <style is:global>
    @media print {
      header, footer, nav, #top-breadcrumbs, #hero-section, #presets-section, #wizard-stepper, #wizard-controls, #framework-section, #faq-section, #cta-section, #floating-whatsapp, #lang-toggle-btn, .no-print {
        display: none !important;
      }
      body {
        background: white !important;
        color: black !important;
        padding: 0 !important;
        margin: 0 !important;
      }
      #printable-habit-card {
        display: block !important;
        border: 2px solid #064E3B !important;
        box-shadow: none !important;
        page-break-inside: avoid !important;
        margin: 20px auto !important;
        max-width: 100% !important;
        padding: 24px !important;
        background: white !important;
      }
      .print-only {
        display: block !important;
      }
    }
  </style>

  <!-- Top Breadcrumbs & Bilingual Toggle -->
  <div id="top-breadcrumbs" class="bg-[#F8FFFC] border-b border-[#0F766E]/10 py-3 px-4 sm:px-6 text-xs text-gray-500" dir="rtl">
    <div class="max-w-5xl mx-auto flex items-center justify-between">
      <div class="flex items-center gap-2">
        <a href="/" class="hover:text-[#0F766E] transition-colors">ہوم</a>
        <ChevronRight class="w-3.5 h-3.5 text-gray-400 rotate-180" />
        <span class="text-gray-400">تربیتی ٹولز</span>
        <ChevronRight class="w-3.5 h-3.5 text-gray-400 rotate-180" />
        <span class="text-[#064E3B] font-semibold" data-en="7-Day Habit Builder" data-ur="7 دن کا ہیبٹ بلڈر">7 دن کا ہیبٹ بلڈر</span>
      </div>
      <div class="flex items-center gap-3">
        <!-- Language Switcher -->
        <button
          type="button"
          id="lang-toggle-btn"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-white border border-[#0F766E]/20 text-[#064E3B] font-bold text-xs shadow-sm hover:bg-[#F4F8F6] transition-colors cursor-pointer"
          aria-label="Switch Language / زبان تبدیل کریں"
        >
          <Globe class="w-3.5 h-3.5 text-[#0F766E]" />
          <span id="lang-toggle-text">English Version</span>
        </button>
      </div>
    </div>
  </div>

  <!-- Hero Header Section -->
  <section id="hero-section" class="relative bg-gradient-to-b from-[#064E3B] via-[#095944] to-[#064E3B] text-white py-12 lg:py-16 overflow-hidden" dir="rtl">
    <div class="absolute inset-0 opacity-10 bg-[radial-gradient(#F59E0B_1px,transparent_1px)] [background-size:24px_24px] pointer-events-none"></div>

    <div class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-6">
      
      <!-- Top Badge -->
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white/10 text-[#F59E0B] text-xs font-bold tracking-wide uppercase backdrop-blur-md border border-white/15">
        <Sparkles class="w-4 h-4 text-[#F59E0B]" />
        <span data-en="The Sunnah of Consistency (Istiqamah)" data-ur="سنتِ استقامت اور چھوٹے مسلسل اعمال">
          سنتِ استقامت اور چھوٹے مسلسل اعمال
        </span>
      </div>

      <!-- Main Headline -->
      <h1 class="text-3xl sm:text-5xl font-serif font-extrabold text-white tracking-tight leading-tight">
        <span data-en="7-Day Tarbiyah Habit Builder" data-ur="7 دن کا اسلامی ہیبٹ بلڈر">
          7 دن کا اسلامی ہیبٹ بلڈر
        </span>
      </h1>

      <!-- Prophetic Hadith Quote Box -->
      <div class="bg-white/10 backdrop-blur-md border border-amber-300/30 rounded-2xl p-5 max-w-2xl mx-auto shadow-inner text-center">
        <p class="font-serif text-amber-200 text-lg sm:text-xl font-bold tracking-wide mb-1" dir="rtl">
          "أَحَبُّ الأَعْمَالِ إِلَى اللَّهِ أَدْوَمُهَا وَإِنْ قَلَّ"
        </p>
        <p class="text-xs sm:text-sm text-emerald-100 italic">
          <span data-en="“The most beloved deeds to Allah are those that are most regular and constant, even if they are small.”" data-ur="”اللہ کے نزدیک سب سے پسندیدہ عمل وہ ہے جو ہمیشہ اور مسلسل کیا جائے، چاہے وہ تھوڑا ہی کیوں نہ ہو۔“">
            ”اللہ کے نزدیک سب سے پسندیدہ عمل وہ ہے جو ہمیشہ اور مسلسل کیا جائے، چاہے وہ تھوڑا ہی کیوں نہ ہو۔“
          </span>
          <span class="block text-amber-300 font-semibold text-[11px] mt-1">— صحیح بخاری (6464)</span>
        </p>
      </div>

      <!-- Hero Subtitle -->
      <p class="text-base sm:text-lg text-[#D1FAE5] max-w-2xl mx-auto leading-relaxed font-normal">
        <span data-en="Turn noble intentions into permanent daily family routines. Follow this step-by-step framework to pick one habit, shrink it into a 2-minute action, anchor it to daily cues, and track your first 7 days." data-ur="نیک ارادوں کو پائیدار خاندانی معمولات میں تبدیل کریں۔ ایک عادت منتخب کریں، اسے 2 منٹ کے آسان عمل میں تبدیل کریں، روزمرہ روٹین کے ساتھ جوڑیں اور اپنے 7 دن کی ٹریکنگ مکمل کریں۔">
          نیک ارادوں کو پائیدار خاندانی معمولات میں تبدیل کریں۔ ایک عادت منتخب کریں، اسے 2 منٹ کے آسان عمل میں تبدیل کریں، روزمرہ روٹین کے ساتھ جوڑیں اور اپنے 7 دن کی ٹریکنگ مکمل کریں۔
        </span>
      </p>

      <!-- Key Pillars Badges -->
      <div class="pt-2 flex flex-wrap justify-center gap-2 sm:gap-3 text-xs sm:text-sm font-medium text-emerald-100">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-white/10 backdrop-blur-sm border border-white/10">
          <CheckCircle2 class="w-4 h-4 text-[#F59E0B]" />
          <span data-en="2-Minute Micro Habit" data-ur="2 منٹ کا مائیکرو عمل">2 منٹ کا مائیکرو عمل</span>
        </span>
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-white/10 backdrop-blur-sm border border-white/10">
          <Clock class="w-4 h-4 text-[#F59E0B]" />
          <span data-en="Anchor Trigger Stacking" data-ur="روٹین اینکر ٹرگر">روٹین اینکر ٹرگر</span>
        </span>
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-white/10 backdrop-blur-sm border border-white/10">
          <Flame class="w-4 h-4 text-[#F59E0B]" />
          <span data-en="7-Day Streak Tracker" data-ur="7 دن کا اسٹریک ٹریکر">7 دن کا اسٹریک ٹریکر</span>
        </span>
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-white/10 backdrop-blur-sm border border-white/10">
          <Printer class="w-4 h-4 text-[#F59E0B]" />
          <span data-en="Printable Fridge Chart" data-ur="پرنٹ ایبل چارٹ">پرنٹ ایبل چارٹ</span>
        </span>
      </div>

    </div>
  </section>

  <!-- Main Container -->
  <main class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-10 lg:py-14 space-y-12" dir="rtl">

    <!-- PRESETS INSPIRATION BAR -->
    <section id="presets-section" class="bg-gradient-to-br from-[#F8FFFC] to-[#FFFDF9] rounded-2xl border border-[#0F766E]/20 p-6 shadow-sm">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-4">
        <div>
          <h2 class="text-lg font-serif font-bold text-[#064E3B] flex items-center gap-2">
            <Lightbulb class="w-5 h-5 text-[#F59E0B]" />
            <span data-en="Need Inspiration? Click a Tarbiyah Preset:" data-ur="فوری رہنمائی چاہیے؟ کسی بھی عادت پر کلک کریں:">
              فوری رہنمائی چاہیے؟ کسی بھی عادت پر کلک کریں:
            </span>
          </h2>
          <p class="text-xs text-gray-500 mt-0.5">
            <span data-en="Selecting a preset pre-fills all steps with proven Islamic parenting best practices." data-ur="کسی بھی عادت پر کلک کرنے سے تمام فیلڈز خودبخود بھر جائیں گی جنہیں آپ تبدیل بھی کر سکتے ہیں۔">
              کسی بھی عادت پر کلک کرنے سے تمام فیلڈز خودبخود بھر جائیں گی جنہیں آپ تبدیل بھی کر سکتے ہیں۔
            </span>
          </p>
        </div>
        <button
          type="button"
          id="clear-form-btn"
          class="text-xs text-gray-400 hover:text-red-600 transition-colors inline-flex items-center gap-1 self-start sm:self-auto cursor-pointer"
        >
          <RotateCcw class="w-3.5 h-3.5" />
          <span data-en="Reset Form" data-ur="فارم صاف کریں">فارم صاف کریں</span>
        </button>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3">
        <!-- Preset 1: Salah / Fajr -->
        <button
          type="button"
          class="preset-card text-right p-3.5 rounded-xl border border-emerald-100 bg-white hover:border-[#0F766E] hover:shadow-md transition-all group cursor-pointer"
          data-for="Myself"
          data-habit-en="Pray Fajr on time without snoozing"
          data-habit-ur="فجر کی نماز الارم پر بنا تاخیر ادا کرنا"
          data-why-en="To start my day under Allah's divine protection and fill our home with early morning Barakah."
          data-why-ur="دن کا آغاز اللہ کی پناہ اور برکت میں کرنے اور اولاد کے لیے عملی نمونہ بننے کے لیے۔"
          data-tiny-en="Sit up and wash face immediately when the alarm rings"
          data-tiny-ur="الارم بجتے ہی فوراً بستر چھوڑ کر وضو کرنا"
          data-trigger-en="Immediately after hearing the Fajr alarm / Adhan"
          data-trigger-ur="فجر کا الارم یا اذان سنتے ہی فوراً"
          data-reward-en="A peaceful hot cup of tea + sincere Alhamdulillah"
          data-reward-ur="پرسکون چائے کا گھونٹ اور دل سے الحمدللہ کہنا"
        >
          <div class="flex items-center gap-2 font-bold text-sm text-[#064E3B] group-hover:text-[#0F766E]">
            <Compass class="w-4 h-4 text-[#0F766E]" />
            <span data-en="Fajr / Salah on Time" data-ur="وقت پر نماز / فجر">وقت پر نماز / فجر</span>
          </div>
          <p class="text-xs text-gray-500 mt-1 line-clamp-1">
            <span data-en="Trigger: Fajr Adhan • Tiny: Wash face" data-ur="ٹرگر: اذان سنتے ہی • عمل: فوراً وضو">ٹرگر: اذان سنتے ہی • عمل: فوراً وضو</span>
          </p>
        </button>

        <!-- Preset 2: Family Quran -->
        <button
          type="button"
          class="preset-card text-right p-3.5 rounded-xl border border-emerald-100 bg-white hover:border-[#0F766E] hover:shadow-md transition-all group cursor-pointer"
          data-for="My Child"
          data-habit-en="Daily 10-Minute Family Quran & Meaning"
          data-habit-ur="روزانہ 10 منٹ بچوں کے ساتھ قرآن و ترجمہ"
          data-why-en="Connecting my children's hearts with the Quran so it guides their decisions and values."
          data-why-ur="بچوں کے دلوں کو قرآن سے جوڑنا تاکہ ان کے اخلاق اور فیصلوں میں اللہ کا نور شامل ہو۔"
          data-tiny-en="Read just 3 verses of Surah with translation"
          data-tiny-ur="روزانہ صرف 3 آیات ترجمے کے ساتھ پڑھنا"
          data-trigger-en="Right after Maghrib prayer / dinner"
          data-trigger-ur="مغرب کی نماز کے فوراً بعد"
          data-reward-en="Warm family group hug + collective Dua"
          data-reward-ur="بچوں کو پیار سے گلے لگانا اور خصوصی دعا"
        >
          <div class="flex items-center gap-2 font-bold text-sm text-[#064E3B] group-hover:text-[#0F766E]">
            <BookOpen class="w-4 h-4 text-[#0F766E]" />
            <span data-en="10-Min Family Quran" data-ur="10 منٹ فیملی قرآن">10 منٹ فیملی قرآن</span>
          </div>
          <p class="text-xs text-gray-500 mt-1 line-clamp-1">
            <span data-en="Trigger: After Maghrib • Tiny: 3 Ayahs" data-ur="ٹرگر: بعد مغرب • عمل: صرف 3 آیات">ٹرگر: بعد مغرب • عمل: صرف 3 آیات</span>
          </p>
        </button>

        <!-- Preset 3: Emotional Calm -->
        <button
          type="button"
          class="preset-card text-right p-3.5 rounded-xl border border-emerald-100 bg-white hover:border-[#0F766E] hover:shadow-md transition-all group cursor-pointer"
          data-for="Myself"
          data-habit-en="Gentle Calm Parenting / No Shouting"
          data-habit-ur="غصے اور چیخ و پکار کے بغیر پرسکون تربیت"
          data-why-en="To model the gentle forbearance (Hilm) of Rasulullah ﷺ and protect my child's emotional safety."
          data-why-ur="نبی کریم ﷺ کے حلم اور نرمی کی سنت اپنانے اور بچے کی نفسیات کو محفوظ رکھنے کے لیے۔"
          data-tiny-en="Pause, take 3 slow deep breaths, and say Ta'awwudh"
          data-tiny-ur="بولنے سے پہلے 3 گہرے سانس اور اعوذ باللہ پڑھنا"
          data-trigger-en="Whenever I feel sudden anger or frustration rising"
          data-trigger-ur="جب بھی غصہ اور چڑچڑاہٹ محسوس ہو"
          data-reward-en="Deep inner tranquility and self-respect"
          data-reward-ur="دلی سکون اور اللہ کے شکر کا احساس"
        >
          <div class="flex items-center gap-2 font-bold text-sm text-[#064E3B] group-hover:text-[#0F766E]">
            <Heart class="w-4 h-4 text-teal-600" />
            <span data-en="Calm Reactions / No Shouting" data-ur="بغیر چیخے پرسکون رہنا">بغیر چیخے پرسکون رہنا</span>
          </div>
          <p class="text-xs text-gray-500 mt-1 line-clamp-1">
            <span data-en="Trigger: When triggered • Tiny: 3 Breaths" data-ur="ٹرگر: جب غصہ آئے • عمل: 3 گہرے سانس">ٹرگر: جب غصہ آئے • عمل: 3 گہرے سانس</span>
          </p>
        </button>

        <!-- Preset 4: Bedtime Prophetic Story -->
        <button
          type="button"
          class="preset-card text-right p-3.5 rounded-xl border border-emerald-100 bg-white hover:border-[#0F766E] hover:shadow-md transition-all group cursor-pointer"
          data-for="My Child"
          data-habit-en="Nightly Bedtime Seerah & Prophets Story"
          data-habit-ur="سونے سے پہلے سیرت النبی ﷺ کا مختصر قصہ"
          data-why-en="To build immense love for the Prophet ﷺ in my child before they close their eyes each night."
          data-why-ur="بچے کے دل میں رسول اللہ ﷺ کی محبت بٹھانا اور دن کا اختتام خیر پر کرنا۔"
          data-tiny-en="Read just 1 page or 2 minutes of a Seerah story"
          data-tiny-ur="سیرت کی کتاب کا صرف ایک صفحہ پڑھنا"
          data-trigger-en="Right after changing into pajamas and climbing into bed"
          data-trigger-ur="نائٹ ڈریس پہن کر بستر پر بیٹھنے کے بعد"
          data-reward-en="Forehead kiss, Ayat-ul-Kursi & warm goodnight Dua"
          data-reward-ur="ماتھے پر بوسہ، آیت الکرسی اور دعائے خیر"
        >
          <div class="flex items-center gap-2 font-bold text-sm text-[#064E3B] group-hover:text-[#0F766E]">
            <BookOpen class="w-4 h-4 text-amber-600" />
            <span data-en="Bedtime Seerah Story" data-ur="سونے سے پہلے سیرت قصہ">سونے سے پہلے سیرت قصہ</span>
          </div>
          <p class="text-xs text-gray-500 mt-1 line-clamp-1">
            <span data-en="Trigger: In bed • Tiny: 1 Page" data-ur="ٹرگر: بستر پر • عمل: صرف 1 صفحہ">ٹرگر: بستر پر • عمل: صرف 1 صفحہ</span>
          </p>
        </button>

        <!-- Preset 5: Child Morning Bed-Making -->
        <button
          type="button"
          class="preset-card text-right p-3.5 rounded-xl border border-emerald-100 bg-white hover:border-[#0F766E] hover:shadow-md transition-all group cursor-pointer"
          data-for="My Child"
          data-habit-en="Child makes their bed & tidies up blanket"
          data-habit-ur="بچے کا صبح اٹھ کر اپنا بستر اور کمبل درست کرنا"
          data-why-en="Instilling self-discipline, neatness, and Sunnah habit of cleanliness as early responsibility."
          data-why-ur="بچے میں خود انحصاری، صفائی ستھرائی اور ذمہ داری کا احساس اجاگر کرنا۔"
          data-tiny-en="Pull up bedsheet neatly and arrange 1 pillow"
          data-tiny-ur="چادر کھینچ کر تکیہ سیدھا رکھنا"
          data-trigger-en="Right after feet touch the floor in the morning"
          data-trigger-ur="صبح بستر سے اٹھتے ہی فوراً"
          data-reward-en="Parent cheerful high-five + Star on habit chart"
          data-reward-ur="والدین کی شاباش، ہائی فائیو اور چارٹ پر اسٹار"
        >
          <div class="flex items-center gap-2 font-bold text-sm text-[#064E3B] group-hover:text-[#0F766E]">
            <Home class="w-4 h-4 text-[#0F766E]" />
            <span data-en="Bed-Making & Tidy Room" data-ur="بستر اور کمرے کی صفائی">بستر اور کمرے کی صفائی</span>
          </div>
          <p class="text-xs text-gray-500 mt-1 line-clamp-1">
            <span data-en="Trigger: Wake up • Tiny: Pull sheet" data-ur="ٹرگر: اٹھتے ہی • عمل: چادر سیدھی کرنا">ٹرگر: اٹھتے ہی • عمل: چادر سیدھی کرنا</span>
          </p>
        </button>

        <!-- Preset 6: Sunnah Gratitude / Dining -->
        <button
          type="button"
          class="preset-card text-right p-3.5 rounded-xl border border-emerald-100 bg-white hover:border-[#0F766E] hover:shadow-md transition-all group cursor-pointer"
          data-for="Myself"
          data-habit-en="Daily 3-Gratitudes (Shukr) at the Dining Table"
          data-habit-ur="کھانے کی میز پر اللہ کا شکر (3 نعمتوں کا ذکر)"
          data-why-en="Cultivating a grateful heart (Qalb Shakir) that sees Allah's blessings in both ease and hardship."
          data-why-ur="گھر میں شکر گزاری کی فضا قائم کرنا اور نعمتوں کی قدر سکھانا۔"
          data-tiny-en="Name 1 blessing aloud before leaving the table"
          data-tiny-ur="کھانا ختم کر کے ایک نعمت کا نام بلند آواز سے لینا"
          data-trigger-en="Right after finishing the last bite of dinner"
          data-trigger-ur="کھانے کا آخری نوالہ مکمل کرنے کے بعد"
          data-reward-en="Heartfelt 'Alhamdulillah' shared by the whole family"
