  <!-- Interactive Client-side Script -->
  <script is:inline define:vars={{ WHATSAPP_NUMBER }}>
    (function() {
      // Default to Urdu on this URL
      let currentStep = 1;
      const totalSteps = 7;
      let currentLang = 'ur';

      const STORAGE_KEY = 'edutarbiyah_habit_builder_v2';

      // Elements
      const stepBadge = document.getElementById('step-number-badge');
      const stepTitleDisplay = document.getElementById('step-title-display');
      const progressBar = document.getElementById('wizard-progress-bar');
      const progressPercent = document.getElementById('progress-percent');
      const prevBtn = document.getElementById('prev-step-btn');
      const nextBtn = document.getElementById('next-step-btn');
      const nextBtnText = document.getElementById('next-btn-text');
      const langToggleBtn = document.getElementById('lang-toggle-btn');
      const langToggleText = document.getElementById('lang-toggle-text');

      // Inputs
      const inputName = document.getElementById('input-name');
      const selectHabitFor = document.getElementById('select-habit-for');
      const inputChild = document.getElementById('input-child');
      const inputHabit = document.getElementById('input-habit');
      const inputWhy = document.getElementById('input-why');
      const inputTiny = document.getElementById('input-tiny');
      const inputTrigger = document.getElementById('input-trigger');
      const inputReward = document.getElementById('input-reward');

      // Displays on Chart
      const displayName = document.getElementById('display-name');
      const displayTarget = document.getElementById('display-target');
      const displayTrigger = document.getElementById('display-trigger');
      const displayTiny = document.getElementById('display-tiny');
      const displayReward = document.getElementById('display-reward');
      const displayWhy = document.getElementById('display-why');
      const daysCountDisplay = document.getElementById('days-completed-count');
      const scoreBadge = document.getElementById('score-percent-badge');
      const scoreFeedback = document.getElementById('score-feedback-text');

      // Step Titles
      const stepTitlesEn = [
        'Step 1: Who is Building This Habit?',
        'Step 2: Choose ONE Specific Habit',
        'Step 3: Why Is This Habit Important?',
        'Step 4: Make It Tiny (2-Minute Rule)',
        'Step 5: Choose an Anchor Trigger',
        'Step 6: Choose an Immediate Reward',
        'Step 7: 7-Day Live Tracker & Streak'
      ];

      const stepTitlesUr = [
        'مرحلہ 1: یہ عادت کون اپنا رہا ہے؟',
        'مرحلہ 2: ایک واضح عادت کا انتخاب کریں',
        'مرحلہ 3: یہ عادت کیوں ضروری ہے؟',
        'مرحلہ 4: عادت کو چھوٹا اور آسان بنائیں',
        'مرحلہ 5: یاد دہانی اور ٹرگر کا انتخاب',
        'مرحلہ 6: فوری انعام اور جشن طے کریں',
        'مرحلہ 7: 7 دن کی لائیو ٹریکنگ'
      ];

      // Update Stepper View
      function updateStepView() {
        for (let i = 1; i <= totalSteps; i++) {
          const panel = document.getElementById('step-panel-' + i);
          if (panel) {
            if (i === currentStep) {
              panel.classList.remove('hidden');
            } else {
              panel.classList.add('hidden');
            }
          }
        }

        // Stepper dots
        document.querySelectorAll('.step-dot').forEach((dot) => {
          const s = parseInt(dot.getAttribute('data-step') || '1');
          if (s === currentStep) {
            dot.classList.add('font-bold', 'text-[#064E3B]');
            dot.classList.remove('text-gray-400');
          } else if (s < currentStep) {
            dot.classList.add('text-[#0F766E]');
            dot.classList.remove('text-gray-400', 'font-bold');
          } else {
            dot.classList.remove('font-bold', 'text-[#064E3B]', 'text-[#0F766E]');
            dot.classList.add('text-gray-400');
          }
        });

        // Badge & Title
        if (stepBadge) stepBadge.textContent = currentStep;
        if (stepTitleDisplay) {
          stepTitleDisplay.textContent = currentLang === 'ur'
            ? stepTitlesUr[currentStep - 1]
            : stepTitlesEn[currentStep - 1];
        }

        // Progress Percent
        const percent = Math.round((currentStep / totalSteps) * 100);
        if (progressBar) progressBar.style.width = percent + '%';
        if (progressPercent) progressPercent.textContent = percent + '%';

        // Prev / Next Buttons
        if (currentStep === 1) {
          if (prevBtn) prevBtn.classList.add('hidden');
        } else {
          if (prevBtn) prevBtn.classList.remove('hidden');
        }

        if (currentStep === totalSteps) {
          if (nextBtnText) {
            nextBtnText.textContent = currentLang === 'ur' ? 'چارٹ دیکھیں' : 'View Pledge Chart';
          }
        } else {
          if (nextBtnText) {
            nextBtnText.textContent = currentLang === 'ur' ? 'اگلا مرحلہ' : 'Next Step';
          }
        }

        updateLiveDisplays();
      }

      // Live Displays Sync
      function updateLiveDisplays() {
        const nameVal = inputName?.value.trim() || (currentLang === 'ur' ? 'میرا نام' : 'Your Name');
        const habitForVal = selectHabitFor?.value || 'Myself';
        const childVal = inputChild?.value.trim();
        const triggerVal = inputTrigger?.value.trim() || (currentLang === 'ur' ? '[روٹین اینکر ٹرگر]' : '[e.g. After Fajr Prayer]');
        const tinyVal = inputTiny?.value.trim() || inputHabit?.value.trim() || (currentLang === 'ur' ? '[چھوٹا عمل]' : '[e.g. Read 5 minutes]');
        const rewardVal = inputReward?.value.trim() || (currentLang === 'ur' ? '[فوری انعام]' : '[e.g. Sincere Alhamdulillah]');
        const whyVal = inputWhy?.value.trim() || (currentLang === 'ur' ? '[یہ عادت ہمارے گھر میں برکت اور سکون لائے گی]' : '[Write your why to see it displayed here...]');

        if (displayName) displayName.textContent = nameVal;
        
        let targetText = habitForVal;
        if (habitForVal === 'My Child' && childVal) {
          targetText = `${childVal} (بچہ)`;
        } else if (habitForVal === 'Both Parent & Child' && childVal) {
          targetText = `والدین اور ${childVal}`;
        }
        if (displayTarget) displayTarget.textContent = targetText;

        if (displayTrigger) displayTrigger.textContent = triggerVal;
        if (displayTiny) displayTiny.textContent = tinyVal;
        if (displayReward) displayReward.textContent = rewardVal;
        if (displayWhy) displayWhy.textContent = `"${whyVal}"`;

        updateTrackerScore();
      }

      function updateTrackerScore() {
        const checkboxes = document.querySelectorAll('.day-checkbox');
        let completed = 0;
        checkboxes.forEach((cb, index) => {
          const dayNum = index + 1;
          const chartCircle = document.getElementById('chart-check-' + dayNum);
          const badge = cb.closest('.day-card')?.querySelector('.day-badge');

          if (cb.checked) {
            completed++;
            if (chartCircle) {
              chartCircle.innerHTML = `<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>`;
              chartCircle.classList.remove('border-dashed', 'border-gray-300', 'border-[#0F766E]');
              chartCircle.classList.add('bg-[#064E3B]', 'text-white', 'border-solid', 'border-[#064E3B]');
            }
            if (badge) {
              badge.textContent = currentLang === 'ur' ? 'مکمل!' : 'Done!';
              badge.classList.remove('bg-gray-100', 'text-gray-500');
              badge.classList.add('bg-emerald-100', 'text-[#064E3B]');
            }
          } else {
            if (chartCircle) {
              chartCircle.innerHTML = String(dayNum);
              chartCircle.classList.remove('bg-[#064E3B]', 'text-white', 'border-solid');
              chartCircle.classList.add('border-dashed', 'border-gray-300');
            }
            if (badge) {
              badge.textContent = currentLang === 'ur' ? 'باقی ہے' : 'Pending';
              badge.classList.remove('bg-emerald-100', 'text-[#064E3B]');
              badge.classList.add('bg-gray-100', 'text-gray-500');
            }
          }
        });

        if (daysCountDisplay) daysCountDisplay.textContent = completed;
        const score = Math.round((completed / 7) * 100);
        if (scoreBadge) scoreBadge.textContent = score + '%';

        if (scoreFeedback) {
          if (score >= 80) {
            scoreFeedback.innerHTML = currentLang === 'ur'
              ? '<strong class="text-[#064E3B]">ماشاءاللہ شاندار استقامت!</strong> عادت مضبوط ہو چکی ہے۔ اگلے ہفتے بھی یہی تسلسل رکھیں۔'
              : '<strong class="text-[#064E3B]">Outstanding Istiqamah!</strong> You have built real momentum. Keep this daily chain going!';
          } else if (score >= 50) {
            scoreFeedback.innerHTML = currentLang === 'ur'
              ? '<strong class="text-[#0F766E]">بہترین آغاز!</strong> آدھے سے زیادہ دن مکمل ہو گئے۔ اپنے اینکر ٹرگر کو مضبوط بنائیں۔'
              : '<strong class="text-[#0F766E]">Great Progress!</strong> Consistency is a muscle. Reinforce your anchor trigger.';
          } else {
            scoreFeedback.innerHTML = currentLang === 'ur'
              ? '<strong class="text-gray-700">چھوٹا بیج بو دیا گیا ہے۔</strong> اگر ناغہ ہوا ہو تو عادت کو مزید چھوٹا کریں اور دوبارہ بسم اللہ کریں۔'
              : '<strong class="text-gray-700">Keep going!</strong> Consistency beats intensity. Shrink the habit size if needed and restart with Bismillah.';
          }
        }
      }

      // Navigation Handlers
      if (nextBtn) {
        nextBtn.addEventListener('click', () => {
          if (currentStep < totalSteps) {
            currentStep++;
            updateStepView();
            saveToStorage();
            document.getElementById('wizard-stepper')?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
          } else {
            document.getElementById('printable-habit-card')?.scrollIntoView({ behavior: 'smooth' });
          }
        });
      }

      if (prevBtn) {
        prevBtn.addEventListener('click', () => {
          if (currentStep > 1) {
            currentStep--;
            updateStepView();
          }
        });
      }

      // Dot click handler
      document.querySelectorAll('.step-dot').forEach((dot) => {
        dot.addEventListener('click', () => {
          const s = parseInt(dot.getAttribute('data-step') || '1');
          currentStep = s;
          updateStepView();
        });
      });

      // Quick Chips (Habit Categories)
      document.querySelectorAll('.quick-chip').forEach((chip) => {
        chip.addEventListener('click', () => {
          if (inputHabit) {
            inputHabit.value = chip.textContent.trim().replace(/^[^\w\s\u0600-\u06FF]+/, '').trim();
            updateLiveDisplays();
          }
        });
      });

      // Trigger Chips
      document.querySelectorAll('.trigger-chip').forEach((chip) => {
        chip.addEventListener('click', () => {
          if (inputTrigger) {
            inputTrigger.value = chip.textContent.trim();
            updateLiveDisplays();
          }
        });
      });

      // Presets Handler
      document.querySelectorAll('.preset-card').forEach((card) => {
        card.addEventListener('click', () => {
          const isUr = currentLang === 'ur';
          const habitVal = isUr ? card.getAttribute('data-habit-ur') : card.getAttribute('data-habit-en');
          const whyVal = isUr ? card.getAttribute('data-why-ur') : card.getAttribute('data-why-en');
          const tinyVal = isUr ? card.getAttribute('data-tiny-ur') : card.getAttribute('data-tiny-en');
          const triggerVal = isUr ? card.getAttribute('data-trigger-ur') : card.getAttribute('data-trigger-en');
          const rewardVal = isUr ? card.getAttribute('data-reward-ur') : card.getAttribute('data-reward-en');
          const forVal = card.getAttribute('data-for') || 'Myself';

          if (selectHabitFor) selectHabitFor.value = forVal;
          if (inputHabit && habitVal) inputHabit.value = habitVal;
          if (inputWhy && whyVal) inputWhy.value = whyVal;
          if (inputTiny && tinyVal) inputTiny.value = tinyVal;
          if (inputTrigger && triggerVal) inputTrigger.value = triggerVal;
          if (inputReward && rewardVal) inputReward.value = rewardVal;

          updateLiveDisplays();
          saveToStorage();

          currentStep = 2;
          updateStepView();
          document.getElementById('wizard-stepper')?.scrollIntoView({ behavior: 'smooth' });
        });
      });

      // Input change event listeners
      [inputName, selectHabitFor, inputChild, inputHabit, inputWhy, inputTiny, inputTrigger, inputReward].forEach((el) => {
        if (el) {
          el.addEventListener('input', () => {
            updateLiveDisplays();
            saveToStorage();
          });
        }
      });

      // Checkbox changes
      document.querySelectorAll('.day-checkbox').forEach((cb) => {
        cb.addEventListener('change', () => {
          updateTrackerScore();
          saveToStorage();
        });
      });

      document.querySelectorAll('.day-note').forEach((note) => {
        note.addEventListener('input', () => {
          saveToStorage();
        });
      });

      // Local Storage Save/Load
      function saveToStorage() {
        try {
          const notes = [];
          document.querySelectorAll('.day-note').forEach((n) => notes.push(n.value));

          const checks = [];
          document.querySelectorAll('.day-checkbox').forEach((c) => checks.push(c.checked));

          const data = {
            name: inputName?.value || '',
            habitFor: selectHabitFor?.value || 'Myself',
            child: inputChild?.value || '',
            habit: inputHabit?.value || '',
            why: inputWhy?.value || '',
            tiny: inputTiny?.value || '',
            trigger: inputTrigger?.value || '',
            reward: inputReward?.value || '',
            currentStep,
            currentLang,
            checks,
            notes
          };
          localStorage.setItem(STORAGE_KEY, JSON.stringify(data));
        } catch (e) {
          // ignore
        }
      }

      function loadFromStorage() {
        try {
          const raw = localStorage.getItem(STORAGE_KEY);
          if (!raw) return;
          const data = JSON.parse(raw);

          if (inputName && data.name) inputName.value = data.name;
          if (selectHabitFor && data.habitFor) selectHabitFor.value = data.habitFor;
          if (inputChild && data.child) inputChild.value = data.child;
          if (inputHabit && data.habit) inputHabit.value = data.habit;
          if (inputWhy && data.why) inputWhy.value = data.why;
          if (inputTiny && data.tiny) inputTiny.value = data.tiny;
          if (inputTrigger && data.trigger) inputTrigger.value = data.trigger;
          if (inputReward && data.reward) inputReward.value = data.reward;

          if (data.currentStep && data.currentStep >= 1 && data.currentStep <= totalSteps) {
            currentStep = data.currentStep;
          }

          if (Array.isArray(data.checks)) {
            const boxes = document.querySelectorAll('.day-checkbox');
            data.checks.forEach((val, i) => {
              if (boxes[i]) boxes[i].checked = !!val;
            });
          }

          if (Array.isArray(data.notes)) {
            const noteEls = document.querySelectorAll('.day-note');
            data.notes.forEach((val, i) => {
              if (noteEls[i]) noteEls[i].value = val || '';
            });
          }

          updateStepView();
        } catch (e) {
          // ignore
        }
      }

      // Manual Save Button
      const saveBtn = document.getElementById('save-local-btn');
      if (saveBtn) {
        saveBtn.addEventListener('click', () => {
          saveToStorage();
          const orig = saveBtn.innerHTML;
          saveBtn.innerHTML = `<span class="font-bold">${currentLang === 'ur' ? 'محفوظ ہو گیا!' : 'Saved!'}</span>`;
          setTimeout(() => {
            saveBtn.innerHTML = orig;
          }, 2000);
        });
      }

      // Reset Form Button
      const clearBtn = document.getElementById('clear-form-btn');
      if (clearBtn) {
        clearBtn.addEventListener('click', () => {
          if (confirm(currentLang === 'ur' ? 'کیا آپ تمام فارم ڈیٹا صاف کرنا چاہتے ہیں؟' : 'Are you sure you want to reset this habit form?')) {
            localStorage.removeItem(STORAGE_KEY);
            location.reload();
          }
        });
      }

      // Print Button
      const printBtn = document.getElementById('print-chart-btn');
      if (printBtn) {
        printBtn.addEventListener('click', () => {
          window.print();
        });
      }

      // WhatsApp Commit Button
      const waBtn = document.getElementById('whatsapp-commit-btn');
      if (waBtn) {
        waBtn.addEventListener('click', () => {
          const name = inputName?.value.trim() || 'Parent';
          const habitFor = selectHabitFor?.value || 'Myself';
          const child = inputChild?.value.trim();
          const habit = inputHabit?.value.trim() || 'Daily Tarbiyah Habit';
          const tiny = inputTiny?.value.trim() || habit;
          const trigger = inputTrigger?.value.trim() || 'Daily routine';
          const reward = inputReward?.value.trim() || 'Praise & Dua';
          const why = inputWhy?.value.trim() || '';

          const checkboxes = document.querySelectorAll('.day-checkbox');
          let completed = 0;
          checkboxes.forEach((cb) => { if (cb.checked) completed++; });

          const text = 
`السلام علیکم EduTarbiyah ٹیم,
میرا 7 دن کا تربیتی ہیبٹ پلان:

• نام: ${name}
• عادت کس کے لیے: ${habitFor}${child ? ` (${child})` : ''}
• منتخب عادت: ${habit}
• 2 منٹ کا مائیکرو عمل: ${tiny}
• اینکر ٹرگر: ${trigger}
• انعام: ${reward}
• نیت و اہمیت: ${why}

• ریکارڈ: 7 میں سے ${completed} دن مکمل (${Math.round((completed/7)*100)}%)

میں یہ معلومات رہنمائی اور بہتری کے لیے شیئر کر رہا/رہی ہوں۔ جزاکم اللہ خیراً!`;

          const cleanPhone = (WHATSAPP_NUMBER || '923122370720').replace(/[^0-9]/g, '');
          const waUrl = `https://wa.me/${cleanPhone}?text=${encodeURIComponent(text)}`;
          window.open(waUrl, '_blank');
        });
      }

      // Copy Text Button
      const copyBtn = document.getElementById('copy-pledge-btn');
      const copyTextEl = document.getElementById('copy-btn-text');
      if (copyBtn) {
        copyBtn.addEventListener('click', () => {
          const name = inputName?.value.trim() || 'والدین';
          const trigger = inputTrigger?.value.trim() || '[اینکر ٹرگر]';
          const tiny = inputTiny?.value.trim() || '[چھوٹا عمل]';
          const reward = inputReward?.value.trim() || '[انعام]';
          const why = inputWhy?.value.trim() || '';

          const text = `تربیتی خاندانی عہد نامہ:
میں، ${name}، عہد کرتا/کرتی ہوں کہ:
جب بھی: ${trigger}
تو میں عمل کروں گا: ${tiny}
انعام: ${reward}
اہمیت: ${why}
(ادارہ ایجو تربیہ - EduTarbiyah.com)`;

          navigator.clipboard.writeText(text).then(() => {
