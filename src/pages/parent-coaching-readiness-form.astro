      function etpcBuildQuestions() {
        const wrap = document.getElementById("etpcQuestions");
        if (!wrap) return;
        wrap.innerHTML = "";

        const isUr = currentLang === 'ur';

        etpcData.forEach((section, sIndex) => {
          const box = document.createElement("div");
          box.className = "bg-white rounded-3xl border border-gray-200/80 shadow-md p-6 sm:p-8 space-y-6";

          const title = isUr ? section.titleUr : section.titleEn;
          const questions = isUr ? section.questionsUr : section.questionsEn;

          let html = `
            <div class="flex items-center gap-3 pb-4 border-b border-gray-100">
              <span class="p-2.5 rounded-2xl bg-emerald-50 border border-emerald-100 flex items-center justify-center shrink-0">${section.iconSvg}</span>
              <div>
                <span class="text-[11px] font-bold text-[#0F766E] uppercase tracking-wider block">Pillar ${sIndex + 1} of 6</span>
                <h3 class="text-lg sm:text-xl font-serif font-extrabold text-[#064E3B]">${title}</h3>
              </div>
            </div>
            <div class="space-y-5">
          `;

          questions.forEach((q, qIndex) => {
            const name = `etpc_q_${sIndex}_${qIndex}`;
            const qNum = sIndex * 3 + qIndex + 1;

            html += `
              <div class="p-4 rounded-2xl bg-[#FBFDFC] border border-gray-200/80 hover:border-[#0F766E]/30 transition-all space-y-3">
                <div class="text-sm sm:text-base font-bold text-gray-800 leading-snug">
                  <span class="text-[#0F766E]">${qNum}.</span> ${q}
                </div>
                <div class="grid grid-cols-3 gap-2 sm:gap-3 text-xs sm:text-sm font-semibold">
                  <label class="etpc-radio-label flex items-center justify-center gap-2 p-2.5 sm:p-3 rounded-xl border border-gray-200 bg-white hover:bg-rose-50 hover:border-rose-300 text-gray-700 cursor-pointer transition-all text-center">
                    <input type="radio" name="${name}" value="3" class="w-4 h-4 text-rose-600 focus:ring-rose-500 cursor-pointer" />
                    <span>${isUr ? 'اکثر' : 'Often (3)'}</span>
                  </label>
                  <label class="etpc-radio-label flex items-center justify-center gap-2 p-2.5 sm:p-3 rounded-xl border border-gray-200 bg-white hover:bg-amber-50 hover:border-amber-300 text-gray-700 cursor-pointer transition-all text-center">
                    <input type="radio" name="${name}" value="2" class="w-4 h-4 text-amber-600 focus:ring-amber-500 cursor-pointer" />
                    <span>${isUr ? 'کبھی کبھار' : 'Sometimes (2)'}</span>
                  </label>
                  <label class="etpc-radio-label flex items-center justify-center gap-2 p-2.5 sm:p-3 rounded-xl border border-gray-200 bg-white hover:bg-emerald-50 hover:border-emerald-300 text-gray-700 cursor-pointer transition-all text-center">
                    <input type="radio" name="${name}" value="1" class="w-4 h-4 text-emerald-600 focus:ring-emerald-500 cursor-pointer" />
                    <span>${isUr ? 'شاذونادر' : 'Rarely (1)'}</span>
                  </label>
                </div>
              </div>
            `;
          });

          html += `</div>`;
          box.innerHTML = html;
          wrap.appendChild(box);
        });

        // Add change listeners
        wrap.querySelectorAll('input[type="radio"]').forEach((radio) => {
          radio.addEventListener('change', () => {
            const parentRow = radio.closest('.grid');
            if (parentRow) {
              parentRow.querySelectorAll('.etpc-radio-label').forEach((lbl) => {
                lbl.classList.remove('border-[#0F766E]', 'bg-[#0F766E]/10', 'font-bold', 'shadow-sm');
                lbl.classList.add('border-gray-200', 'bg-white');
              });
              const activeLabel = radio.closest('.etpc-radio-label');
              if (activeLabel && radio.checked) {
                activeLabel.classList.remove('border-gray-200', 'bg-white');
                activeLabel.classList.add('border-[#0F766E]', 'bg-[#0F766E]/10', 'font-bold', 'shadow-sm');
              }
            }
            etpcCalculate(false);
            etpcSaveSilent();
          });
        });
      }

      function etpcGetAnswers() {
        let total = 0;
        let answered = 0;
        let often = 0;
        let sometimes = 0;
        let rarely = 0;
        const sectionScores = [0, 0, 0, 0, 0, 0];

        etpcData.forEach((section, sIndex) => {
          section.questionsEn.forEach((q, qIndex) => {
            const selected = document.querySelector(`input[name="etpc_q_${sIndex}_${qIndex}"]:checked`);
            if (selected) {
              const val = parseInt(selected.value, 10);
              total += val;
              answered++;
              sectionScores[sIndex] += val;
              if (val === 3) often++;
              if (val === 2) sometimes++;
              if (val === 1) rarely++;
            }
          });
        });

        return { total, answered, often, sometimes, rarely, sectionScores };
      }

      function etpcCalculate(forceFull = false) {
        const ans = etpcGetAnswers();
        const maxScore = 54;
        const percent = Math.round((ans.total / maxScore) * 100);

        const scoreEl = document.getElementById("etpcTotalScore");
        const oftenEl = document.getElementById("etpcOftenCount");
        const answeredEl = document.getElementById("etpcAnswered");
        const percentEl = document.getElementById("etpcPercent");
        const fillEl = document.getElementById("etpcProgressFill");
        const resultTitle = document.getElementById("etpcResultTitle");
        const resultText = document.getElementById("etpcResultText");
        const badgeCategory = document.getElementById("etpcBadgeCategory");
        const scoreDisplay = document.getElementById("etpcResultScoreDisplay");
        const breakdownWrap = document.getElementById("pillar-breakdown");

        if (scoreEl) scoreEl.textContent = ans.total;
        if (oftenEl) oftenEl.textContent = ans.often;
        if (answeredEl) answeredEl.textContent = ans.answered + "/18";
        if (percentEl) percentEl.textContent = percent + "%";
        if (fillEl) fillEl.style.width = Math.round((ans.answered / 18) * 100) + "%";
        if (scoreDisplay) scoreDisplay.textContent = percent + "%";

        const isUr = currentLang === 'ur';

        if (ans.answered < 18 && !forceFull) {
          if (badgeCategory) {
            badgeCategory.textContent = isUr ? `${ans.answered}/18 سوالات مکمل` : `${ans.answered}/18 Questions Answered`;
          }
          if (resultText) {
            resultText.textContent = isUr 
              ? "درست نتیجہ اور سفارشات حاصل کرنے کے لیے تمام 18 سوالات کے جواب منتخب کریں۔"
              : "Please complete all 18 questions to generate your full diagnostic recommendation.";
          }
          return;
        }

        // Assessment threshold
        if (ans.total >= 42 || ans.often >= 8) {
          if (resultTitle) {
            resultTitle.textContent = isUr ? "Parent Coaching آپ کے لیے انتہائی مفید اور ضروری ہے" : "1-on-1 Parent Coaching is Highly Recommended";
          }
          if (badgeCategory) {
            badgeCategory.textContent = isUr ? "[شدید ضرورت] High Priority Coaching Need" : "High Priority Coaching Need";
          }
          if (resultText) {
            resultText.textContent = isUr
              ? "آپ کے جوابات واضح کرتے ہیں کہ بچے کے رویّے، باہمی تعلق، غصے یا روٹین میں کئی جگہ فوری رہنمائی کی ضرورت ہے۔ پرانے طریقے بار بار دہرانے کے بجائے ون آن ون کوچنگ سے مخصوص روڈ میپ بنائیں۔"
              : "Your responses indicate urgent friction in child compliance, emotional regulation, and routine consistency. A customized 1-on-1 coaching protocol will bring immediate de-escalation and structured relief to your home.";
          }
        } else if (ans.total >= 30 || ans.often >= 4) {
          if (resultTitle) {
            resultTitle.textContent = isUr ? "Parent Coaching آپ کے خاندان کے لیے بہت مددگار ثابت ہوگی" : "Parent Coaching Can Provide Crucial Support";
          }
          if (badgeCategory) {
            badgeCategory.textContent = isUr ? "[درمیانی ضرورت] Moderate Support Needed" : "Moderate Structured Support Needed";
          }
          if (resultText) {
            resultText.textContent = isUr
              ? "آپ کے جوابات کے مطابق کچھ اہم شعبوں میں رہنمائی، مستقل مزاجی اور مثبت حکمتِ عملی کی ضرورت ہے۔ آپ ون ٹو ون کوچنگ، TPPC کورس یا انٹیک فارم کے ذریعے رہنمائی لے سکتے ہیں۔"
              : "Your parenting foundation is intact, but specific friction areas require consistent tools and non-punitive strategies. You will benefit immensely from structured coaching sessions or our TPPC Practitioner Course.";
          }
        } else {
          if (resultTitle) {
            resultTitle.textContent = isUr ? "آپ کی تربیتی بنیاد مضبوط ہے، مزید تسلسل برقرار رکھیں" : "Strong Parenting Foundation; Deepen Consistency";
          }
          if (badgeCategory) {
            badgeCategory.textContent = isUr ? "[تسلسل و دیکھ بھال] Foundational Maintenance" : "Strong Foundation (Maintenance)";
          }
          if (resultText) {
            resultText.textContent = isUr
              ? "ماشاءاللہ آپ کے گھر کا ماحول نسبتاً متوازن ہے۔ باقاعدہ روٹین، صبر اور مثبت گفتگو کو برقرار رکھنے کے لیے ایجو تربیہ کی کتب، فری گائیڈز اور بلاگز سے فائدہ اٹھاتے رہیں۔"
              : "Alhamdulillah, your responses indicate a generally balanced home atmosphere. Continue nurturing communication and daily spiritual habits using EduTarbiyah publications, articles, and habit builders.";
          }
        }

        // Render breakdown cards
        if (breakdownWrap) {
          breakdownWrap.innerHTML = "";
          etpcData.forEach((sec, i) => {
            const sc = ans.sectionScores[i];
            const pTitle = isUr ? sec.titleUr : sec.titleEn;
            const card = document.createElement("div");
            card.className = "p-3 rounded-xl bg-white border border-gray-200 text-xs space-y-1 shadow-sm";
            card.innerHTML = `
              <div class="flex items-center justify-between font-bold text-gray-800">
                <span class="truncate">${pTitle}</span>
                <span class="${sc >= 7 ? 'text-rose-600' : sc >= 5 ? 'text-amber-600' : 'text-emerald-700'}">${sc}/9</span>
              </div>
              <div class="w-full bg-gray-100 h-1.5 rounded-full overflow-hidden">
                <div class="${sc >= 7 ? 'bg-rose-500' : sc >= 5 ? 'bg-amber-500' : 'bg-emerald-500'} h-full" style="width: ${Math.round((sc/9)*100)}%;"></div>
              </div>
            `;
            breakdownWrap.appendChild(card);
          });
        }
      }

      function etpcSaveSilent() {
        try {
          const data = {
            parentName: document.getElementById("etpcParentName")?.value || "",
            childName: document.getElementById("etpcChildName")?.value || "",
            childAge: document.getElementById("etpcChildAge")?.value || "",
            date: document.getElementById("etpcDate")?.value || "",
            whatsapp: document.getElementById("etpcWhatsapp")?.value || "",
            email: document.getElementById("etpcEmail")?.value || "",
            challenge: document.getElementById("etpcChallenge")?.value || "",
            currentLang,
            answers: {}
          };

          etpcData.forEach((section, sIndex) => {
            section.questionsEn.forEach((q, qIndex) => {
              const name = `etpc_q_${sIndex}_${qIndex}`;
              const selected = document.querySelector(`input[name="${name}"]:checked`);
              data.answers[name] = selected ? selected.value : "";
            });
          });

          localStorage.setItem(STORAGE_KEY, JSON.stringify(data));
        } catch (e) {}
      }

      function etpcLoad() {
        const saved = localStorage.getItem(STORAGE_KEY);
        if (!saved) return;

        try {
          const data = JSON.parse(saved);

          if (document.getElementById("etpcParentName") && data.parentName) document.getElementById("etpcParentName").value = data.parentName;
          if (document.getElementById("etpcChildName") && data.childName) document.getElementById("etpcChildName").value = data.childName;
          if (document.getElementById("etpcChildAge") && data.childAge) document.getElementById("etpcChildAge").value = data.childAge;
          if (document.getElementById("etpcDate") && data.date) document.getElementById("etpcDate").value = data.date;
          if (document.getElementById("etpcWhatsapp") && data.whatsapp) document.getElementById("etpcWhatsapp").value = data.whatsapp;
          if (document.getElementById("etpcEmail") && data.email) document.getElementById("etpcEmail").value = data.email;
          if (document.getElementById("etpcChallenge") && data.challenge) document.getElementById("etpcChallenge").value = data.challenge;

          if (data.currentLang) {
            setLanguage(data.currentLang);
          }

          if (data.answers) {
            Object.keys(data.answers).forEach((name) => {
              const val = data.answers[name];
              if (val) {
                const radio = document.querySelector(`input[name="${name}"][value="${val}"]`);
                if (radio) radio.checked = true;
              }
            });
          }

          etpcCalculate(false);
        } catch (e) {}
      }

      // Manual Save Button
      const saveBtn = document.getElementById("btn-save");
      const saveText = document.getElementById("save-btn-text");
      if (saveBtn) {
        saveBtn.addEventListener("click", () => {
          etpcSaveSilent();
          if (saveText) saveText.textContent = currentLang === 'ur' ? 'محفوظ ہو گیا!' : 'Saved!';
          setTimeout(() => {
            if (saveText) saveText.textContent = currentLang === 'ur' ? 'محفوظ کریں' : 'Save';
          }, 2000);
        });
      }

      // Print Button
      const printBtn = document.getElementById("btn-print");
      if (printBtn) {
        printBtn.addEventListener("click", () => {
          etpcCalculate(true);
          window.print();
        });
      }

      // Clear / Reset Button
      const clearBtn = document.getElementById("clear-form-btn");
      if (clearBtn) {
        clearBtn.addEventListener("click", () => {
          if (confirm(currentLang === 'ur' ? "کیا آپ فارم صاف کرنا چاہتے ہیں؟" : "Are you sure you want to reset this readiness assessment?")) {
            localStorage.removeItem(STORAGE_KEY);
            location.reload();
          }
        });
      }

      // WhatsApp Button
      const waBtn = document.getElementById("btn-whatsapp");
      if (waBtn) {
        waBtn.addEventListener("click", () => {
          etpcCalculate(true);
          const ans = etpcGetAnswers();

          const parentName = document.getElementById("etpcParentName")?.value || "Parent";
          const childName = document.getElementById("etpcChildName")?.value || "Child";
          const childAge = document.getElementById("etpcChildAge")?.value || "Not provided";
          const whatsapp = document.getElementById("etpcWhatsapp")?.value || "Not provided";
          const challenge = document.getElementById("etpcChallenge")?.value || "Not provided";
          const resultTitle = document.getElementById("etpcResultTitle")?.textContent || "";
          const resultCategory = document.getElementById("etpcBadgeCategory")?.textContent || "";
          const percent = document.getElementById("etpcPercent")?.textContent || "0%";

          const message = 
`Assalam u Alaikum EduTarbiyah Coaching Team,
Here is my Parent Coaching Readiness Self-Assessment:

• Parent: ${parentName}
• Child: ${childName} (${childAge})
• Contact: ${whatsapp}

• Diagnostic Score: ${ans.total}/54 (${percent})
• Status: ${resultCategory}
• Frequent ('Often') Issues: ${ans.often} / 18

• Biggest Parenting Challenge:
"${challenge}"

I am seeking guidance regarding 1-on-1 Parent Coaching with an EduTarbiyah specialist. JazakAllah Khair!`;

          const cleanPhone = (WHATSAPP_NUMBER || '923122370720').replace(/[^0-9]/g, '');
          const waUrl = `https://wa.me/${cleanPhone}?text=${encodeURIComponent(message)}`;
          window.open(waUrl, "_blank");
        });
      }

      // Input changes save
      document.querySelectorAll('#etpcParentName, #etpcChildName, #etpcChildAge, #etpcDate, #etpcWhatsapp, #etpcEmail, #etpcChallenge').forEach((el) => {
        el.addEventListener('input', () => {
          etpcSaveSilent();
        });
      });

      // Language Switcher Logic
      function setLanguage(lang) {
        currentLang = lang;
        const isUr = lang === 'ur';

        const langToggleText = document.getElementById("lang-toggle-text");
        if (langToggleText) {
          langToggleText.textContent = isUr ? 'View in English' : 'اردو میں دیکھیں';
        }

        document.documentElement.dir = isUr ? 'rtl' : 'ltr';
        document.documentElement.lang = isUr ? 'ur' : 'en';

        // Translate data-en and data-ur text nodes
        document.querySelectorAll('[data-en][data-ur]').forEach((el) => {
          const txt = isUr ? el.getAttribute('data-ur') : el.getAttribute('data-en');
          if (txt) el.textContent = txt;
        });

        // Translate Placeholders
        const pName = document.getElementById("etpcParentName");
        const cName = document.getElementById("etpcChildName");
        const cAge = document.getElementById("etpcChildAge");
        const cChallenge = document.getElementById("etpcChallenge");

        if (pName) pName.placeholder = isUr ? 'مثلاً عائشہ / فاروق' : 'e.g. Ayesha / Farooq';
        if (cName) cName.placeholder = isUr ? 'مثلاً ابراہیم' : 'e.g. Ibrahim';
        if (cAge) cAge.placeholder = isUr ? 'مثلاً 7 سال' : 'e.g. 7 years';
        if (cChallenge) cChallenge.placeholder = isUr ? 'اپنا سب سے بڑا چیلنج بیان کریں (مثلاً ضد، غصہ، اسکرین کی عادت، نماز میں سستی)...' : 'Describe your current struggle (e.g. bedtime resistance, intense shouting matches, phone addiction)...';

        // Rebuild questions with current language while preserving answers
        const oldAnswers = {};
        document.querySelectorAll('input[type="radio"]:checked').forEach((r) => {
          oldAnswers[r.name] = r.value;
        });

        etpcBuildQuestions();

        Object.keys(oldAnswers).forEach((name) => {
          const radio = document.querySelector(`input[name="${name}"][value="${oldAnswers[name]}"]`);
          if (radio) radio.checked = true;
        });

        etpcCalculate(false);
        etpcSaveSilent();
      }

      const langToggleBtn = document.getElementById("lang-toggle-btn");
      if (langToggleBtn) {
        langToggleBtn.addEventListener("click", () => {
          const next = currentLang === 'en' ? 'ur' : 'en';
          setLanguage(next);
        });
      }

      // Initial Setup
      etpcBuildQuestions();
      etpcLoad();
    })();
  </script>

</Layout>
