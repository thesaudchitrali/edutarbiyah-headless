---
import Layout from '../layouts/Layout.astro';
import { WHATSAPP_NUMBER } from '../lib/api';
import { 
  Sparkles, 
  CheckCircle2, 
  Target, 
  Heart, 
  Shield, 
  ShieldCheck, 
  Flame, 
  Compass, 
  Clock, 
  BookOpen, 
  User, 
  Users, 
  MessageCircle, 
  AlertCircle, 
  ArrowRight, 
  ArrowLeft, 
  RotateCcw, 
  Printer, 
  Share2, 
  HelpCircle, 
  Download, 
  Copy, 
  ChevronRight, 
  Check, 
  Star, 
  Lightbulb, 
  Zap, 
  Award, 
  ExternalLink, 
  Globe,
  Activity,
  Brain,
  Home,
  FileText
} from 'lucide-astro';
---

<Layout
  title="Parent Coaching Readiness Form | Diagnostic Self-Assessment | EduTarbiyah"
  description="Evaluate your child's behavior, parenting challenges, and emotional connection to determine if 1-on-1 personalized parenting coaching is right for your family."
  canonical="https://edutarbiyah.com/parent-coaching-readiness-form/"
>

  <!-- Print Specific CSS -->
  <style is:global>
    @media print {
      header, footer, nav, #top-breadcrumbs, #hero-section, #actions-toolbar, #framework-section, #faq-section, #cta-section, #floating-whatsapp, #lang-toggle-btn, .no-print {
        display: none !important;
      }
      body {
        background: white !important;
        color: black !important;
        padding: 0 !important;
        margin: 0 !important;
      }
      #printable-assessment-report {
        display: block !important;
        border: 2px solid #064E3B !important;
        box-shadow: none !important;
        page-break-inside: avoid !important;
        margin: 15px auto !important;
        max-width: 100% !important;
        padding: 20px !important;
        background: white !important;
      }
      .print-only {
        display: block !important;
      }
    }
  </style>

  <!-- Top Breadcrumbs & Bilingual Toggle -->
  <div id="top-breadcrumbs" class="bg-[#F8FFFC] border-b border-[#0F766E]/10 py-3 px-4 sm:px-6 text-xs text-gray-500">
    <div class="max-w-5xl mx-auto flex items-center justify-between">
      <div class="flex items-center gap-2">
        <a href="/" class="hover:text-[#0F766E] transition-colors">Home</a>
        <ChevronRight class="w-3.5 h-3.5 text-gray-400" />
        <a href="/edutarbiyah-parent-coaching-program/" class="hover:text-[#0F766E] transition-colors">Coaching</a>
        <ChevronRight class="w-3.5 h-3.5 text-gray-400" />
        <span class="text-[#064E3B] font-semibold" data-en="Readiness Form" data-ur="ریڈینس فارم">Readiness Form</span>
      </div>
      <div class="flex items-center gap-3">
        <!-- Language Switcher -->
        <button
          type="button"
          id="lang-toggle-btn"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-white border border-[#0F766E]/20 text-[#064E3B] font-bold text-xs shadow-sm hover:bg-[#F4F8F6] transition-colors cursor-pointer"
          aria-label="Switch Language / زبان تبدیل کریں"
        >
          <Globe class="w-3.5 h-3.5 text-[#0F766E]" />
          <span id="lang-toggle-text">اردو میں دیکھیں</span>
        </button>
      </div>
    </div>
  </div>

  <!-- Hero Header Section -->
  <section id="hero-section" class="relative bg-gradient-to-b from-[#064E3B] via-[#095944] to-[#064E3B] text-white py-12 lg:py-16 overflow-hidden">
    <div class="absolute inset-0 opacity-10 bg-[radial-gradient(#F59E0B_1px,transparent_1px)] [background-size:24px_24px] pointer-events-none"></div>

    <div class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-6">
      
      <!-- Top Badge -->
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white/10 text-[#F59E0B] text-xs font-bold tracking-wide uppercase backdrop-blur-md border border-white/15">
        <ShieldCheck class="w-4 h-4 text-[#F59E0B]" />
        <span data-en="Confidential Parenting Assessment" data-ur="محفوظ اور خود تشخیصی جائزہ">
          Confidential Parenting Assessment
        </span>
      </div>

      <!-- Main Headline -->
      <h1 class="text-3xl sm:text-5xl font-serif font-extrabold text-white tracking-tight leading-tight">
        <span data-en="Parent Coaching Readiness Form" data-ur="پیرنٹ کوچنگ ریڈینس فارم">
          Parent Coaching Readiness Form
        </span>
      </h1>

      <!-- Subtitle Question -->
      <div class="inline-block bg-white/10 border border-emerald-300/30 rounded-full px-5 py-2 text-sm sm:text-base font-semibold text-emerald-100">
        <span data-en="Do You Need 1-on-1 Parent Coaching? Self-Diagnostic Assessment" data-ur="کیا آپ کو پیرنٹ کوچنگ کی ضرورت ہے؟ خود جائزہ فارم">
          Do You Need 1-on-1 Parent Coaching? Self-Diagnostic Assessment
        </span>
      </div>

      <!-- Hero Subtitle -->
      <p class="text-base sm:text-lg text-[#D1FAE5] max-w-2xl mx-auto leading-relaxed font-normal">
        <span data-en="Use this self-assessment to reflect on your child's behavior, family stress points, and routine hurdles to determine whether personalized one-on-one coaching will transform your parenting journey." data-ur="اس فارم کی مدد سے اپنے بچے کے رویّے، اپنی والدینی چیلنجز، اور اس بات پر غور کریں کہ آیا ون ٹو ون پیرنٹ کوچنگ آپ کے خاندان کے لیے مفید ہوسکتی ہے۔">
          Use this self-assessment to reflect on your child's behavior, family stress points, and routine hurdles to determine whether personalized one-on-one coaching will transform your parenting journey.
        </span>
      </p>

      <!-- How to Use Banner -->
      <div class="bg-white/10 backdrop-blur-md border border-white/15 rounded-2xl p-4 max-w-2xl mx-auto text-xs sm:text-sm text-emerald-100 space-y-1">
        <p class="font-bold text-amber-300" data-en="How to Complete:" data-ur="طریقہ استعمال:">
          How to Complete:
        </p>
        <p data-en="Answer each of the 18 questions by selecting 'Often' (3 pts), 'Sometimes' (2 pts), or 'Rarely' (1 pt). If you find multiple 'Often' responses, 1-on-1 coaching can provide crucial clarity and structured relief." data-ur="ہر سوال کے جواب میں ”اکثر“، ”کبھی کبھار“ یا ”شاذونادر“ منتخب کریں۔ آخر میں نتیجہ دیکھیں۔ اگر کئی جگہ ”اکثر“ آتا ہے تو Parent Coaching آپ کے لیے انتہائی مفید ہوسکتی ہے۔">
          Answer each of the 18 questions by selecting 'Often' (3 pts), 'Sometimes' (2 pts), or 'Rarely' (1 pt). If you find multiple 'Often' responses, 1-on-1 coaching can provide crucial clarity and structured relief.
        </p>
      </div>

      <!-- Key Pillars Badges -->
      <div class="pt-2 flex flex-wrap justify-center gap-2 sm:gap-3 text-xs sm:text-sm font-medium text-emerald-100">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-white/10 backdrop-blur-sm border border-white/10">
          <Activity class="w-4 h-4 text-[#F59E0B]" />
          <span data-en="6 Tarbiyah Dimensions" data-ur="6 تربیتی جہات">6 Tarbiyah Dimensions</span>
        </span>
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-white/10 backdrop-blur-sm border border-white/10">
          <Brain class="w-4 h-4 text-[#F59E0B]" />
          <span data-en="18 Diagnostic Questions" data-ur="18 تشخیصی سوالات">18 Diagnostic Questions</span>
        </span>
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-white/10 backdrop-blur-sm border border-white/10">
          <Flame class="w-4 h-4 text-[#F59E0B]" />
          <span data-en="Instant Score & Need Meter" data-ur="لائیو نتیجہ اور ضرورت کا انڈیکس">Instant Score & Need Meter</span>
        </span>
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-white/10 backdrop-blur-sm border border-white/10">
          <Printer class="w-4 h-4 text-[#F59E0B]" />
          <span data-en="Printable Diagnostic Report" data-ur="پرنٹ ایبل تشخیصی رپورٹ">Printable Diagnostic Report</span>
        </span>
      </div>

    </div>
  </section>

  <!-- Main Container -->
  <main class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-10 lg:py-14 space-y-12">

    <!-- FLOATING LIVE STATS BAR -->
    <div class="sticky top-4 z-30 bg-white/95 backdrop-blur-md rounded-2xl border border-[#0F766E]/20 shadow-lg p-4 sm:p-5 transition-all">
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 sm:gap-4 text-center">
        <!-- Metric 1: Total Score -->
        <div class="p-2 sm:p-3 rounded-xl bg-[#F8FFFC] border border-[#0F766E]/15">
          <span class="text-[11px] font-bold text-gray-500 uppercase tracking-wider block" data-en="Total Score" data-ur="کل اسکور">
            Total Score
          </span>
          <div class="text-xl sm:text-2xl font-serif font-extrabold text-[#064E3B] mt-0.5">
            <span id="etpcTotalScore">0</span> <span class="text-xs font-sans font-normal text-gray-400">/ 54</span>
          </div>
        </div>

        <!-- Metric 2: Often Count -->
        <div class="p-2 sm:p-3 rounded-xl bg-amber-50/70 border border-amber-200/60">
          <span class="text-[11px] font-bold text-amber-800 uppercase tracking-wider block" data-en="'Often' Selected" data-ur="اکثر منتخب">
            'Often' Selected
          </span>
          <div class="text-xl sm:text-2xl font-serif font-extrabold text-amber-700 mt-0.5" id="etpcOftenCount">
            0
          </div>
        </div>

        <!-- Metric 3: Answered -->
        <div class="p-2 sm:p-3 rounded-xl bg-[#F8FFFC] border border-[#0F766E]/15">
          <span class="text-[11px] font-bold text-gray-500 uppercase tracking-wider block" data-en="Answered" data-ur="جوابات مکمل">
            Answered
          </span>
          <div class="text-xl sm:text-2xl font-serif font-extrabold text-[#0F766E] mt-0.5" id="etpcAnswered">
            0/18
          </div>
        </div>

        <!-- Metric 4: Coaching Need % -->
        <div class="p-2 sm:p-3 rounded-xl bg-teal-50/70 border border-teal-200/60">
          <span class="text-[11px] font-bold text-teal-800 uppercase tracking-wider block" data-en="Coaching Need" data-ur="کوچنگ کی ضرورت">
            Coaching Need
          </span>
          <div class="text-xl sm:text-2xl font-serif font-extrabold text-teal-700 mt-0.5" id="etpcPercent">
            0%
          </div>
        </div>
      </div>

      <!-- Real-time Progress Bar Track -->
      <div class="w-full bg-gray-100 h-2 rounded-full overflow-hidden mt-3">
        <div
          id="etpcProgressFill"
          class="bg-gradient-to-r from-[#0F766E] to-[#10B981] h-full rounded-full transition-all duration-300"
          style="width: 0%;"
        ></div>
      </div>
    </div>

    <!-- PARENT & FAMILY BASIC DETAILS CARD -->
    <section class="bg-white rounded-3xl border border-gray-200/80 shadow-md p-6 sm:p-8 space-y-6">
      <div class="flex items-center justify-between border-b border-gray-100 pb-4">
        <div>
          <div class="inline-flex items-center gap-1.5 text-xs font-bold text-[#0F766E] uppercase tracking-wider mb-1">
            <User class="w-4 h-4" />
            <span data-en="Part 1: Family Context" data-ur="حصہ اول: بنیادی معلومات">Part 1: Family Context</span>
          </div>
          <h2 class="text-xl sm:text-2xl font-serif font-extrabold text-[#064E3B]">
            <span data-en="Family & Child Information" data-ur="بنیادی معلومات">Family & Child Information</span>
          </h2>
        </div>
        <button
          type="button"
          id="clear-form-btn"
          class="text-xs text-gray-400 hover:text-red-600 transition-colors inline-flex items-center gap-1 cursor-pointer"
        >
          <RotateCcw class="w-3.5 h-3.5" />
          <span data-en="Reset Form" data-ur="فارم صاف کریں">Reset Form</span>
        </button>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
        <!-- Parent Name -->
        <div class="space-y-1.5">
          <label for="etpcParentName" class="block text-xs font-bold text-gray-700 uppercase tracking-wider">
            <span data-en="Parent Name" data-ur="والد / والدہ کا نام">Parent Name</span>
            <span class="text-red-500">*</span>
          </label>
          <input
            type="text"
            id="etpcParentName"
            class="w-full px-4 py-3 rounded-xl border border-gray-300 focus:border-[#0F766E] focus:ring-2 focus:ring-[#0F766E]/20 text-gray-900 placeholder-gray-400 text-base sm:text-sm shadow-sm transition-all outline-none"
            placeholder="e.g. Ayesha / Farooq"
          />
        </div>

        <!-- Child Name -->
        <div class="space-y-1.5">
          <label for="etpcChildName" class="block text-xs font-bold text-gray-700 uppercase tracking-wider">
            <span data-en="Child's Name" data-ur="بچے کا نام">Child's Name</span>
            <span class="text-red-500">*</span>
          </label>
          <input
            type="text"
            id="etpcChildName"
            class="w-full px-4 py-3 rounded-xl border border-gray-300 focus:border-[#0F766E] focus:ring-2 focus:ring-[#0F766E]/20 text-gray-900 placeholder-gray-400 text-base sm:text-sm shadow-sm transition-all outline-none"
            placeholder="e.g. Ibrahim"
          />
        </div>

        <!-- Child Age -->
        <div class="space-y-1.5">
          <label for="etpcChildAge" class="block text-xs font-bold text-gray-700 uppercase tracking-wider">
            <span data-en="Child's Age" data-ur="بچے کی عمر">Child's Age</span>
          </label>
          <input
            type="text"
            id="etpcChildAge"
            class="w-full px-4 py-3 rounded-xl border border-gray-300 focus:border-[#0F766E] focus:ring-2 focus:ring-[#0F766E]/20 text-gray-900 placeholder-gray-400 text-base sm:text-sm shadow-sm transition-all outline-none"
            placeholder="e.g. 7 years"
          />
        </div>

        <!-- WhatsApp -->
        <div class="space-y-1.5">
          <label for="etpcWhatsapp" class="block text-xs font-bold text-gray-700 uppercase tracking-wider">
            <span data-en="WhatsApp Number" data-ur="WhatsApp نمبر">WhatsApp Number</span>
          </label>
          <input
            type="text"
            id="etpcWhatsapp"
            class="w-full px-4 py-3 rounded-xl border border-gray-300 focus:border-[#0F766E] focus:ring-2 focus:ring-[#0F766E]/20 text-gray-900 placeholder-gray-400 text-base sm:text-sm shadow-sm transition-all outline-none"
            placeholder="e.g. +92 300 1234567"
          />
        </div>

        <!-- Email -->
        <div class="space-y-1.5">
          <label for="etpcEmail" class="block text-xs font-bold text-gray-700 uppercase tracking-wider">
            <span data-en="Email Address" data-ur="ای میل">Email Address</span>
          </label>
          <input
            type="email"
            id="etpcEmail"
            class="w-full px-4 py-3 rounded-xl border border-gray-300 focus:border-[#0F766E] focus:ring-2 focus:ring-[#0F766E]/20 text-gray-900 placeholder-gray-400 text-base sm:text-sm shadow-sm transition-all outline-none"
            placeholder="e.g. name@example.com"
          />
        </div>

        <!-- Date -->
        <div class="space-y-1.5">
          <label for="etpcDate" class="block text-xs font-bold text-gray-700 uppercase tracking-wider">
            <span data-en="Assessment Date" data-ur="تاریخ">Assessment Date</span>
          </label>
          <input
            type="date"
            id="etpcDate"
            class="w-full px-4 py-3 rounded-xl border border-gray-300 focus:border-[#0F766E] focus:ring-2 focus:ring-[#0F766E]/20 text-gray-900 text-base sm:text-sm shadow-sm transition-all outline-none"
          />
        </div>
      </div>

      <!-- Challenge Reflection -->
      <div class="space-y-2 pt-2">
        <label for="etpcChallenge" class="block text-sm font-bold text-gray-700">
          <span data-en="My biggest parenting challenge right now is:" data-ur="اس وقت میری سب سے بڑی پیرنٹنگ چیلنج یہ ہے:">
            My biggest parenting challenge right now is:
          </span>
        </label>
        <textarea
          id="etpcChallenge"
          rows="3"
          class="w-full px-4 py-3 rounded-xl border border-gray-300 focus:border-[#0F766E] focus:ring-2 focus:ring-[#0F766E]/20 text-gray-900 placeholder-gray-400 text-base sm:text-sm shadow-sm transition-all outline-none"
          placeholder="Describe your current struggle (e.g. bedtime resistance, intense shouting matches, phone addiction, disrespectful tone, lack of prayer routine)..."
        ></textarea>
      </div>
    </section>

    <!-- 18 DIAGNOSTIC QUESTIONS SECTION (6 PILLARS) -->
    <section class="space-y-8" id="et-parent-coaching-form">
      <div>
        <div class="inline-flex items-center gap-1.5 text-xs font-bold text-[#0F766E] uppercase tracking-wider mb-1">
          <Activity class="w-4 h-4" />
          <span data-en="Part 2: Diagnostic Evaluation" data-ur="حصہ دوم: 18 تشخیصی سوالات">Part 2: Diagnostic Evaluation</span>
        </div>
        <h2 class="text-2xl sm:text-3xl font-serif font-extrabold text-[#064E3B]">
          <span data-en="The 6 Core Tarbiyah Pillars" data-ur="6 بنیادی تربیتی جہات">The 6 Core Tarbiyah Pillars</span>
        </h2>
        <p class="text-xs sm:text-sm text-gray-500 mt-1">
          <span data-en="Rate how frequently each scenario occurs in your home. Be completely honest with yourself; there are no right or wrong answers." data-ur="ہر سوال پر غور کریں کہ یہ صورتحال آپ کے گھر میں کتنی بار پیش آتی ہے۔ ایمانداری سے جواب دیں تاکہ درست تشخیصی نتیجہ سامنے آئے۔">
            Rate how frequently each scenario occurs in your home. Be completely honest with yourself; there are no right or wrong answers.
          </span>
        </p>
      </div>

      <!-- Dynamic Question Boxes injected via JS -->
      <div id="etpcQuestions" class="space-y-8">
        <!-- JS will render the 6 boxes and 18 questions here -->
      </div>
    </section>

    <!-- DIAGNOSTIC RESULT & ACTION DASHBOARD -->
    <section id="printable-assessment-report" class="bg-gradient-to-b from-white to-[#F8FFFC] rounded-3xl border-2 border-[#0F766E]/30 p-6 sm:p-10 shadow-xl space-y-8">
      
      <!-- Top Result Header -->
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-[#0F766E]/20">
        <div>
          <div class="inline-flex items-center gap-2 text-xs font-bold text-[#F59E0B] uppercase tracking-wider mb-1">
            <Sparkles class="w-4 h-4" />
            <span data-en="Diagnostic Evaluation Outcome" data-ur="تشخیصی نتیجہ و تجاویز">Diagnostic Evaluation Outcome</span>
          </div>
          <h2 class="text-2xl sm:text-3xl font-serif font-black text-[#064E3B]" id="etpcResultTitle">
            Parent Coaching Readiness Result
          </h2>
          <p class="text-xs text-gray-500 mt-1">
            <span data-en="Based on your 18 answers, here is your customized guidance recommendation." data-ur="آپ کے 18 جوابات کی بنیاد پر آپ کے خاندان کے لیے مخصوص لائحہ عمل۔">
              Based on your 18 answers, here is your customized guidance recommendation.
            </span>
          </p>
        </div>

        <!-- Action Toolbar -->
        <div class="no-print flex flex-wrap items-center gap-2" id="actions-toolbar">
          <button
            type="button"
            id="btn-print"
            class="px-4 py-2 rounded-xl bg-[#064E3B] text-white font-bold text-xs sm:text-sm hover:bg-[#043327] transition-all shadow inline-flex items-center gap-1.5 cursor-pointer"
          >
            <Printer class="w-4 h-4 text-amber-300" />
            <span data-en="Print / PDF" data-ur="پرنٹ / PDF">Print / PDF</span>
          </button>
          
          <button
            type="button"
            id="btn-whatsapp"
            class="px-4 py-2 rounded-xl bg-[#25D366] text-white font-bold text-xs sm:text-sm hover:bg-[#1EBE5D] transition-all shadow inline-flex items-center gap-1.5 cursor-pointer"
          >
            <MessageCircle class="w-4 h-4" />
            <span data-en="Consult on WhatsApp" data-ur="واٹس ایپ پر بھیجیں">Consult on WhatsApp</span>
          </button>

          <button
            type="button"
            id="btn-save"
            class="px-3.5 py-2 rounded-xl border border-[#0F766E]/20 text-[#0F766E] font-semibold text-xs hover:bg-[#F4F8F6] transition-colors inline-flex items-center gap-1 cursor-pointer"
            title="Save Form"
          >
            <Download class="w-3.5 h-3.5" />
            <span id="save-btn-text" data-en="Save" data-ur="محفوظ کریں">Save</span>
          </button>
        </div>
      </div>

      <!-- Result Content Box -->
      <div id="etpcResultBox" class="p-6 rounded-2xl bg-[#F8FFFC] border border-[#0F766E]/20 space-y-4">
        <div class="flex flex-col sm:flex-row items-center justify-between gap-4 pb-4 border-b border-[#0F766E]/15">
          <div class="space-y-1 text-center sm:text-left">
            <span class="text-xs font-bold text-gray-500 uppercase tracking-wider block" data-en="Readiness Category" data-ur="کوچنگ کی ضرورت کا درجہ">
              Readiness Category
            </span>
            <div id="etpcBadgeCategory" class="text-lg sm:text-xl font-serif font-extrabold text-[#064E3B]">
              Complete all questions to see result
            </div>
          </div>
          <div class="text-center sm:text-right shrink-0">
            <span class="text-xs font-bold text-[#0F766E] uppercase tracking-wider block" data-en="Readiness Index" data-ur="ریڈینس انڈیکس">
              Readiness Index
            </span>
            <div class="text-2xl font-serif font-black text-[#064E3B]" id="etpcResultScoreDisplay">
              0%
            </div>
          </div>
        </div>

        <p id="etpcResultText" class="text-sm sm:text-base text-gray-700 leading-relaxed font-medium">
          Please select your answers for all 18 questions above to view your personalized assessment and parenting guidance.
        </p>

        <!-- Dynamic Category Highlights -->
        <div id="pillar-breakdown" class="pt-4 grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3">
          <!-- Pillar stats injected via JS -->
        </div>
      </div>

      <!-- Printable Family Signatures -->
