# -------------------------------------------------------------
# EduTarbiyah Shared Hosting FTP Credentials
# Fill in your details below and rename this file to .env
# (The .env file is git-ignored and safe on your local computer)
# -------------------------------------------------------------

# Your cPanel/Hosting FTP server address (domain or server IP)
FTP_HOST=ftp.edutarbiyah.com

# Your cPanel FTP username
FTP_USER=your_ftp_username

# Your FTP password
FTP_PASSWORD=your_ftp_password

# FTP Port (default 21)
FTP_PORT=21

# Use FTPS (true for explicit FTPS, false for standard FTP)
FTP_SECURE=false

# Remote destination folder on hosting where dist files go
# If your cPanel FTP account was created specifically for this domain, leave as /
# Otherwise use public_html/ or public_html/your_subdomain/
FTP_REMOTE_DIR=/
